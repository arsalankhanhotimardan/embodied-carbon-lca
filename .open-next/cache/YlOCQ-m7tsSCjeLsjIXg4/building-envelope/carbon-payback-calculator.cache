l,{\"href\":\"/building-envelope/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Read methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Site methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/about\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"About Green Engineering Tools\"}]]}]\n7:[\"$\",\"section\",\"What carbon payback means\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"What carbon payback means\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"Carbon payback is the time required for estimated annual operational greenhouse-gas savings to equal the embodied greenhouse-gas emissions attributed to the retrofit. A short payback can indicate that the operational benefit quickly exceeds the upfront carbon burden, but the result depends strongly on climate, energy source and EPD scope.\"}]}]]}]\n8:[\"$\",\"section\",\"Keep EPD units and modules consistent\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Keep EPD units and modules consistent\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"If you use a product EPD factor, confirm the declared unit and life-cycle modules. The calculator's mass × factor input expects a compatible kgCO₂e per kg factor. If your EPD is declared per m², m³, piece or another unit, calculate the project embodied carbon in the EPD Carbon Calculator first and enter the total here.\"}]}]]}]\n9:[\"$\",\"section\",\"Decarbonising grids change long-term carbon savings\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Decarbonising grids change long-term carbon savings\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"A single operational carbon factor is a planning simplification. Electricity grids and heating fuels can change over a 20-year analysis. For high-stakes studies, use scenario-based or year-by-year carbon factors in a dedicated LCA/energy model.\"}]}]]}]\na:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 space-y-3\",\"children\":[[\"$\",\"details\",\"What data do I need for carbon payback?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"What data do I need for carbon payback?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"You need before/after U-values, area, climate degree days, system performance, an operational-energy carbon factor and insulation/project embodied carbon from a compatible EPD or LCA result.\"}]]}],[\"$\",\"details\",\"Does the tool contain generic insulation carbon factors?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Does the tool contain generic insulation carbon factors?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"No. Product, geography, declared unit and EPD scope can change the result substantially, so no generic factor is silently applied.\"}]]}],[\"$\",\"details\",\"Can I calculate financial payback too?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Can I calculate financial payback too?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Yes. Enter the local energy price and upgrade cost. The calculator reports simple annual cost savings and simple payback when enough inputs are available.\"}]]}],[\"$\",\"details\",\"Can I connect this to Green Engineering Tools LCA?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Can I connect this to Green Engineering Tools LCA?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Yes. The page links to the existing EPD and embodied-carbon calculators so you can calculate product/project carbon with the appropriate declared unit, then bring the total into the payback tool.\"}]]}]]}]]}]\nb:[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-slate-950 p-5 text-slate-200\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm font-black text-white\",\"children\":\"Related Green Engineering Tools\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 grid gap-2 sm:grid-cols-2\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/epd-carbon-calculator\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"EPD Carbon Calculator →\"}],[\"$\",\"$L2\",null,{\"href\":\"/embodied-carbon-calculator\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"Embodied Carbon Calculator →\"}],[\"$\",\"$L2\",null,{\"href\":\"/electrical\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"Electrical Engineering Tools →\"}],[\"$\",\"a\",null,{\"href\":\"https://solarcalculator.greenengineeringtools.com\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 tex