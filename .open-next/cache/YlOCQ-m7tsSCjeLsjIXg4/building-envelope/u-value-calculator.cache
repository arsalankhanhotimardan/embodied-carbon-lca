eedsRuntimeRequest\":\"$@19\"}\n1a:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"OutletBoundary\"]\n1b:\"$Sreact.suspense\"\n1d:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"ViewportBoundary\"]\n1e:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"MetadataBoundary\"]\n1f:I[27201,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"IconMark\"]\n20:I[39756,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"default\"]\n21:I[37457,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"default\"]\n5:[\"$\",\"h2\",null,{\"className\":\"text-lg font-black text-emerald-950\",\"children\":\"Engineering scope and trust\"}]\n6:[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-6 text-emerald-900\",\"children\":\"The calculator is designed for transparent planning and comparison. It does not claim universal building-code certification. Product declarations, local regulations, moisture/condensation design, thermal bridges, ground-contact heat transfer and specialist HVAC sizing may require additional methods or professional review.\"}]\n7:[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-3 text-sm font-black\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/building-envelope/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Read methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Site methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/about\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"About Green Engineering Tools\"}]]}]\n8:[\"$\",\"section\",\"What U-value means\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"What U-value means\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"U-value expresses steady-state heat transfer through one square metre of a building element per kelvin of temperature difference. A lower U-value indicates lower heat transfer, provided the assembly and boundary conditions are represented correctly.\"}]}]]}]\n9:[\"$\",\"section\",\"Calculation scope\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Calculation scope\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"The multilayer method is suitable for planning homogeneous walls, roofs and floors and includes configurable surface resistances. The optional framing feature is a simple parallel-path approximation. The page does not claim to calculate every correction, thermal bridge or regulatory detail required in every jurisdiction.\"}]}]]}]\na:[\"$\",\"section\",\"Use design values, not marketing numbers\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Use design values, not marketing numbers\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"Where standards require design thermal conductivity rather than a laboratory declared value, use the project-appropriate design value. Moisture, ageing, density and temperature can affect some products.\"}]}]]}]\nb:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 space-y-3\",\"children\":[[\"$\",\"details\",\"What is a good U-value?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"What is a good U-value?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"There is no single worldwide pass/fail value. Targets vary by climate, element type, building type, code edition and project. Enter the target relevant to your jurisdiction instead of relying on a universal number.\"}]]}],[\"$\",\"details\",\"Does a lower U-value mean better insulation?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Does a lower U-value mean better insulation?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Generally yes for steady-state thermal transmittance: lower U-value means less heat flow per unit area and temperature difference.\"}]]}],[\"$\",\"details\",\"Can I use Imperial thicknesses?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Can I use Imperial thicknesses?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Yes. Switch to Imperial and layer thicknesses are entered/displayed in inches while the engine continues to use canonical SI calculations internally.\"}]]}],[\"$\",\"details\",\"Why is the framing-adjusted U-value higher?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Why is the framing-adjusted U-value higher?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Framing usually conducts more heat than cavity insulation, creating a parallel heat-flow path. The area-weighted effective transmittance therefore increases.\"}]]}]]}]]}]\nc:[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-slate-950 p-5 text-slate-200\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm font-bla