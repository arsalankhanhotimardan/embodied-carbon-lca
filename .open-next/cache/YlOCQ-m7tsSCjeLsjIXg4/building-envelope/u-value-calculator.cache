down\" class=\"h-10 w-10 rounded-lg border border-slate-200 bg-white font-black text-slate-600 disabled:opacity-30\">↓</button><button type=\"button\" aria-label=\"Remove layer\" class=\"h-10 w-10 rounded-lg border border-rose-200 bg-white font-black text-rose-600 disabled:opacity-30\">×</button></div></div><div class=\"mt-3 grid gap-3 sm:grid-cols-2\"><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Thickness (mm)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"100\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Thermal conductivity λ (W/m·K)</span><input type=\"number\" min=\"0.001\" step=\"0.001\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"0.037\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Replace planning presets with the declared product/design value when available.</span></label></div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-4\"><div class=\"flex min-w-0 items-start justify-between gap-3\"><div class=\"min-w-0 flex-1\"><div class=\"text-xs font-black uppercase tracking-wider text-slate-400\">Layer <!-- -->3</div><input aria-label=\"Layer 3 name\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 mt-1 bg-white\" value=\"Clay brick masonry\"/></div><div class=\"flex shrink-0 gap-1\"><button type=\"button\" aria-label=\"Move layer up\" class=\"h-10 w-10 rounded-lg border border-slate-200 bg-white font-black text-slate-600 disabled:opacity-30\">↑</button><button type=\"button\" aria-label=\"Move layer down\" disabled=\"\" class=\"h-10 w-10 rounded-lg border border-slate-200 bg-white font-black text-slate-600 disabled:opacity-30\">↓</button><button type=\"button\" aria-label=\"Remove layer\" class=\"h-10 w-10 rounded-lg border border-rose-200 bg-white font-black text-rose-600 disabled:opacity-30\">×</button></div></div><div class=\"mt-3 grid gap-3 sm:grid-cols-2\"><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Thickness (mm)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"102\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Thermal conductivity λ (W/m·K)</span><input type=\"number\" min=\"0.001\" step=\"0.001\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"0.77\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Replace planning presets with the declared product/design value when available.</span></label></div></div></div><details class=\"rounded-2xl border border-slate-200 bg-white p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Advanced: surface resistance &amp; repeating framing</summary><div class=\"mt-5 space-y-5\"><label class=\"flex items-start gap-3 text-sm font-semibold text-slate-700\"><input type=\"checkbox\" class=\"mt-1 h-4 w-4\"/>Manually override inside/outside surface resistances</label><label class=\"flex items-start gap-3 text-sm font-semibold text-slate-700\"><input type=\"checkbox\" class=\"mt-1 h-4 w-4\"/>Estimate a repeating framing path through one layer</label></div></details><div class=\"flex flex-wrap gap-2\"><button type=\"button\" class=\"min-h-11 rounded-xl bg-slate-950 px-4 text-sm font-black text-white disabled:opacity-40\">Use U-value in heat-loss tool</button><button type=\"button\" class=\"min-h-11 rounded-xl border border-slate-300 bg-white px-4 text-sm font-black text-slate-800 disabled:opacity-40\">Use as retrofit “after”</button></div></div><div class=\"mt-7 flex flex-wrap gap-2 border-t border-slate-200 pt-5\"><button type=\"button\" class=\"min-h-11 rounded-xl bg-emerald-600 px-5 text-sm font-black text-white hover:bg-emerald-500 xl:hidden\">View calculation results ↓</button><button type=\"button\" class=\"min-h-11 rounded-xl border border-slate-300 bg-white px-4 text-sm font-black text-slate-600 hover:bg-slate-50\">Reset saved inputs</button></div></div><aside class=\"min-w-0 scroll-mt-24 bg-slate-50 p-4 sm:p-6 lg:p-8\" aria-live=\"polite\"><div class=\"sticky top-24 space-y-4\"><div><div class=\"text-xs font-black uppercase tracking-[0.18em] text-emerald-700\">Live result</div><h3 class=\"mt-1 text-xl font-black text-slate-950\">Assembly / U-value</h3></div><div class=\"grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2\"><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">U-value</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">0.327 W/m²·K</div><p class=\"mt-1.5 text-xs leading-5 text-slate-500\">Lower U-value means less steady-state heat transfer.</p></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Total RSI</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">3.055 m²·K/W</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">R-value (US)</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">R-17.3</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Surface resistance</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">0.17 RSI</div></div></div><div class=\"overflow-hidden rounded-2xl border border-slate-200 bg-white\"><div class=\"border-b border-slate-200 px-4 py-3 text-sm font-black text-slate-900\">Layer resistance breakdown</div><div class=\"divide-y divide-slate-100\"><div class=\"flex min-w-0 items-center justify-between gap-3 px-4 py-3 text-sm\"><span class=\"min-w-0 break-words font-semibold text-slate-700\">Gypsum plasterboard</span><span class=\"shrink-0 font-black text-slate-950\">0.05<!-- --> RSI</span></div><div class=\"flex min-w-0 items-center justify-between gap-3 px-4 py-3 text-sm\"><span class=\"min-w-0 break-words font-semibold text-slate-700\">Mineral / stone wool</span><span class=\"shrink-0 font-black text-slate-950\">2.703<!-- --> RSI</span></div><div class=\"flex min-w-0 items-center justify-between gap-3 px-4 py-3 text-sm\"><span class=\"min-w-0 break-words font-semibold text-slate-700\">Clay brick masonry</span><span class=\"shrink-0 font-black text-slate-950\">0.132<!-- --> RSI</span></div></div></div><div class=\"rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950\"><p class=\"font-black\">Planning notes</p><ul class=\"mt-2 list-disc space-y-1.5 pl-5 leading-6\"><li>ISO 6946 excludes some components such as windows/doors, ground-contact constructions and air-permeable components; use the appropriate specialist method where applicable.</li></ul></div><div class=\"rounded-2xl border border-slate-200 bg-white p-4 text-xs leading-5 text-slate-500\"><div class=\"font-black text-slate-800\">Calculation provenance</div><div class=\"mt-2 grid grid-cols-1 gap-1\"><span>Engine: v<!-- -->1.0.0</span><span>Material dataset: <!-- -->2026.09.1</span><span>Guidance dataset: <!-- -->2026.09.1</span><span>Data activation: validated, version-controlled</span></div></div></div></aside></div></div></section></div><article class=\"mx-auto mt-12 max-w-4xl space-y-10 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10\"><div class=\"rounded-2xl border border-emerald-200 bg-emerald-50 p-5\"><h2 class=\"text-lg font-black text-emerald-950\">Engineering scope and trust</h2><p class=\"mt-2 text-sm leading-6 text-emerald-900\">The calculator is designed for transparent planning and comparison. It does not claim universal building-code certification. Product declarations, local regulations, moisture/condensation design, thermal bridges, ground-contact heat transfer and specialist HVAC sizing may require additional methods or professional review.</p><div class=\"mt-3 flex flex-wrap gap-3 text-sm font-black\"><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/building-envelope/methodology\">Read methodology</a><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/methodology\">Site methodology</a><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/about\">About Green Engineering Tools</a></div></div><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">What U-value means</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>U-value expresses steady-state heat transfer through one square metre of a building element per kelvin of temperature difference. A lower U-value indicates lower heat transfer, provided the assembly and boundary conditions are represented correctly.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Calculation scope</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>The multilayer method is suitable for planning homogeneous walls, roofs and floors and includes configurable surface resistances. The optional framing feature is a simple parallel-path approximation. The page does not claim to calculate every correction, thermal bridge or regulatory detail required in every jurisdiction.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Use design values, not marketing numbers</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>Where standards require design thermal conductivity rather than a laboratory declared value, use the project-appropriate design value. Moisture, ageing, density and temperature can affect some products.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Frequently asked questions</h2><div class=\"mt-5 space-y-3\"><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">What is a good U-value?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">There is no single worldwide pass/fail value. Targets vary by climate, element type, building type, code edition and project. Enter the target relevant to your jurisdiction instead of relying on a universal number.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Does a lower U-value mean better insulation?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Generally yes for steady-state thermal transmittance: lower U-value means less heat flow per unit area and temperature difference.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Can I use Imperial thicknesses?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Yes. Switch to Imperial and layer thicknesses are entered/displayed in inches while the engine continues to use canonical SI calculations internally.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Why is the framing-adjusted U-value higher?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Framing usually conducts more heat than cavity insulation, creating a parallel heat-flow path. The area-weighted effective transmittance therefore increases.</p></details></div></section><div class=\"rounded-2xl bg-slate-950 p-5 text-slate-200\"><div class=\"text-sm font-black text-white\">Related Green Engineering Tools</div><div class=\"mt-3 grid gap-2 sm:grid-cols-2\"><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator →</a><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator →</a><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/electrical\">Electrical Engineering Tools →</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\">Solar System Calculator ↗</a></div></div></article></div></div><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-6 lg:gap-7\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center font-black tracking-tight text-white sm:justify-start\" href=\"/\">GreenEngineering Tools</a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Free browser-based engineering tools for carbon, building physics, electrical systems and sustainable design.</p></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Core tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer core tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/building-envelope\">Building Envelope</a><a class=\"block hover:text-white\" href=\"/electrical\">Electrical Tools</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"block hover:text-white\">Solar Calculator ↗</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Building</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer building-envelope navigation\"><a class=\"block hover:text-white\" href=\"/building-envelope/insulation-calculator\">Insulation Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/u-value-calculator\">U-Value Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/heat-loss-calculator\">Heat Loss Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/carbon-payback-calculator\">Carbon Payback</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Electrical</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer electrical navigation\"><a class=\"block hover:text-white\" href=\"/electrical/voltage-drop-calculator\">Voltage Drop</a><a class=\"block hover:text-white\" href=\"/electrical/wire-size-calculator\">Wire Size</a><a class=\"block hover:text-white\" href=\"/electrical/dc-wire-size-calculator\">DC Wire Size</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">LCA learning</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer LCA learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Company</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer company navigation\"><a class=\"block hover:text-white\" href=\"/about\">About Us</a><a class=\"block hover:text-white\" href=\"/contact\">Contact</a><a class=\"block hover:text-white\" href=\"/privacy-policy\">Privacy Policy</a><a class=\"block hover:text-white\" href=\"/terms-of-service\">Terms of Service</a></nav></div></div><div class=\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\"><p class=\"text-center text-xs text-slate-500 md:text-left\">© <!-- -->2026<!-- --> Green Engineering Tools. All rights reserved.</p><p class=\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\">Engineering decision-support tools. Formal compliance, certification and site-specific design remain subject to applicable standards, manufacturer data and qualified professional review.</p></div></div></footer><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[22016,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\",\\\"/_next/static/chunks/2qm4q1zl28dg6.js\\\"],\\\"\\\"]\\n3:I[89759,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\"],\\\"default\\\"]\\n4:I[39756,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\"],\\\"default\\\"]\\n5:I[37457,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\"],\\\"default\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/0-cefy6v3zt19.cs