iv\\\",null,{\\\"className\\\":\\\"mt-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/#calculator-workspace\\\",\\\"className\\\":\\\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\\\",\\\"children\\\":\\\"Open the LCA calculator\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/methodology\\\",\\\"className\\\":\\\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\\\",\\\"children\\\":\\\"Read methodology\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-6 text-xs text-slate-500\\\",\\\"children\\\":[\\\"Last reviewed: \\\",\\\"2026-08-31\\\"]}]]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"min-w-0\\\",\\\"children\\\":[\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-14\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",\\\"definition\\\",{\\\"id\\\":\\\"definition\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"What Module D means in building LCA\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Module D reports potential benefits or loads beyond the assessed product or building system boundary. It can reflect scenarios such as reuse, recycling or energy recovery that may displace future production outside the A-C lifecycle of the assessed building.\\\"}],\\\"$L14\\\"],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}],\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\"]}],\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]}],\\\"$L1c\\\"]}]]}],null,\\\"$L1d\\\"]}]\\nc:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1e\\\",null,{\\\"children\\\":\\\"$L1f\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L20\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$21\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L22\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\ne:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/05r9umnlogrxm.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n23:I[97367,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"OutletBoundary\\\"]\\nb:C\\nf:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"About Us\\\"}]\\n10:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/contact\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Contact\\\"}]\\n11:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/privacy-policy\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Privacy Policy\\\"}]\\n12:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/terms-of-service\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Terms of Service\\\"}]\\n13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-center text-xs text-slate-500 md:text-left\\\",\\\"children\\\":[\\\"© \\\",2026,\\\" Green Engineering Tools. All rights reserved.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\\\",\\\"children\\\":\\\"Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.\\\"}]]}]\\n14:[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Because Module D occurs beyond the system boundary, it is not simply a negative end-of-life number. A product can have C-stage impacts for demolition, transport and processing while also reporting a separate Module D benefit or load.\\\"}]\\n15:[\\\"$\\\",\\\"section\\\",\\\"not-credit\\\",{\\\"id\\\":\\\"not-credit\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Why a recycling percentage is not a Module D formula\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A generic formula such as manufacturing GWP × recycling rate × 85% assumes that recovered material perfectly substitutes for virgin material according to an arbitrary efficiency. Real Module D results depend on the product system, recovery process, material quality, substitution assumptions and the methodology used by the declaration.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The safer software rule is simple: use declared Module D data or a documented scenario methodology. If neither exists, display Module D as unavailable rather than manufacturing a credit.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-amber-950\\\",\\\"children\\\":\\\"100% recyclable does not mean zero C-stage emissions\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-amber-900\\\",\\\"children\\\":\\\"Recycling still involves deconstruction, sorting, transport and processing. Keep C1-C4 and Module D as separate lifecycle contributions.\\\"}]]}]]}]\\n16:[\\\"$\\\",\\\"section\\\",\\\"example\\\",{\\\"id\\\":\\\"example\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Conceptual example: steel recovery at end of life\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Imagine a structural steel product with declared C-stage impacts and a separate Module D result. The building total through end of life includes the applicable A, B and C modules. Module D is then reported on another line as the declared beyond-boundary potential.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"This presentation lets reviewers see both the burden of end-of-life processing and the potential benefit of recovered material without cancelling one against the other invisibly.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n17:[\\\"$\\\",\\\"section\\\",\\\"epd\\\",{\\\"id\\\":\\\"epd\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"How to read Module D in an EPD\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Confirm that Module D is actually declared for the product.\\\",{\\\"children\\\":\\\"Confirm that Module D is actually declared for the product.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Check the indicator unit and declared quantity.\\\",{\\\"children\\\":\\\"Check the indicator unit and declared quantity.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Review the scenario or assumptions described by the EPD.\\\",{\\\"children\\\":\\\"Review the scenario or assumptions described by the EPD.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Do not compare Module D across products as if every declaration uses identical recovery conditions.\\\",{\\\"children\\\":\\\"Do not compare Module D across products as if every declaration uses identical recovery conditions.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Keep the EPD's Module D value traceable to the source record.\\\",{\\\"children\\\":\\\"Keep the EPD's Module D value traceable to the source record.\\\"}]]}],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n18:[\\\"$\\\",\\\"section\\\",\\\"reporting\\\",{\\\"id\\\":\\\"reporting\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"How this calculator reports Module D\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The engine stores Module D separately from A1-C4. It does not automatically subtract Module D from lifecycle GWP. CSV and PDF exports should consume the same calculation core so the beyond-boundary result is reported consistently.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"If a selected dataset lacks Module D, the interface should show the absence of data. This is more defensible than assigning a default reuse or recycling saving.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n19:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-slate-200 pt-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black text-slate-950\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"Is Module D always a carbon saving?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Is Module D always a carbon saving?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"No. Module D can be a benefit or a load depending on the scenario and dataset.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Can I calculate Module D from recycling percentage alone?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Can I calculate Module D from recycling percentage alone?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"Not reliably. Recovery percentage is only one part of a substitution or recovery scenario. Use declared data or a documented methodology.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Does Module D replace C1-C4?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Does Module D replace C1-C4?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"No. C1-C4 represent end-of-life activities within the system boundary; Module D reports potential effects beyond that boundary.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Should Module D be subtracted from A-C in the dashboard?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Should Module D be subtracted from A-C in the dashboard?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"The calculator reports it separately to avoid obscuring the system boundary. A reporting framework can then specify how it should be presented.\\\"}]]}]]}]]}]\\n1a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-black text-slate-950\\\",\\\"children\\\":\\\"Authoritative references\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-sm leading-6 text-slate-600\\\",\\\"children\\\":\\\"These links are pr