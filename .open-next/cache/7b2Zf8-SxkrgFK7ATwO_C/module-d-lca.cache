{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/module-d-lca/layout,_N_T_/module-d-lca/page,_N_T_/module-d-lca"},"segmentPaths":["/_tree","/_full","/_index","/module-d-lca/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/05r9umnlogrxm.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/1icgbrcdew2yz.js\" async=\"\" crossorigin=\"\"></script><title>Module D LCA Explained: Recycling &amp; Reuse | Green Engineering Tools</title><meta name=\"description\" content=\"Understand Module D in EN 15804-style building LCA: recycling and reuse beyond the system boundary, C1-C4 separation, EPD data and reporting.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/module-d-lca\"/><meta property=\"og:title\" content=\"Module D LCA Explained: Recycling &amp; Reuse\"/><meta property=\"og:description\" content=\"Understand Module D in EN 15804-style building LCA: recycling and reuse beyond the system boundary, C1-C4 separation, EPD data and reporting.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com/module-d-lca\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Calculate embodied carbon from construction quantities, EPD data and lifecycle modules.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className flex min-h-screen w-full min-w-0 flex-col overflow-x-hidden bg-slate-50 text-slate-900\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm\"><nav aria-label=\"Main navigation\"><div class=\"mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8\"><div class=\"flex h-16 min-w-0 items-center justify-between gap-2 sm:h-20 sm:gap-4\"><a aria-label=\"Green Engineering Tools home\" class=\"flex min-w-0 max-w-[calc(100%-3.25rem)] items-center sm:max-w-none\" href=\"/\"><div class=\"mr-2 shrink-0 rounded-lg bg-emerald-500 p-1.5 shadow-inner shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering<span class=\"text-emerald-600\">LCA</span></span></a><div class=\"hidden items-center gap-5 lg:flex xl:gap-6\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">The Engine</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/contact\">Contact</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">Launch Workspace</a></div><div class=\"lg:hidden shrink-0\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><main class=\"min-h-screen bg-slate-50\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":\"Module D LCA Explained: Recycling & Reuse\",\"description\":\"Understand Module D in EN 15804-style building LCA: recycling and reuse beyond the system boundary, C1-C4 separation, EPD data and reporting.\",\"dateModified\":\"2026-08-31\",\"mainEntityOfPage\":\"https://greenengineeringtools.com/module-d-lca\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Green Engineering Tools\",\"url\":\"https://greenengineeringtools.com\"},\"about\":[\"Life cycle assessment\",\"Embodied carbon\",\"Environmental Product Declarations\",\"Building materials\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenengineeringtools.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://greenengineeringtools.com/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Module D LCA Explained: Recycling & Reuse\",\"item\":\"https://greenengineeringtools.com/module-d-lca\"}]}</script><section class=\"bg-slate-950 text-white\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\"><nav class=\"text-sm text-slate-400 mb-7\" aria-label=\"Breadcrumb\"><a class=\"hover:text-white\" href=\"/\">Home</a><span class=\"mx-2\">/</span><a class=\"hover:text-white\" href=\"/guides\">Guides</a></nav><p class=\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\">Module D and circularity</p><h1 class=\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\">Module D LCA Explained: Recycling &amp; Reuse</h1><p class=\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\">Understand Module D in EN 15804-style building LCA: recycling and reuse beyond the system boundary, C1-C4 separation, EPD data and reporting.</p><div class=\"mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\" href=\"/#calculator-workspace\">Open the LCA calculator</a><a class=\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\" href=\"/methodology\">Read methodology</a></div><p class=\"mt-6 text-xs text-slate-500\">Last reviewed: <!-- -->2026-08-31</p></div></section><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\"><article class=\"min-w-0\"><div class=\"space-y-14\"><section id=\"definition\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">What Module D means in building LCA</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Module D reports potential benefits or loads beyond the assessed product or building system boundary. It can reflect scenarios such as reuse, recycling or energy recovery that may displace future production outside the A-C lifecycle of the assessed building.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Because Module D occurs beyond the system boundary, it is not simply a negative end-of-life number. A product can have C-stage impacts for demolition, transport and processing while also reporting a separate Module D benefit or load.</p></section><section id=\"not-credit\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Why a recycling percentage is not a Module D formula</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A generic formula such as manufacturing GWP × recycling rate × 85% assumes that recovered material perfectly substitutes for virgin material according to an arbitrary efficiency. Real Module D results depend on the product system, recovery process, material quality, substitution assumptions and the methodology used by the declaration.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The safer software rule is simple: use declared Module D data or a documented scenario methodology. If neither exists, display Module D as unavailable rather than manufacturing a credit.</p><div class=\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\"><h3 class=\"font-black text-amber-950\">100% recyclable does not mean zero C-stage emissions</h3><p class=\"mt-2 leading-7 text-amber-900\">Recycling still involves deconstruction, sorting, transport and processing. Keep C1-C4 and Module D as separate lifecycle contributions.</p></div></section><section id=\"example\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Conceptual example: steel recovery at end of life</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Imagine a structural steel product with declared C-stage impacts and a separate Module D result. The building total through end of life includes the applicable A, B and C modules. Module D is then reported on another line as the declared beyond-boundary potential.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">This presentation lets reviewers see both the burden of end-of-life processing and the potential benefit of recovered material without cancelling one against the other invisibly.</p></section><section id=\"epd\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How to read Module D in an EPD</h2><ul class=\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\"><li>Confirm that Module D is actually declared for the product.</li><li>Check the indicator unit and declared quantity.</li><li>Review the scenario or assumptions described by the EPD.</li><li>Do not compare Module D across products as if every declaration uses identical recovery conditions.</li><li>Keep the EPD&#x27;s Module D value traceable to the source record.</li></ul></section><section id=\"reporting\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How this calculator reports Module D</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The engine stores Module D separately from A1-C4. It does not automatically subtract Module D from lifecycle GWP. CSV and PDF exports should consume the same calculation core so the beyond-boundary result is reported consistently.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">If a selected dataset lacks Module D, the interface should show the absence of data. This is more defensible than assigning a default reuse or recycling saving.</p></section></div><section class=\"mt-16 border-t border-slate-200 pt-10\"><h2 class=\"text-2xl sm:text-3xl font-black text-slate-950\">Frequently asked questions</h2><div class=\"mt-6 space-y-3\"><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Is Module D always a carbon saving?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">No. Module D can be a benefit or a load depending on the scenario and dataset.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Can I calculate Module D from recycling percentage alone?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Not reliably. Recovery percentage is only one part of a substitution or recovery scenario. Use declared data or a documented methodology.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Does Module D replace C1-C4?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">No. C1-C4 represent end-of-life activities within the system boundary; Module D reports potential effects beyond that boundary.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Should Module D be subtracted from A-C in the dashboard?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">The calculator reports it separately to avoid obscuring the system boundary. A reporting framework can then specify how it should be presented.</div></details></div></section><section class=\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\"><h2 class=\"text-xl font-black text-slate-950\">Authoritative references</h2><p class=\"mt-2 text-sm leading-6 text-slate-600\">These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.</p><ul class=\"mt-4 space-y-2 text-sm\"><li><a href=\"https://docs.buildingtransparency.org/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">Building Transparency documentation — EC3 and tallyLCA scope</a></li></ul></section><section class=\"mt-14\"><h2 class=\"text-2xl font-black text-slate-950\">Continue learning</h2><div class=\"mt-5 grid sm:grid-cols-2 gap-4\"><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/whole-building-lca\"><h3 class=\"font-black text-slate-950\">Whole-building LCA guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand scope, service life, baseline comparison and whole-life reporting.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/epd-carbon-calculator\"><h3 class=\"font-black text-slate-950\">EPD carbon calculator</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how to read EPD units, GWP values, declared modules and data limitations.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/methodology\"><h3 class=\"font-black text-slate-950\">LCA calculation methodology</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">See how quantities, units, lifecycle modules, replacements and missing data are handled.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/leed-whole-building-lca\"><h3 class=\"font-black text-slate-950\">LEED whole-building LCA</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Review LEED v4, v4.1 and v5 WBLCA concepts and comparison requirements.</p></a></div></section></article><aside class=\"hidden lg:block\"><div class=\"sticky top-24 rounded-xl border border-slate-200 bg-white p-5\"><h2 class=\"text-xs font-black uppercase tracking-widest text-slate-500\">On this page</h2><nav class=\"mt-4 space-y-3 text-sm\"><a href=\"#definition\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">What Module D means in building LCA</a><a href=\"#not-credit\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Why a recycling percentage is not a Module D formula</a><a href=\"#example\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Conceptual example: steel recovery at end of life</a><a href=\"#epd\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How to read Module D in an EPD</a><a href=\"#reporting\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How this calculator reports Module D</a><a href=\"#top\" class=\"block pt-3 border-t border-slate-100 font-bold text-slate-400 hover:text-slate-700\">Back to top</a></nav></div></aside></div></main><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-5 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center sm:justify-start\" href=\"/\"><svg class=\"mr-2 h-7 w-7 shrink-0 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg><span class=\"font-black tracking-tight text-white\">GreenEngineering Tools</span></a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Browser-based tools and practical guides for embodied carbon, EPD data, BIM material workflows and whole-building life-cycle assessment.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/#calculator-workspace\">Open LCA calculator →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/actual-data\">Actual / Complex Goods</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/