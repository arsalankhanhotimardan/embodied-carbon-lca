{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/_index","/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":128,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/05r9umnlogrxm.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/1icgbrcdew2yz.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/2ofq03mdx21z_.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/03t_owysb8rxi.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1doj4l_h-k9mm.js\" async=\"\" crossorigin=\"\"></script><title>Free Embodied Carbon Calculator | Green Engineering Tools</title><meta name=\"description\" content=\"Free embodied carbon and whole-building LCA tools for construction. Upload CSV/BIM quantities, work with EPD data, compare lifecycle scenarios, and explore EC3 material workflows.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta property=\"og:description\" content=\"Embodied carbon, EPD, BIM and whole-building LCA tools for construction professionals, engineers, architects and students.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com\"/><meta property=\"og:site_name\" content=\"Green Engineering Tools\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Calculate embodied carbon from construction quantities, EPD data and lifecycle modules.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className flex min-h-screen w-full min-w-0 flex-col overflow-x-hidden bg-slate-50 text-slate-900\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm\"><nav aria-label=\"Main navigation\"><div class=\"mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8\"><div class=\"flex h-16 min-w-0 items-center justify-between gap-2 sm:h-20 sm:gap-4\"><a aria-label=\"Green Engineering Tools home\" class=\"flex min-w-0 max-w-[calc(100%-3.25rem)] items-center sm:max-w-none\" href=\"/\"><div class=\"mr-2 shrink-0 rounded-lg bg-emerald-500 p-1.5 shadow-inner shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering<span class=\"text-emerald-600\">LCA</span></span></a><div class=\"hidden items-center gap-5 lg:flex xl:gap-6\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">The Engine</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/contact\">Contact</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">Launch Workspace</a></div><div class=\"lg:hidden shrink-0\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><main class=\"min-h-screen bg-slate-100\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Green Engineering Tools LCA\",\"applicationCategory\":\"EngineeringApplication\",\"operatingSystem\":\"Web Browser\",\"description\":\"Free browser-based embodied carbon and whole-building LCA calculator for construction materials, EPD data, CSV/BIM schedules, EC3 reconciliation and lifecycle modules.\",\"featureList\":[\"Embodied carbon calculator for construction materials\",\"CSV and BIM material schedule import\",\"EC3 EPD reconciliation\",\"A1-A3 through C1-C4 lifecycle reporting\",\"Module D reporting\",\"Baseline and proposed building comparison\",\"kg CO2e per square metre intensity\",\"Carbon and procurement cost analysis\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"}}</script><section class=\"bg-slate-950 text-white\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center\"><div class=\"inline-flex px-4 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 text-xs font-black tracking-widest uppercase\">Free embodied carbon &amp; whole-building LCA calculator</div><h1 class=\"text-4xl sm:text-6xl font-black mt-6 tracking-tight\">Embodied Carbon Calculator for <span class=\"text-emerald-400\">Construction Materials</span></h1><p class=\"max-w-4xl mx-auto mt-5 text-slate-300 text-base sm:text-xl leading-relaxed\">Upload CSV or BIM material quantities, reconcile unknown products with EC3 EPD data, calculate lifecycle carbon by module, compare baseline and proposed designs, and report building carbon intensity in kg CO₂e/m².</p><div class=\"mt-8 flex flex-wrap justify-center gap-2 text-xs font-bold text-slate-300\"><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">A1-A3</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">A4-A5</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">B4 replacements</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">C1-C4</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">Module D</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">EPD data</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">EC3 matching</span><span class=\"px-3 py-1.5 rounded-full bg-white/5 border border-white/10\">CSV/BIM</span></div></div></section><section class=\"max-w-[1500px] mx-auto px-2 sm:px-6 py-8 sm:py-12\"><div class=\"bg-white border border-slate-200 shadow-xl rounded-xl min-h-[500px] flex items-center justify-center\"><div class=\"text-center\"><div class=\"w-10 h-10 border-4 border-slate-200 border-t-blue-600 rounded-full animate-spin mx-auto\"></div><p class=\"mt-4 font-bold text-slate-600\">Loading LCA datasets...</p></div></div></section><section class=\"bg-white border-t border-slate-200\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20\"><div class=\"max-w-4xl\"><p class=\"text-xs font-black uppercase tracking-[0.18em] text-emerald-700\">Construction carbon calculation guide</p><h2 class=\"mt-3 text-3xl sm:text-4xl font-black text-slate-950 tracking-tight\">Free whole-building LCA calculator with EPD and EC3 material workflows</h2><p class=\"mt-5 text-lg leading-8 text-slate-600\">Green Engineering Tools is designed for architects, engineers, estimators, sustainability consultants and students who need to turn a bill of materials into an understandable lifecycle carbon result. Instead of forcing every uploaded material into a generic carbon factor, the workflow keeps the original material name, looks for an approved mapping and flags unknown products for review.</p><p class=\"mt-4 text-base leading-7 text-slate-600\">The calculator is useful for early design studies, embodied-carbon screening, EPD-based comparisons and baseline-versus-proposed analysis. It separates lifecycle information by module so users can see where emissions occur rather than relying only on one building total. Missing EPD values remain unavailable instead of being silently converted into zero or an invented environmental impact.</p></div><div class=\"mt-12 grid md:grid-cols-3 gap-6\"><article class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><h3 class=\"text-xl font-black text-slate-900\">A1-A3 embodied carbon calculator</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Product-stage carbon normally begins with the quantity of a material and an environmental factor reported against an EPD declared unit. The engine converts compatible project units to the EPD basis and reports A1-A3 separately, allowing concrete, steel, timber, insulation, finishes and other products to be evaluated using their available datasets.</p></article><article class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><h3 class=\"text-xl font-black text-slate-900\">CSV and BIM embodied carbon workflow</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Material schedules can be imported from CSV and mapped to material, quantity and unit columns. This makes the calculator useful for BIM quantity takeoffs and large bills of materials where manual re-entry would be slow and error-prone.</p></article><article class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><h3 class=\"text-xl font-black text-slate-900\">EC3 EPD material matching</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">When a material cannot be resolved locally, an engineer can search connected EC3 data, adjust the search wording and select the appropriate product. The original BIM alias is retained for traceability and can be reused as an approved mapping when your data permissions and backend configuration allow persistent storage.</p></article></div><div class=\"mt-14 grid lg:grid-cols-[1.1fr_.9fr] gap-10 items-start\"><article><h2 class=\"text-2xl sm:text-3xl font-black text-slate-950\">How lifecycle modules are handled</h2><p class=\"mt-4 text-slate-600 leading-7\">A useful building LCA should make its system boundary visible. This application keeps product, construction, replacement and end-of-life information in separate modules and reports Module D outside the A-C total. That makes it easier to audit a result and compare scenarios using the same scope.</p><div class=\"mt-6 overflow-x-auto rounded-xl border border-slate-200\"><table class=\"w-full min-w-[620px] text-sm\"><thead class=\"bg-slate-950 text-white\"><tr><th class=\"p-3 text-left\">Lifecycle module</th><th class=\"p-3 text-left\">What it represents</th><th class=\"p-3 text-left\">How this tool uses it</th></tr></thead><tbody class=\"divide-y divide-slate-200\"><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">A1-A3</td><td class=\"p-3 text-slate-600\">Raw materials, transport to manufacturing and product manufacturing</td><td class=\"p-3 text-slate-600\">Uses declared EPD/product-stage data when available</td></tr><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">A4</td><td class=\"p-3 text-slate-600\">Transport from manufacturer or supplier to the project site</td><td class=\"p-3 text-slate-600\">Can use project transport distance and material mass</td></tr><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">A5</td><td class=\"p-3 text-slate-600\">Construction and installation stage</td><td class=\"p-3 text-slate-600\">Kept distinct from A1-A3 and A4</td></tr><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">B4</td><td class=\"p-3 text-slate-600\">Replacement during the building study period</td><td class=\"p-3 text-slate-600\">Uses service-life logic instead of multiplying the original A-stage result</td></tr><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">C1-C4</td><td class=\"p-3 text-slate-600\">Deconstruction, waste transport, processing and disposal</td><td class=\"p-3 text-slate-600\">Reported as end-of-life modules when supplied by the dataset</td></tr><tr class=\"bg-white\"><td class=\"p-3 font-black text-slate-900\">D</td><td class=\"p-3 text-slate-600\">Benefits and loads beyond the building system boundary</td><td class=\"p-3 text-slate-600\">Reported separately and never invented when missing</td></tr></tbody></table></div></article><aside class=\"rounded-2xl bg-slate-950 text-white p-6 sm:p-8\"><h2 class=\"text-2xl font-black\">What the result can tell you</h2><div class=\"mt-6 space-y-5\"><div><h3 class=\"font-black text-emerald-300\">Total A-C GWP</h3><p class=\"mt-1 text-sm leading-6 text-slate-300\">See lifecycle global-warming potential without folding Module D into the result.</p></div><div><h3 class=\"font-black text-emerald-300\">kg CO₂e/m²</h3><p class=\"mt-1 text-sm leading-6 text-slate-300\">Normalize carbon by gross floor area for easier project comparison.</p></div><div><h3 class=\"font-black text-emerald-300\">Baseline vs proposed</h3><p class=\"mt-1 text-sm leading-6 text-slate-300\">Identify whether a design option reduces or increases selected environmental indicators.</p></div><div><h3 class=\"font-black text-emerald-300\">Carbon per dollar</h3><p class=\"mt-1 text-sm leading-6 text-slate-300\">Combine unit cost and lifecycle carbon to support procurement discussions.</p></div><div><h3 class=\"font-black text-emerald-300\">Data-quality warnings</h3><p class=\"mt-1 text-sm leading-6 text-slate-300\">Find unmapped materials, missing modules and unsupported unit conversions before relying on a result.</p></div></div></aside></div></div></section><section class=\"bg-slate-50 border-t border-slate-200\"><div class=\"max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20\"><div class=\"text-center max-w-3xl mx-auto\"><p class=\"text-xs font-black uppercase tracking-[0.18em] text-blue-700\">Frequently asked questions</p><h2 class=\"mt-3 text-3xl sm:text-4xl font-black text-slate-950\">Embodied carbon, EPD and whole-building LCA FAQs</h2><p class=\"mt-4 text-slate-600 leading-7\">Practical answers for people searching for construction carbon calculations, lifecycle modules, EC3 product data and BIM material workflows.</p></div><div class=\"mt-10 space-y-4\"><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>What is a free embodied carbon calculator for construction materials?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">An embodied carbon calculator estimates greenhouse-gas emissions associated with building materials and lifecycle stages. This tool lets you import material quantities, link them to EPD datasets, review lifecycle modules and compare baseline and proposed designs in kg CO₂e.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>How do I calculate A1-A3 embodied carbon from an EPD?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">Use the EPD&#x27;s declared quantity and declared unit, convert your project quantity to that same basis, and multiply by the reported A1-A3 GWP value. The calculator keeps the declared unit attached to each dataset so unsupported conversions can be flagged instead of silently guessed.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>Can I upload a CSV or BIM material schedule for embodied carbon calculations?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">Yes. The workflow accepts CSV material schedules, lets you map material, quantity and unit columns, resolves known materials and sends unknown material names to the EC3 reconciliation step.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>What happens when a BIM material name does not match an EC3 product name?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">The original BIM or CSV alias is preserved, while the EC3 search term can be edited. This lets an engineer simplify a misspelled, abbreviated or overly specific material name and still save the final approved mapping for future imports when permitted by the connected data source.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>What are A1-A3, A4, A5, B4, C1-C4 and Module D in building LCA?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">A1-A3 cover product-stage impacts, A4 covers transport to site, A5 covers construction-stage impacts, B4 represents replacement during the study period, C1-C4 cover end-of-life processes, and Module D reports potential benefits or loads beyond the system boundary separately.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>How is embodied carbon intensity in kg CO2e per m2 calculated?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">When gross floor area is provided, the tool divides the selected project GWP total by floor area to report an intensity in kg CO₂e/m². Always compare projects using the same system boundary and study assumptions.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>What is the difference between EC3 and a whole-building LCA calculator?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">EC3 is especially useful for finding and comparing construction products using Environmental Product Declarations. A whole-building LCA combines material quantities, lifecycle modules and project assumptions across an entire building. This application uses EC3 reconciliation as one data workflow inside a broader building-LCA calculation process.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>Can this calculator compare a baseline and proposed building for LEED?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">The software includes a baseline-versus-proposed impact comparison and an indicative LEED v4 logic check. It should not be treated as certification or a substitute for project-specific LEED documentation until the project datasets, functional equivalence and methodology have been independently validated.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>Does the calculator include Module D recycling or reuse benefits?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">Module D is supported as a separate lifecycle result when the selected dataset declares it. The calculator does not invent a generic recycling credit when Module D data is missing.</div></details><details class=\"group bg-white border border-slate-200 rounded-xl shadow-sm\"><summary class=\"cursor-pointer list-none p-5 sm:p-6 font-black text-slate-900 flex items-start justify-between gap-4\"><span>Can I use this as an EPD carbon calculator for concrete, steel, timber, insulation and finishes?</span><span class=\"text-blue-600 text-xl leading-none group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 sm:px-6 pb-5 sm:pb-6 text-slate-600 leading-7\">Yes when an appropriate dataset and compatible declared unit are available. The system is material-agnostic and is designed to work with product-specific or other supported EPD records rather than relying on one hard-coded material list.</div></details></div></div></section><section class=\"bg-white border-t border-slate-200\"><div class=\"max-w-5xl mx-auto px-4 sm:px-6 py-12\"><h2 class=\"text-xl font-black text-slate-950\">Methodology and responsible use</h2><p class=\"mt-3 text-sm leading-6 text-slate-600\">This application is an engineering calculation and decision-support tool. Results depend on the quantities, declared units, environmental datasets, lifecycle boundaries, service-life assumptions and transport information supplied to the model. Product-specific EPDs should be checked against their original publication before formal reporting. Missing lifecycle values are intentionally kept unavailable rather than fabricated.</p><p class=\"mt-3 text-sm leading-6 text-slate-600\">Baseline-versus-proposed and LEED-related outputs are provided as workflow support and indicative checks; they are not certification decisions. A formal whole-building LCA should use project-appropriate standards, functional equivalence, verified data and professional review.</p></div></section></main><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-5 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center sm:justify-start\" href=\"/\"><svg class=\"mr-2 h-7 w-7 shrink-0 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg><span class=\"font-black tracking-tight text-white\">GreenEngineering Tools</span></a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Browser-based tools and practical guides for embodied carbon, EPD data, BIM material workflows and whole-building life-cycle assessment.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/#calculator-workspace\">Open LCA calculator →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/actual-data\">Actual / Complex Goods</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/electricity\">CBAM Electricity</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/bulk\">Official Bulk CSV</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Learn</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">More Guides</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer additional guides\"><a class=\"block hover:text-white\" href=\"/bim-embodied-carbon\">BIM Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/whole-building-lca\">Whole-Building LCA</a><a class=\"block hover:text-white\" href=\"/module-d-lca\">Module D Explained</a><a class=\"block hover:text-white\" href=\"/leed-whole-building-lca\">LEED Whole-Building LCA</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Company</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer company navigation\"><a class=\"block hover:text-white\" href=\"/about\">About Us</a><a class=\"block hover:text-white\" href=\"/contact\">Contact</a><a class=\"block hover:text-white\" href=\"/privacy-policy\">Privacy Policy</a><a class=\"block hover:text-white\" href=\"/terms-of-service\">Terms of Service</a></nav></div></div><div class=\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\"><p class=\"text-center text-xs text-slate-500 md:text-left\">© <!-- -->2026<!-- --> Green Engineering Tools. All rights reserved.</p><p class=\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\">Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.</p></div></div></footer><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[22016,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"\\\"]\\n3:I[89759,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"default\\\"]\\n4:I[39756,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"default\\\"]\\n5:I[37457,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"default\\\"]\\nb:I[68027,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/05r9umnlogrxm.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chu