rs\",\"children\":\"Terms\"}]\n1a:[\"$\",\"div\",null,{\"className\":\"mt-10 pt-7 border-t border-slate-800 flex flex-col md:flex-row gap-4 justify-between items-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-slate-500 text-center md:text-left\",\"children\":[\"© \",2026,\" Green Engineering Tools. All rights reserved.\"]}],[\"$\",\"p\",null,{\"className\":\"max-w-2xl text-xs leading-5 text-slate-500 text-center md:text-right\",\"children\":\"Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.\"}]]}]\n1b:[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Building Transparency distinguishes upfront carbon assessment from whole-life assessment: upfront tools focus on stages measurable at the beginning of a project, while whole-life assessment also anticipates future use-stage and end-of-life effects. Complete LCA can also include impact categories beyond GWP, such as acidification and eutrophication.\"}]\n1c:[\"$\",\"section\",\"scope\",{\"id\":\"scope\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Define the building scope before calculating\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The most important question is not 'what is the total?' but 'total of what?' A study may cover structure and enclosure, or a broader set of interiors and hardscape. Certification programs can prescribe specific scope. Internal design studies can choose another scope, but the boundary should be explicit.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A transparent report states gross floor area, study period, included building systems, excluded systems, data source hierarchy and lifecycle modules. This makes it possible to interpret kg CO₂e/m² and compare options fairly.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n1d:[\"$\",\"section\",\"stages\",{\"id\":\"stages\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"From A1-A3 to C1-C4\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A whole-building model typically starts with product-stage manufacturing, then adds project transport and construction, replacement during the study period, and end-of-life stages. Operational energy can be analyzed as a separate project-level trajectory when useful, but reporting frameworks may define whether it belongs in the WBLCA result.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Module D is beyond the product life-cycle boundary and should remain a separate line rather than silently reducing the A-C result.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n1e:[\"$\",\"section\",\"comparison\",{\"id\":\"comparison\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Baseline versus proposed design\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Comparative WBLCA is powerful because it answers a design question rather than only producing an absolute number. The baseline and proposed models should use consistent software, datasets, service period and system boundary. Functional differences should be controlled so the result reflects design decisions instead of unrelated scope changes.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A line-by-line delta can show which substitutions create the largest savings or increases. This is often more actionable than a single percentage at the top of a report.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n1f:[\"$\",\"section\",\"impacts\",{\"id\":\"impacts\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Carbon is important, but LCA can report more than GWP\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"GWP in kg CO₂e is the most familiar indicator and is central to embodied-carbon targets. Whole-building LCA can also report acidification, eutrophication, ozone depletion, smog or other indicators depending on the method and reporting framework.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Environmental indicators are not interchangeable. If an EPD or database does not provide a particular category, the tool should not estimate it by multiplying GWP by an arbitrary percentage.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n20:[\"$\",\"section\",\"report\",{\"id\":\"report\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What a useful WBLCA report should contain\"}],\"$undefined\",[\"$\",\"ul\",null,{\"className\":\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Project description, gross floor area and study period.\",{\"children\":\"Project description, gross floor area and study period.\"}],[\"$\",\"li\",\"System boundary and included building systems.\",{\"children\":\"System boundary and included building systems.\"}],[\"$\",\"li\",\"Data sources and version or EPD identifiers.\",{\"children\":\"Data sources and version or EPD identifiers.\"}],[\"$\",\"li\",\"Declared-unit and quantity-conversion methodology.\",{\"children\":\"Declared-unit and quantity-conversion methodology.\"}],[\"$\",\"li\",\"Results by lifecycle module and impact category.\",{\"children\":\"Results by lifecycle module and impact category.\"}],[\"$\",\"li\",\"Baseline and proposed differences where comparison is performed.\",{\"children\":\"Baseline and proposed differences where comparison is performed.\"}],[\"$\",\"li\",\"Module D reported separately.\",{\"children\":\"Module D reported separately.\"}],[\"$\",\"li\",\"Missing-data and proxy-material disclosure.\",{\"children\":\"Missing-data and proxy-material disclosure.\"}],[\"$\",\"li\",\"A narrative explaining the design changes that drive the result.\",{\"children\":\"A narrative explaining the design changes that drive the result.\"}]]}],\"$undefined\",\"$undefined\",\"$undefined\"]}]\n21:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-slate-200 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-3\",\"children\":[[\"$\",\"details\",\"What is a whole-building LCA calculator?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What is a whole-building LCA calculator?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"It combines material quantities, lifecycle datasets and project assumptions across a building scope to report environmental impacts over a defined study period.\"}]]}],[\"$\",\"details\",\"Is whole-building LCA the same as embodied carbon?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is whole-building LCA the same as embodied carbon?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Embodied carbon focuses on GWP associated with materials and construction processes. Whole-building LCA can include multiple environmental impact categories and a broader lifecycle scope.\"}]]}],[\"$\",\"details\",\"Why normalize WBLCA by floor area?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Why normalize WBLCA by floor area?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"kg CO₂e/m² helps compare projects of different size, but only when the system boundary and assumptions are comparable.\"}]]}],[\"$\",\"details\",\"Should Module D be included in the building total?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Should Module D be included in the building total?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"It should generally be shown separately from A-C because it represents benefits or loads beyond the assessed system boundary.\"}]]}]]}]]}]\n22:[\"$\",\"section\",null,{\"className\":\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-black text-slate-950\",\"children\":\"Authoritative references\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-6 text-slate-600\",\"children\":\"These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://docs.buildingtransparency.org/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://docs.buildingtransparency.org/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency documentation — EC3 and tallyLCA scope\"}]}],[\"$\",\"li\",\"https://www.buildingtransparency.org/tools/ec3/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.buildingtransparency.org/tools/ec3/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency — EC3 tool\"}]}],[\"$\",\"li\",\"https://www.usgbc.org/node/2755842\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.usgbc.org/node/2755842\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"USGBC — LEED v4 Building Life-Cycle Impact Reduction guide\"}]}]]}]]}]\n23:[\"$\",\"section\",null,{\"className\":\"mt-14\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-slate-950\",\"children\":\"Continue learning\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 grid sm:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L2\",\"/methodology\",{\"hr