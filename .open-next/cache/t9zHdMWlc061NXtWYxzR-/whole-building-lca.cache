{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/whole-building-lca/layout,_N_T_/whole-building-lca/page,_N_T_/whole-building-lca"},"segmentPaths":["/_tree","/_full","/_index","/whole-building-lca/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1-g31890cs4so.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/38514q3x-5nzy.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Whole-Building LCA Calculator Guide | Green Engineering Tools</title><meta name=\"description\" content=\"Understand whole-building life-cycle assessment: scope, study period, lifecycle modules, baseline comparison, impact categories and kg CO₂e/m² reporting.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet: