{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/leed-whole-building-lca/layout,_N_T_/leed-whole-building-lca/page,_N_T_/leed-whole-building-lca"},"segmentPaths":["/_tree","/_full","/_index","/leed-whole-building-lca/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1-g31890cs4so.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/38514q3x-5nzy.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>LEED Whole-Building LCA: v4, v4.1 &amp; v5 | Green Engineering Tools</title><meta name=\"description\" content=\"Understand LEED whole-building LCA requirements across v4, v4.1 and v5, including baseline comparison, GWP reductions, impact categories and study scope.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/leed-whole-building-lca\"/><meta property=\"og:title\" content=\"LEED Whole-Building LCA: v4, v4.1 &amp; v5\"/><meta property=\"og:description\" content=\"Understand LEED whole-building LCA requirements across v4, v4.1 and v5, including baseline comparison, GWP reductions, impact categories and study scope.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com/leed-whole-building-lca\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Calculate embodied carbon from construction quantities, EPD data and lifecycle modules.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className min-h-screen flex flex-col bg-slate-50\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm w-full\"><nav aria-label=\"Main navigation\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between items-center h-20\"><a aria-label=\"Green Engineering Tools home\" class=\"flex items-center cursor-pointer z-50 shrink-0\" href=\"/\"><div class=\"bg-emerald-500 p-2 rounded-lg mr-2 sm:mr-3 shadow-inner shadow-emerald-700/50\"><svg class=\"w-6 h-6 sm:w-7 sm:h-7 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg></div><span class=\"font-black text-lg sm:text-2xl tracking-tight text-slate-900\">GreenEngineering<span class=\"text-emerald-600\">LCA</span></span></a><div class=\"hidden lg:flex items-center gap-6\"><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/\">The Engine</a><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/about\">About</a><a class=\"text-sm font-bold transition-colors text-slate-600 hover:text-emerald-600\" href=\"/contact\">Contact</a><a class=\"bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-md text-sm font-bold shadow-md transition-all whitespace-nowrap\" href=\"/#calculator-workspace\">Launch Workspace</a></div><details class=\"lg:hidden group relative\"><summary aria-label=\"Open navigation menu\" class=\"list-none cursor-pointer p-2 text-slate-600 hover:text-emerald-600 focus:outline-none transition-colors\"><svg class=\"w-7 h-7 block group-open:hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg><svg class=\"w-7 h-7 hidden group-open:block\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M6 18L18 6M6 6l12 12\"></path></svg></summary><div class=\"fixed top-20 left-0 right-0 max-h-[calc(100vh-5rem)] overflow-y-auto bg-white border-b border-slate-200 shadow-xl z-40\"><div class=\"max-w-7xl mx-auto px-5 sm:px-6 py-6\"><div class=\"grid gap-1\"><div class=\"rounded-xl bg-slate-50 border border-slate-200 p-3\"><div class=\"px-2 pb-2 text-[11px] font-black uppercase tracking-widest text-slate-400\">Calculators</div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2\"><a class=\"rounded-lg bg-slate-900 px-4 py-3.5 text-center text-sm font-black text-white hover:bg-slate-800 transition-colors\" href=\"/#calculator-workspace\">LCA Calculator</a><a class=\"rounded-lg bg-emerald-600 px-4 py-3.5 text-center text-sm font-black text-white hover:bg-emerald-500 transition-colors\" href=\"/cbam-calculator\">CBAM Calculator</a></div></div><a class=\"mt-2 rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/\">The Engine</a><a class=\"rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/cbam-calculator\">CBAM Calculator</a><a class=\"rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/guides\">LCA Guides</a><a class=\"rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/methodology\">Methodology</a><div class=\"mt-2 rounded-xl bg-slate-50 border border-slate-200 p-3\"><div class=\"px-2 pb-2 text-[11px] font-black uppercase tracking-widest text-slate-400\">Popular learning guides</div><a class=\"block rounded-lg px-2 py-2.5 text-sm font-semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator Guide</a><a class=\"block rounded-lg px-2 py-2.5 text-sm font-semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block rounded-lg px-2 py-2.5 text-sm font-semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block rounded-lg px-2 py-2.5 text-sm font-semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/whole-building-lca\">Whole-Building LCA</a></div><a class=\"mt-2 rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/about\">About Us</a><a class=\"rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/contact\">Contact</a></div><div class=\"pt-5 mt-4 border-t border-slate-200\"><a class=\"block text-center bg-slate-900 hover:bg-slate-800 text-white px-5 py-4 rounded-lg text-base font-bold shadow-md transition-all\" href=\"/#calculator-workspace\">Launch LCA Workspace</a></div></div></div></details></div></div></nav></header><div class=\"flex-1\"><main class=\"min-h-screen bg-slate-50\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":\"LEED Whole-Building LCA: v4, v4.1 & v5\",\"description\":\"Understand LEED whole-building LCA requirements across v4, v4.1 and v5, including baseline comparison, GWP reductions, impact categories and study scope.\",\"dateModified\":\"2026-08-31\",\"mainEntityOfPage\":\"https://greenengineeringtools.com/leed-whole-building-lca\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Green Engineering Tools\",\"url\":\"https://greenengineeringtools.com\"},\"about\":[\"Life cycle assessment\",\"Embodied carbon\",\"Environmental Product Declarations\",\"Building materials\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenengineeringtools.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://greenengineeringtools.com/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"LEED Whole-Building LCA: v4, v4.1 & v5\",\"item\":\"https://greenengineeringtools.com/leed-whole-building-lca\"}]}</script><section class=\"bg-slate-950 text-white\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\"><nav class=\"text-sm text-slate-400 mb-7\" aria-label=\"Breadcrumb\"><a class=\"hover:text-white\" href=\"/\">Home</a><span class=\"mx-2\">/</span><a class=\"hover:text-white\" href=\"/guides\">Guides</a></nav><p class=\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\">LEED WBLCA guide</p><h1 class=\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\">LEED Whole-Building LCA: v4, v4.1 &amp; v5</h1><p class=\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\">Understand LEED whole-building LCA requirements across v4, v4.1 and v5, including baseline comparison, GWP reductions, impact categories and study scope.</p><div class=\"mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\" href=\"/#calculator-workspace\">Open the LCA calculator</a><a class=\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\" href=\"/methodology\">Read methodology</a></div><p class=\"mt-6 text-xs text-slate-500\">Last reviewed: <!-- -->2026-08-31</p></div></section><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\"><article class=\"min-w-0\"><div class=\"space-y-14\"><section id=\"versions\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">LEED whole-building LCA depends on the rating-system version</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The phrase &#x27;LEED whole-building LCA&#x27; does not describe one timeless threshold. LEED v4, v4.1 and v5 use related but different pathways and reduction levels. A software interface should therefore identify which version is being checked rather than presenting one percentage test as universal LEED certification.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The current calculator includes an indicative LEED v4-style comparison. It should be treated as design support until the project team verifies the applicable LEED version, scope, functional equivalence, impact method and documentation requirements.</p></section><section id=\"v4\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">LEED v4 Building Life-Cycle Impact Reduction</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">USGBC&#x27;s LEED v4 guidance for the whole-building LCA option requires the proposed building to demonstrate at least a 10% reduction in global warming potential and at least a 10% reduction in two additional impact measures compared with a baseline, while no assessed measure may increase by more than 5%. The assessment is cradle to grave for the defined structure and enclosure scope over the assumed service life.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">That means a calculator needs more than GWP if it is being used for the comparative credit. It must preserve the other required impact categories and apply the same software tools and datasets to the baseline and proposed cases.</p></section><section id=\"v41\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">LEED v4.1 adds multiple WBLCA achievement paths</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">LEED v4.1 BD+C provides multiple pathways. Published USGBC guidance includes a path for conducting the assessment and higher point levels for reductions such as 5%, 10% and, with additional reuse or salvage requirements, 20% GWP reduction together with reductions in other impact categories. No assessed impact category may increase by more than 5% for the comparative reduction paths.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">USGBC also requires the baseline and proposed buildings to be comparable in size, function, orientation and operating energy performance, and to use the same service life, at least 60 years, for the cited v4.1 paths.</p></section><section id=\"v5\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">LEED v5 changes the embodied-carbon framework</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">LEED v5 BD+C, in the February 2026 rating system, uses a cradle-to-grave whole-building LCA covering modules A-C while excluding operating energy and operating-water-related energy from the WBLCA result. It includes GWP plus ozone depletion, acidification, eutrophication and tropospheric ozone formation in the WBLCA report.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">For new construction, the v5 whole-building LCA option awards increasing points as GWP reductions reach higher thresholds. The published table includes 10%, 20%, 30%, 40% and 50% or greater reduction levels, making version-aware compliance logic important for any current LCA SaaS.</p></section><section id=\"equivalence\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Functional equivalence is essential to a LEED comparison</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A baseline should not be made artificially carbon-heavy by changing floor area, function or performance assumptions. The point of the comparison is to isolate design improvements. Keep the study period, scope, datasets and calculation method consistent, then document the design changes that explain the reduction.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The software can help by storing gross floor area, building use, study period and system boundary alongside the BOM. A warning should appear when baseline and proposed project metadata are materially different.</p></section><section id=\"software\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How the calculator should support LEED without overclaiming</h2><ul class=\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\"><li>Label every compliance check with the specific LEED version and path.</li><li>Show the underlying impact-category reductions, not only a green &#x27;pass&#x27; badge.</li><li>Keep missing impact categories visible instead of estimating them from GWP.</li><li>Report baseline and proposed quantities and lifecycle boundaries.</li><li>Include a methodology narrative and data-quality section in the export.</li><li>Use language such as &#x27;indicative check&#x27; until the workflow has been independently validated for formal submission.</li></ul><div class=\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\"><h3 class=\"font-black text-amber-950\">Software does not certify a LEED credit</h3><p class=\"mt-2 leading-7 text-amber-900\">A calculator can implement the published comparison logic, but the project team&#x27;s documentation and the certification review determine whether the credit is achieved.</p></div></section></div><section class=\"mt-16 border-t border-slate-200 pt-10\"><h2 class=\"text-2xl sm:text-3xl font-black text-slate-950\">Frequently asked questions</h2><div class=\"mt-6 space-y-3\"><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>What is the LEED v4 WBLCA reduction requirement?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">USGBC&#x27;s v4 guidance requires at least 10% GWP reduction plus 10% reduction in two additional impact measures, with no assessed measure increasing by more than 5%.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Does LEED v4.1 use the same threshold as v4?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">No. v4.1 provides multiple paths and point levels, including 5% and 10% reduction paths and a higher 20% GWP path with additional conditions.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>What changed in LEED v5 whole-building LCA?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">The February 2026 BD+C rating system uses a cradle-to-grave A-C WBLCA excluding operating energy and operating-water-related energy, and awards more points at progressively higher GWP reductions.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Can this calculator guarantee LEED certification?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">No. It can support calculations and comparison logic, but formal achievement depends on the applicable rating-system rules, complete project documentation and certification review.</div></details></div></section><section class=\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\"><h2 class=\"text-xl font-black text-slate-950\">Authoritative references</h2><p class=\"mt-2 text-sm leading-6 text-slate-600\">These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.</p><ul class=\"mt-4 space-y-2 text-sm\"><li><a href=\"https://www.usgbc.org/node/2755842\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">USGBC — LEED v4 Building Life-Cycle Impact Reduction guide</a></li><li><a href=\"https://www.usgbc.org/sites/default/files/2021-03/LEED%20v4.1%20BD%2BC%20Guide%2004092019.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">USGBC — LEED v4.1 BD+C guide</a></li><li><a href=\"https://www.usgbc.org/sites/default/files/2026-03/LEED%20v5%20BD%2BC%20Rating%20System_February%202026.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">USGBC — LEED v5 BD+C rating system, February 2026</a></li></ul></section><section class=\"mt-14\"><h2 class=\"text-2xl font-black text-slate-950\">Continue learning</h2><div class=\"mt-5 grid sm:grid-cols-2 gap-4\"><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/whole-building-lca\"><h3 class=\"font-black text-slate-950\">Whole-building LCA guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand scope, service life, baseline comparison and whole-life reporting.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/methodology\"><h3 class=\"font-black text-slate-950\">LCA calculation methodology</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">See how quantities, units, lifecycle modules, replacements and missing data are handled.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/module-d-lca\"><h3 class=\"font-black text-slate-950\">Module D explained</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand recycling and reuse benefits beyond the system boundary without double counting.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/embodied-carbon-calculator\"><h3 class=\"font-black text-slate-950\">Embodied carbon calculator guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how to turn a construction material schedule into an auditable carbon result.</p></a></div></section></article><aside class=\"hidden lg:block\"><div class=\"sticky top-24 rounded-xl border border-slate-200 bg-white p-5\"><h2 class=\"text-xs font-black uppercase tracking-widest text-slate-500\">On this page</h2><nav class=\"mt-4 space-y-3 text-sm\"><a href=\"#versions\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">LEED whole-building LCA depends on the rating-system version</a><a href=\"#v4\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">LEED v4 Building Life-Cycle Impact Reduction</a><a href=\"#v41\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">LEED v4.1 adds multiple WBLCA achievement paths</a><a href=\"#v5\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">LEED v5 changes the embodied-carbon framework</a><a href=\"#equivalence\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Functional equivalence is essential to a LEED comparison</a><a href=\"#software\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How the calculator should support LEED without overclaiming</a><a href=\"#top\" class=\"block pt-3 border-t border-slate-100 font-bold text-slate-400 hover:text-slate-700\">Back to top</a></nav></div></aside></div></main><!--$--><!--/$--></div><footer class=\"bg-slate-950 text-slate-400 border-t border-slate-800 w-full mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-9 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center\" href=\"/\"><svg class=\"w-7 h-7 text-emerald-