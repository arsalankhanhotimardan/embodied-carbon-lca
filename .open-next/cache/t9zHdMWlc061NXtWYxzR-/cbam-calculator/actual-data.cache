semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block rounded-lg px-2 py-2.5 text-sm font-semibold text-slate-600 hover:text-emerald-700 hover:bg-white\" href=\"/whole-building-lca\">Whole-Building LCA</a></div><a class=\"mt-2 rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/about\">About Us</a><a class=\"rounded-lg px-3 py-3 text-base font-bold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50\" href=\"/contact\">Contact</a></div><div class=\"pt-5 mt-4 border-t border-slate-200\"><a class=\"block text-center bg-slate-900 hover:bg-slate-800 text-white px-5 py-4 rounded-lg text-base font-bold shadow-md transition-all\" href=\"/#calculator-workspace\">Launch LCA Workspace</a></div></div></div></details></div></div></nav></header><div class=\"flex-1\"><main class=\"jsx-82efdf2127899207 mx-auto max-w-6xl px-4 py-10 sm:px-6\"><div class=\"jsx-82efdf2127899207 flex flex-wrap items-center justify-between gap-3\"><div class=\"jsx-82efdf2127899207\"><div class=\"jsx-82efdf2127899207 text-xs font-black uppercase tracking-widest text-indigo-700\">Advanced CBAM methodology</div><h1 class=\"jsx-82efdf2127899207 mt-2 text-3xl font-black text-slate-950 sm:text-4xl\">Actual &amp; complex-goods calculator</h1><p class=\"jsx-82efdf2127899207 mt-3 max-w-3xl text-slate-600\">Enter your own installation and supplier data. This page no longer loads demonstration country, CN code, route, emissions, mass or price values.</p></div><a class=\"rounded-xl border border-slate-300 bg-white px-4 py-2 font-bold text-slate-700\" href=\"/cbam-calculator\">← Main calculator</a></div><div class=\"jsx-82efdf2127899207 mt-8 grid gap-6 lg:grid-cols-2\"><section class=\"jsx-82efdf2127899207 space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm\"><h2 class=\"jsx-82efdf2127899207 text-xl font-black\">Good &amp; process data</h2><div class=\"jsx-82efdf2127899207 grid gap-4 sm:grid-cols-2\"><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Country of origin</span><select class=\"jsx-82efdf2127899207 input\"><option value=\"\" class=\"jsx-82efdf2127899207\" selected=\"\">Select country</option></select></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">CN / TARIC code</span><input placeholder=\"e.g. 7208\" class=\"jsx-82efdf2127899207 input font-mono\" value=\"\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Reporting / import year</span><select class=\"jsx-82efdf2127899207 input\"><option value=\"2026\" class=\"jsx-82efdf2127899207\" selected=\"\">2026</option><option value=\"2027\" class=\"jsx-82efdf2127899207\">2027</option><option value=\"2028\" class=\"jsx-82efdf2127899207\">2028</option><option value=\"2029\" class=\"jsx-82efdf2127899207\">2029</option><option value=\"2030\" class=\"jsx-82efdf2127899207\">2030</option><option value=\"2031\" class=\"jsx-82efdf2127899207\">2031</option><option value=\"2032\" class=\"jsx-82efdf2127899207\">2032</option><option value=\"2033\" class=\"jsx-82efdf2127899207\">2033</option><option value=\"2034\" class=\"jsx-82efdf2127899207\">2034</option></select></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Production year</span><select class=\"jsx-82efdf2127899207 input\"><option value=\"2026\" class=\"jsx-82efdf2127899207\" selected=\"\">2026</option></select></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Production route</span><select class=\"jsx-82efdf2127899207 input\"><option value=\"\" class=\"jsx-82efdf2127899207\" selected=\"\">Auto / not specified</option><option value=\"A\" class=\"jsx-82efdf2127899207\">A — grey clinker / cement</option><option value=\"B\" class=\"jsx-82efdf2127899207\">B — white clinker / cement</option><option value=\"C\" class=\"jsx-82efdf2127899207\">C — Carbon Steel BF/BOF</option><option value=\"D\" class=\"jsx-82efdf2127899207\">D — Carbon Steel DRI/EAF</option><option value=\"E\" class=\"jsx-82efdf2127899207\">E — Carbon Steel Scrap/EAF</option><option value=\"F\" class=\"jsx-82efdf2127899207\">F — Low alloy Steel BF/BOF</option><option value=\"G\" class=\"jsx-82efdf2127899207\">G — Low alloy Steel DRI/EAF</option><option value=\"H\" class=\"jsx-82efdf2127899207\">H — Low alloy Steel Scrap/EAF</option><option value=\"J\" class=\"jsx-82efdf2127899207\">J — High alloy Steel EAF</option><option value=\"K\" class=\"jsx-82efdf2127899207\">K — primary Aluminium</option><option value=\"L\" class=\"jsx-82efdf2127899207\">L — secondary Aluminium</option></select></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Installation activity level (t)</span><input type=\"number\" min=\"0.0001\" placeholder=\"Enter activity level\" class=\"jsx-82efdf2127899207 input\" value=\"\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Process direct emissions (tCO₂e)</span><input type=\"number\" min=\"0\" placeholder=\"Enter direct emissions\" class=\"jsx-82efdf2127899207 input\" value=\"\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Process indirect emissions (tCO₂e)</span><input type=\"number\" min=\"0\" class=\"jsx-82efdf2127899207 input\" value=\"0\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Imported mass (t)</span><input type=\"number\" min=\"0\" placeholder=\"Enter imported mass\" class=\"jsx-82efdf2127899207 input\" value=\"\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Earlier YTD threshold-eligible mass (t)</span><input type=\"number\" min=\"0\" class=\"jsx-82efdf2127899207 input\" value=\"0\"/></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Certificate-price period</span><select class=\"jsx-82efdf2127899207 input\"><option value=\"planning\" class=\"jsx-82efdf2127899207\" selected=\"\">Planning price / manual</option></select></label><label><span class=\"mb-1 block text-xs font-black text-slate-600\">Planning price (€ / tCO₂e)</span><input type=\"number\" min=\"0\" placeholder=\"Enter planning price\" class=\"jsx-82efdf2127899207 input read-only:bg-slate-100\" value=\"\"/></label></div><label class=\"jsx-82efdf2127899207 flex gap-3 rounded-xl border border-slate-200 p-4 text-sm\"><input type=\"checkbox\" class=\"jsx-82efdf2127899207\"/><span class=\"jsx-82efdf2127899207\"><strong class=\"jsx-82efdf2127899207\">Actual emissions are supported by an accredited-verifier workflow.</strong><br class=\"jsx-82efdf2127899207\"/><span class=\"jsx-82efdf2127899207 text-slate-500\">This records your confirmation only; the tool does not itself perform verification.</span></span></label><div class=\"jsx-82efdf2127899207 border-t border-slate-200 pt-5\"><div class=\"jsx-82efdf2127899207 flex items-center justify-between gap-3\"><div class=\"jsx-82efdf2127899207\"><h3 class=\"jsx-82efdf2127899207 font-black\">Precursors</h3><p class=\"jsx-82efdf2127899207 text-xs text-slate-500\">Add only precursors that belong to this actual-data calculation.</p></div><button type=\"button\" class=\"jsx-82efdf2127899207 rounded-lg bg-slate-900 px-3 py-2 text-sm font-black text-white\">+ Add</button></div><div class=\"jsx-82efdf2127899207 mt-4 space-y-4\"></div></div><div class=\"jsx-82efdf2127899207 border-t border-slate-200 pt-5\"><label class=\"jsx-82efdf2127899207 flex gap-3 text-sm\"><input type=\"checkbox\" class=\"jsx-82efdf2127899207\"/><span class=\"jsx-82efdf2127899207\"><strong class=\"jsx-82efdf2127899207\">Claim a qualifying carbon price paid in the country of origin</strong></span></label></div><button type=\"button\" class=\"jsx-82efdf2127899207 w-full rounded-xl bg-indigo-700 px-5 py-3 font-black text-white disabled:opacity-50\">Calculate actual / complex goods</button></section><section class=\"jsx-82efdf2127899207 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm\"><h2 class=\"jsx-82efdf2127899207 text-xl font-black\">Result</h2><p class=\"jsx-82efdf2127899207 mt-4 text-sm text-slate-500\">Enter your data and run a calculation. No country, CN code, route, mass, emissions or price is preloaded as a demonstration value.</p></section></div></main><!--$--><!--/$--></div><footer class=\"bg-slate-950 text-slate-400 border-t border-slate-800 w-full mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-9 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center\" href=\"/\"><svg class=\"w-7 h-7 text-emerald-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg><span class=\"font-black text-white tracking-tight\">GreenEngineering Tools</span></a><p class=\"mt-4 max-w-xs text-sm leading-6 text-slate-400\">Browser-based tools and practical guides for embodied carbon, EPD data, BIM material workflows and whole-building life-cycle assessment.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/#calculator-workspace\">Open LCA calculator →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer tools navigation\"><a class=\"block hover:text-white transition-colors\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white transition-colors\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white transition-colors\" href=\"/methodology\">Methodology</a><a class=\"block hover:text-white transition-colors\" href=\"/guides\">All Guides</a></nav></div><div class=\"sm:col-span-2 lg:col-span-1\"><h2 c