{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/methodology/layout,_N_T_/methodology/page,_N_T_/methodology"},"segmentPaths":["/_tree","/_full","/_index","/methodology/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1-g31890cs4so.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/38514q3x-5nzy.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Building LCA Methodology: Embodied Carbon A1-D | Green Engineering Tools</title><meta name=\"description\" content=\"A transparent building LCA methodology for quantities, EPD units, A1-A3, A4, B4 replacements, C1-C4, Module D, baseline comparison and data quality.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/methodology\"/><meta property=\"og:title\" content=\"Building LCA Methodology: Embodied Carbon A1-D\"/><meta property=\"og:description\" content=\"A transparent building LCA methodology for quantities, EPD units, A1-A3, A4, B4 replacements, C1-C4, Module D, baseline comparison and data quality.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com/methodology\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Calculate embodied carbon from construction quantities, EPD data and lifecycle modules.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className min-h-screen flex flex-col bg-slate-50\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm w-full\"><nav aria-label=\"Main navigation\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between items-center h-20\"><a aria-label=\"Green Engineering Tools home\" class=\"flex items-center cursor-pointer z-50 shrink-0\" href=\"/\"><div class=\"bg-emerald-500 p-2 rounded-lg mr-2 sm:mr-3 shadow-inner shadow-emerald-700/50\"><svg class=\"w-6 h-6 sm:w-7 sm:h-7 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg></div><span class=\"font-black text-lg sm:text-2xl tracking-tight text-slate-900\">GreenEngineering