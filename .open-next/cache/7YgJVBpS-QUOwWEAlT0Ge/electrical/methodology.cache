te\",\"children\":\"3-Phase Voltage Drop\"}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xs font-black uppercase tracking-widest text-white\",\"children\":\"LCA learning\"}],[\"$\",\"nav\",null,{\"className\":\"mt-4 space-y-3 text-sm\",\"aria-label\":\"Footer LCA learning navigation\",\"children\":[[\"$\",\"$L2\",\"/embodied-carbon-calculator\",{\"href\":\"/embodied-carbon-calculator\",\"className\":\"block hover:text-white\",\"children\":\"Embodied Carbon Calculator\"}],[\"$\",\"$L2\",\"/a1-a3-embodied-carbon\",{\"href\":\"/a1-a3-embodied-carbon\",\"className\":\"block hover:text-white\",\"children\":\"A1-A3 Embodied Carbon\"}],[\"$\",\"$L2\",\"/epd-carbon-calculator\",{\"href\":\"/epd-carbon-calculator\",\"className\":\"block hover:text-white\",\"children\":\"EPD Carbon Calculator\"}],[\"$\",\"$L2\",\"/ec3-epd-guide\",{\"href\":\"/ec3-epd-guide\",\"className\":\"block hover:text-white\",\"children\":\"EC3 EPD Guide\"}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xs font-black uppercase tracking-widest text-white\",\"children\":\"Company\"}],[\"$\",\"nav\",null,{\"className\":\"mt-4 space-y-3 text-sm\",\"aria-label\":\"Footer company navigation\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/about\",\"className\":\"block hover:text-white\",\"children\":\"About Us\"}],[\"$\",\"$L2\",null,{\"href\":\"/contact\",\"className\":\"block hover:text-white\",\"children\":\"Contact\"}],[\"$\",\"$L2\",null,{\"href\":\"/privacy-policy\",\"className\":\"block hover:text-white\",\"children\":\"Privacy Policy\"}],[\"$\",\"$L2\",null,{\"href\":\"/terms-of-service\",\"className\":\"block hover:text-white\",\"children\":\"Terms of Service\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\",\"children\":[\"$Lc\",\"$Ld\"]}]]}]}]\nc:[\"$\",\"p\",null,{\"className\":\"text-center text-xs text-slate-500 md:text-left\",\"children\":[\"© \",2026,\" Green Engineering Tools. All rights reserved.\"]}]\nd:[\"$\",\"p\",null,{\"className\":\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\",\"children\":\"Engineering decision-support tools. Formal compliance, certification and site-specific electrical design remain subject to applicable standards, manufacturer data and qualified professional review.\"}]\nb:true\n9:300\n9:C\na:0\n8:\"$undefined\"\n","/electrical/methodology/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"\"]\n8:X\nd:X\nd:C\n0:{\"buildId\":\"7YgJVBpS-QUOwWEAlT0Ge\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"bg-white\",\"children\":[[\"$\",\"section\",null,{\"className\":\"bg-slate-950 text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-18\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/electrical\",\"className\":\"text-xs font-black text-emerald-300 hover:underline\",\"children\":\"← Electrical tools\"}],[\"$\",\"h1\",null,{\"className\":\"mt-5 text-4xl font-black sm:text-5xl\",\"children\":\"Electrical calculation methodology\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-lg leading-8 text-slate-300\",\"children\":\"The formulas, conductor properties, boundaries and responsible-use rules behind the electrical calculators.\"}]]}]}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-4xl space-y-12 px-4 py-14 sm:px-6 text-slate-600\",\"children\":[[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"1. Current from power\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 overflow-x-auto rounded-2xl border border-slate-200\",\"children\":[\"$\",\"table\",null,{\"className\":\"min-w-[640px] w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-slate-950 text-white\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"p-3 text-left\",\"children\":\"Circuit\"}],[\"$\",\"th\",null,{\"className\":\"p-3 text-left\",\"children\":\"Active power\"}],[\"$\",\"th\",null,{\"className\":\"p-3 text-left\",\"children\":\"Apparent power\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-slate-200\",\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-3 font-bold\",\"children\":\"DC\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"P = V × I\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"Not separately modeled\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-3 font-bold\",\"children\":\"Single-phase AC\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"P = V × I × cos φ\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"S = V × I\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-3 font-bold\",\"children\":\"Balanced three-phase AC\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"P = √3 × V × I × cos φ\"}],[\"$\",\"td\",null,{\"className\":\"p-3\",\"children\":\"S = √3 × V × I\"}]]}]]}]]}]}],[\"$\",\"p\",null,{\"className\":\"mt-4 leading-7\",\"children\":\"Three-phase voltage is line-to-line. The tool assumes a balanced load. Unbalanced phase and neutral-current studies are outside this engine.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"2. Conductor resistance versus temperature\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 leading-7\",\"children\":\"When no manufacturer resistance is entered, the engine uses R = ρL/A with a linear temperature correction referenced to 20 °C. Reference values are 0.017241 Ω·mm²/m and α = 0.00393/°C for 100% IACS copper, and 0.028265 Ω·mm²/m and α = 0.00403/°C for 61% IACS conductor-grade aluminum. For real cable products, manufacturer resistance data is preferred because strand construction and product details can change actual resistance.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"3. Voltage drop\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 rounded-2xl bg-slate-50 p-6 font-mono text-sm leading-7 text-slate-800\",\"children\":[[\"$\",\"p\",null,{\"children\":\"DC: ΔU = 2 × I × L × R\"}],[\"$\",\"p\",null,{\"children\":\"Single-phase AC: ΔU = 2 × I × L × (R cosφ + X sinφ)\"}],[\"$\",\"p\",null,{\"children\":\"Balanced 3-phase AC: ΔU = √3 × I × L × (R cosφ + X sinφ)\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 leading-7\",\"children\":\"R and X are per-length cable values and are divided by the number of equal parallel conductors. Cable length is entered as the one-way source-to-load distance. Percentage drop is ΔU ÷ source voltage × 100.\"}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"4. Real cable power loss\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 leading-7\",\"children\":\"The tool uses conductor resistance, not reactance, for real power dissipation. DC and single-phase two-wire loss is 2 × I² × R × L; balanced three-phase loss is 3 × I² × R × L. Annual energy loss multiplies the operating loss by entered hours/day and 365 days. Annual cost is annual lost kWh × the user-entered energy tariff.\"}]]}],\"$L3\",\"$L4\",\"$L5\"]}]]}],null,\"$L6\"]}],\"isPartial\":\"$@7\",\"staleTime\":\"$8\",\"varyParams\":null},{\"rsc\":\"$L9\",\"isPartial\":\"$@a\",\"staleTime\":\"$8\",\"varyParams\":null},{\"rsc\":\"$Lb\",\"isPartial\":\"$@c\",\"staleTime\":\"$8\",\"varyParams\":\"$d\"},{\"rsc\":\"$Le\",\"isPartial\":\"$@f\",\"staleTime\":\"$8\",\"varyParams\":\"$d\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@10\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@11\"}\n12:I[97367,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"OutletBoundary\"]\n13:\"$Sreact.suspense\"\n15:I[97367,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"ViewportBoundary\"]\n16:I[97367,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"MetadataBoundary\"]\n17:I[27201,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"IconMark\"]\n18:I[39756,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"default\"]\n19:I[37457,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"default\"]\n3:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"5. Wire-size recommendation boundary\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 leading-7\",\"children\":\"The automatic wire-size result searches the standard AWG/kcmil or metric catalog for the smallest size that meets the chosen voltage-drop target at the design current. It does not invent a worldwide ampacity table. Thermal ampacity depends on jurisdiction, cable insulation, installation method, grouping, ambient temperature, terminations and other corrections. If you already know the allowable ampacity of the selected cable after those checks, you can enter it manually in advanced inputs and the calculator will compare it with design current.\"}]]}]\n4:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-black text-slate-950\",\"children\":\"6. Reference sources\"}],[\"$\",\"ul\",null,{\"className\":\"mt-5 space-y-4 text-sm leading-6\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://nvlpubs.nist.gov/nistpubs/Legacy/hb/nbshandbook100.pdf\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-black text-emerald-700 hover:underline\",\"children\":\"NIST / National Bureau of Standards — Copper Wire Tables\"}],[\"$\",\"br\",null,{}],\"Reference copper temperature coefficient and conductor-resistance background.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://nvlpubs.nist.gov/nistpubs/Legacy/circ/nbscircular346.pdf\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-black text-emerald-700 hover:underline\",\"children\":\"NIST / Bureau of Standards — Aluminum conductor properties\"}],[\"$\",\"br\",null,{}],\"Conductor-grade aluminum resistivity and temperature coefficient background.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://library.e.abb.com/public/561a28a17753c444c125714f00360967/1SDC010001D0204.pdf\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-black text-emerald-700 hover:underline\",\"children\":\"ABB — Electrical devices / cable dimensioning\"}],[\"$\",\"br\",null,{}],\"Single-phase and balanced three-phase voltage-drop relationship using R, X and power factor.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.se.com/us/en/download/document/0100DB2301/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-black text-emerald-700 hover:underline\",\"children\":\"Schneider Electric — Electrical Distribution Fundamentals Design Guide\"}],[\"$\",\"br\",null,{}],\"Contemporary power-system design reference and reminder that simplified tools do not replace engineering practice.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.southwire.com/calculator-vdrop\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-black text-emerald-700 hover:underline\",\"children\":\"Southwire — Voltage Drop Calculator\"}],[\"$\",\"br\",null,{}],\"Industry comparison reference showing that conductor sizing must consider both voltage drop and ampacity.\"]}]]}]]}]\n5:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-amber-200 bg-amber-50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-amber-950\",\"children\":\"Not a code-compliance certificate\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-amber-900\",\"children\":\"Electrical codes and conductor ampacity rules vary by jurisdiction and installation. The calculator intentionally fails to claim universal compliance. Final circuit design should be reviewed against the current applicable standard, manufacturer instructions and local authority requirements by a qualified electrical professional.\"}]]}]\n6:[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@14\"}]}]\n9:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L15\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L16\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Electrical Calculator Methodology & Formulas | Green Engineering Tools\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Methodology, formulas, assumptions and source references for Green Engineering Tools voltage drop, wire size, cable length, current and power-loss calculators.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://greenengineeringtools.com\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Engr. Arsalan Khan\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"Green Engineering Tools\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"Green Engineering Tools\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"link\",\"8\",{\"rel\":\"canonical\",\"href\":\"https://greenengineeringtools.com/electrical/methodology\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:title\",\"content\":\"Green Engineering Tools\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:description\",\"content\":\"Free browser-based engineering calculators for carb