{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/epd-carbon-calculator/layout,_N_T_/epd-carbon-calculator/page,_N_T_/epd-carbon-calculator"},"segmentPaths":["/_tree","/_full","/_index","/epd-carbon-calculator/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/23xh-7wmp-5d8.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/1icgbrcdew2yz.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>EPD Carbon Calculator: How to Use EPD Data | Green Engineering Tools</title><meta name=\"description\" content=\"Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/epd-carbon-calculator\"/><meta property=\"og:title\" content=\"EPD Carbon Calculator: How to Use EPD Data\"/><meta property=\"og:description\" content=\"Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com/epd-carbon-calculator\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Embodied Carbon Calculator | Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Calculate embodied carbon from construction quantities, EPD data and lifecycle modules.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className flex min-h-screen w-full min-w-0 flex-col overflow-x-hidden bg-slate-50 text-slate-900\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm\"><nav aria-label=\"Main navigation\"><div class=\"mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8\"><div class=\"flex h-16 min-w-0 items-center justify-between gap-2 sm:h-20 sm:gap-4\"><a aria-label=\"Green Engineering Tools home\" class=\"flex min-w-0 max-w-[calc(100%-3.25rem)] items-center sm:max-w-none\" href=\"/\"><div class=\"mr-2 shrink-0 rounded-lg bg-emerald-500 p-1.5 shadow-inner shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering<span class=\"text-emerald-600\">LCA</span></span></a><div class=\"hidden items-center gap-5 lg:flex xl:gap-6\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">The Engine</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/contact\">Contact</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">Launch Workspace</a></div><div class=\"lg:hidden shrink-0\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><main class=\"min-h-screen bg-slate-50\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":\"EPD Carbon Calculator: How to Use EPD Data\",\"description\":\"Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.\",\"dateModified\":\"2026-08-31\",\"mainEntityOfPage\":\"https://greenengineeringtools.com/epd-carbon-calculator\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Green Engineering Tools\",\"url\":\"https://greenengineeringtools.com\"},\"about\":[\"Life cycle assessment\",\"Embodied carbon\",\"Environmental Product Declarations\",\"Building materials\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenengineeringtools.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://greenengineeringtools.com/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"EPD Carbon Calculator: How to Use EPD Data\",\"item\":\"https://greenengineeringtools.com/epd-carbon-calculator\"}]}</script><section class=\"bg-slate-950 text-white\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\"><nav class=\"text-sm text-slate-400 mb-7\" aria-label=\"Breadcrumb\"><a class=\"hover:text-white\" href=\"/\">Home</a><span class=\"mx-2\">/</span><a class=\"hover:text-white\" href=\"/guides\">Guides</a></nav><p class=\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\">Environmental Product Declarations</p><h1 class=\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\">EPD Carbon Calculator: How to Use EPD Data</h1><p class=\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\">Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.</p><div class=\"mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\" href=\"/#calculator-workspace\">Open the LCA calculator</a><a class=\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\" href=\"/methodology\">Read methodology</a></div><p class=\"mt-6 text-xs text-slate-500\">Last reviewed: <!-- -->2026-08-31</p></div></section><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\"><article class=\"min-w-0\"><div class=\"space-y-14\"><section id=\"what\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">What an Environmental Product Declaration tells you</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">An Environmental Product Declaration is a standardized disclosure of environmental information for a product or product group. For carbon calculations, users often focus on global warming potential, but a useful EPD also identifies the declared unit, lifecycle modules, product description, geography, program operator, PCR and validity information.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">An EPD is not simply a carbon score. It is a structured dataset with a defined scope. The calculator preserves those fields because the context determines whether a number can be used correctly.</p></section><section id=\"read\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Fields to check before using an EPD in a calculator</h2><div class=\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\"><table class=\"w-full min-w-[640px] text-sm\"><thead class=\"bg-slate-900 text-white\"><tr><th class=\"p-3 text-left font-black\">EPD field</th><th class=\"p-3 text-left font-black\">Why it matters</th><th class=\"p-3 text-left font-black\">What to verify</th></tr></thead><tbody class=\"divide-y divide-slate-200\"><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Product / manufacturer</td><td class=\"p-3 leading-6 text-slate-700\">Defines what the dataset represents</td><td class=\"p-3 leading-6 text-slate-700\">Make sure it matches the material or acceptable proxy.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Declared unit and quantity</td><td class=\"p-3 leading-6 text-slate-700\">Defines the basis of every reported impact</td><td class=\"p-3 leading-6 text-slate-700\">Align project quantity before multiplying.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Lifecycle modules</td><td class=\"p-3 leading-6 text-slate-700\">Shows which stages are declared</td><td class=\"p-3 leading-6 text-slate-700\">Do not treat non-declared modules as zero.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">PCR</td><td class=\"p-3 leading-6 text-slate-700\">Sets product-category calculation rules</td><td class=\"p-3 leading-6 text-slate-700\">Be cautious when comparing products under materially different rules.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Geography / plant</td><td class=\"p-3 leading-6 text-slate-700\">Can affect energy and supply-chain relevance</td><td class=\"p-3 leading-6 text-slate-700\">Prefer data appropriate to the project decision where possible.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Validity date</td><td class=\"p-3 leading-6 text-slate-700\">Shows whether the declaration remains current</td><td class=\"p-3 leading-6 text-slate-700\">Check the original EPD before formal reporting.</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">Environmental indicators</td><td class=\"p-3 leading-6 text-slate-700\">Defines GWP and other impact results</td><td class=\"p-3 leading-6 text-slate-700\">Use the exact indicator and unit required by the study.</td></tr></tbody></table></div></section><section id=\"calculation\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How an EPD carbon calculator uses the data</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The calculator first converts the project quantity to the EPD declared basis. It then applies the impact result for each declared lifecycle module. For example, A1-A3 GWP is multiplied by the normalized quantity for manufacturing impact, while C-stage results are kept in their own lifecycle modules.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A dataset that declares only A1-A3 should not suddenly acquire A4, A5 or C-stage impacts from a generic default. If a project wants to add A4 transportation, it can use a documented transport scenario based on mass, mode and distance.</p></section><section id=\"types\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Product-specific, industry-average and generic datasets</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Product-specific EPDs can support procurement decisions because they describe a manufacturer or product more directly. Industry-average EPDs aggregate a broader set of producers. Generic LCA datasets can be useful when no suitable EPD exists or when the project is still at concept stage.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The right choice depends on the question. Early design often values coverage and consistency; procurement values specificity. A transparent system should label the data source rather than presenting every number as equally specific.</p></section><section id=\"nd\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Why &#x27;not declared&#x27; must not become zero</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Some EPDs deliberately do not declare project-specific modules such as A4 or use-stage modules. That absence means there is no reported result for the module in that EPD; it does not prove that the impact is physically zero.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The calculation engine preserves missing values as unavailable. This prevents an incomplete EPD from appearing artificially better than a more complete EPD simply because omitted modules were converted to zero.</p><div class=\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\"><h3 class=\"font-black text-amber-950\">A complete-looking spreadsheet can still be incomplete</h3><p class=\"mt-2 leading-7 text-amber-900\">If missing modules are filled with zeros, totals become easy to calculate but harder to trust. Preserve data gaps and document how they are resolved.</p></div></section><section id=\"matching\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Matching an EPD to a messy BIM material name</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">BIM schedules frequently contain abbreviations, family names, type names or user-entered spelling differences. A material called &#x27;Conc CIP 4ksi&#x27; may need to be searched as &#x27;ready mix concrete&#x27; or another simplified term to find a relevant EPD.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The tool therefore keeps the original BIM alias separate from the editable EC3 search term. The engineer can correct the search without changing the project record, and an approved mapping can be reused for future imports when permitted by the data source and backend configuration.</p></section></div><section class=\"mt-16 border-t border-slate-200 pt-10\"><h2 class=\"text-2xl sm:text-3xl font-black text-slate-950\">Frequently asked questions</h2><div class=\"mt-6 space-y-3\"><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>What is an EPD carbon calculator?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">It is a calculator that uses environmental results reported in an Environmental Product Declaration together with project quantities to estimate impacts for the declared lifecycle modules.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Which EPD number is used for embodied carbon?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Global warming potential, reported in kg CO₂e or an equivalent unit, is the primary carbon indicator. The correct lifecycle module and declared unit must also be identified.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Does every EPD include A1-D?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">No. EPDs can declare different module sets depending on the product category rules and declaration scope. Missing or non-declared modules should not automatically be treated as zero.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Can an industry-average EPD be used when a product-specific EPD is unavailable?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">It may be appropriate for some study stages, but the choice should be documented. Formal requirements may prefer or require particular data types.</div></details></div></section><section class=\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\"><h2 class=\"text-xl font-black text-slate-950\">Authoritative references</h2><p class=\"mt-2 text-sm leading-6 text-slate-600\">These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.</p><ul class=\"mt-4 space-y-2 text-sm\"><li><a href=\"https://www.buildingtransparency.org/tools/ec3/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">Building Transparency — EC3 tool</a></li><li><a href=\"https://docs.buildingtransparency.org/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">Building Transparency documentation — EC3 and tallyLCA scope</a></li></ul></section><section class=\"mt-14\"><h2 class=\"text-2xl font-black text-slate-950\">Continue learning</h2><div class=\"mt-5 grid sm:grid-cols-2 gap-4\"><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/a1-a3-embodied-carbon\"><h3 class=\"font-black text-slate-950\">A1-A3 embodied carbon</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand product-stage GWP, declared units and practical A1-A3 calculations.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/ec3-epd-guide\"><h3 class=\"font-black text-slate-950\">EC3 EPD guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Use EC3 product search and EPD matching without losing the original BIM material name.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/embodied-carbon-calculator\"><h3 class=\"font-black text-slate-950\">Embodied carbon calculator guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how to turn a construction material schedule into an auditable carbon result.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/whole-building-lca\"><h3 class=\"font-black text-slate-950\">Whole-building LCA guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand scope, service life, baseline comparison and whole-life reporting.</p></a></div></section></article><aside class=\"hidden lg:block\"><div class=\"sticky top-24 rounded-xl border border-slate-200 bg-white p-5\"><h2 class=\"text-xs font-black uppercase tracking-widest text-slate-500\">On this page</h2><nav class=\"mt-4 space-y-3 text-sm\"><a href=\"#what\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">What an Environmental Product Declaration tells you</a><a href=\"#read\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Fields to check before using an EPD in a calculator</a><a href=\"#calculation\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How an EPD carbon calculator uses the data</a><a href=\"#types\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Product-specific, industry-average and generic datasets</a><a href=\"#nd\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Why &#x27;not declared&#x27; must not become zero</a><a href=\"#matching\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Matching an EPD to a messy BIM material name</a><a href=\"#top\" class=\"block pt-3 border-t border-slate-100 font-bold text-slate-400 hover:text-slate-700\">Back to top</a></nav></div></aside></div></main><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-5 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center sm:justify-start\" href=\"/\"><svg class=\"mr-2 h-7 w-7 shrink-0 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\"></path></svg><span class=\"font-black tracking-tight text-white\">GreenEngineering Tools</span></a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Browser-based tools and practical guides for embodied carbon, EPD data, BIM material workflows and whole-building life-cycle assessment.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/#calculator-workspace\">Open LCA calculator →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/actual-data\">Actual / Complex Goods</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/electricity\">CBAM Electricity</a><a class=\"block hover:text-white\" href=\"/cbam-calculator/bulk\">Official Bulk CSV</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Learn</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">More Guides</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer additional guides\"><a class=\"block hover:text-white\" href=\"/bim-embodied-carbon\">BIM Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/whole-building-lca\">Whole-Building LCA</a><a class=\"block hover:text-white\" href=\"/module-d-lca\">Module D Explained</a><a class=\"block hover:text-white\" href=\"/leed-whole-building-lca\">LEED Whole-Building LCA</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Company</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer company navigation\"><a class=\"block hover:text-white\" href=\"/about\">About Us</a><a class=\"block hover:text-white\" href=\"/contact\">Contact</a><a class=\"block hover:text-white\" href=\"/privacy-policy\">Privacy Policy</a><a class=\"block hover:text-white\" href=\"/terms-of-service\">Terms of Service</a></nav></div></div><div class=\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\"><p class=\"text-center text-xs text-slate-500 md:text-left\">© <!-- -->2026<!-- --> Green Engineering Tools. All rights reserved.</p><p class=\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\">Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.</p></div></di