compliance remain subject to project-specific requirements and independent review.\"}]]}]\nb:true\n9:300\n9:C\na:0\n8:\"$undefined\"\n","/epd-carbon-calculator/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"\"]\nf:X\n14:X\n14:C\n0:{\"buildId\":\"y5EDMyt0U2R5fp9RtINoD\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-slate-50\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"TechArticle\\\",\\\"headline\\\":\\\"EPD Carbon Calculator: How to Use EPD Data\\\",\\\"description\\\":\\\"Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.\\\",\\\"dateModified\\\":\\\"2026-08-31\\\",\\\"mainEntityOfPage\\\":\\\"https://greenengineeringtools.com/epd-carbon-calculator\\\",\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Green Engineering Tools\\\",\\\"url\\\":\\\"https://greenengineeringtools.com\\\"},\\\"about\\\":[\\\"Life cycle assessment\\\",\\\"Embodied carbon\\\",\\\"Environmental Product Declarations\\\",\\\"Building materials\\\"]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://greenengineeringtools.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Guides\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/guides\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"EPD Carbon Calculator: How to Use EPD Data\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/epd-carbon-calculator\\\"}]}\"}}],[\"$\",\"section\",null,{\"className\":\"bg-slate-950 text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"text-sm text-slate-400 mb-7\",\"aria-label\":\"Breadcrumb\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"mx-2\",\"children\":\"/\"}],[\"$\",\"$L2\",null,{\"href\":\"/guides\",\"className\":\"hover:text-white\",\"children\":\"Guides\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\",\"children\":\"Environmental Product Declarations\"}],[\"$\",\"h1\",null,{\"className\":\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\",\"children\":\"EPD Carbon Calculator: How to Use EPD Data\"}],[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\",\"children\":\"Use EPD data correctly for embodied carbon calculations. Understand declared units, GWP, lifecycle modules, product-specific data and missing results.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/#calculator-workspace\",\"className\":\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\",\"children\":\"Open the LCA calculator\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\",\"children\":\"Read methodology\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-6 text-xs text-slate-500\",\"children\":[\"Last reviewed: \",\"2026-08-31\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\",\"children\":[[\"$\",\"article\",null,{\"className\":\"min-w-0\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"space-y-14\",\"children\":[[\"$\",\"section\",\"what\",{\"id\":\"what\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What an Environmental Product Declaration tells you\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"An Environmental Product Declaration is a standardized disclosure of environmental information for a product or product group. For carbon calculations, users often focus on global warming potential, but a useful EPD also identifies the declared unit, lifecycle modules, product description, geography, program operator, PCR and validity information.\"}],\"$L3\"],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\"]}],\"$L9\",\"$La\",\"$Lb\"]}],\"$Lc\"]}]]}],null,\"$Ld\"]}],\"isPartial\":\"$@e\",\"staleTime\":\"$f\",\"varyParams\":null},{\"rsc\":\"$L10\",\"isPartial\":\"$@11\",\"staleTime\":\"$f\",\"varyParams\":null},{\"rsc\":\"$L12\",\"isPartial\":\"$@13\",\"staleTime\":\"$f\",\"varyParams\":\"$14\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@15\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@16\"}\n17:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"OutletBoundary\"]\n18:\"$Sreact.suspense\"\n1a:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"ViewportBoundary\"]\n1b:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"MetadataBoundary\"]\n1c:I[27201,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"IconMark\"]\n1d:I[39756,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"default\"]\n1e:I[37457,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"default\"]\n3:[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"An EPD is not simply a carbon score. It is a structured dataset with a defined scope. The calculator preserves those fields because the context determines whether a number can be used correctly.\"}]\n4:[\"$\",\"section\",\"read\",{\"id\":\"read\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Fields to check before using an EPD in a calculator\"}],\"$undefined\",\"$undefined\",\"$undefined\",[\"$\",\"div\",null,{\"className\":\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full min-w-[640px] text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-slate-900 text-white\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"EPD field\",{\"className\":\"p-3 text-left font-black\",\"children\":\"EPD field\"}],[\"$\",\"th\",\"Why it matters\",{\"className\":\"p-3 text-left font-black\",\"children\":\"Why it matters\"}],[\"$\",\"th\",\"What to verify\",{\"className\":\"p-3 text-left font-black\",\"children\":\"What to verify\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-slate-200\",\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Product / manufacturer\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Defines what the dataset represents\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Make sure it matches the material or acceptable proxy.\"}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Declared unit and quantity\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Defines the basis of every reported impact\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Align project quantity before multiplying.\"}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Lifecycle modules\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Shows which stages are declared\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Do not treat non-declared modules as zero.\"}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"PCR\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Sets product-category calculation rules\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Be cautious when comparing products under materially different rules.\"}]]}],[\"$\",\"tr\",\"4\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Geography / plant\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Can affect energy and supply-chain relevance\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Prefer data appropriate to the project decision where possible.\"}]]}],[\"$\",\"tr\",\"5\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Validity date\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Shows whether the declaration remains current\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Check the original EPD before formal reporting.\"}]]}],[\"$\",\"tr\",\"6\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Environmental indicators\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Defines GWP and other impact results\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Use the exact indicator and unit required by the study.\"}]]}]]}]]}]}],\"$undefined\"]}]\n5:[\"$\",\"section\",\"calculation\",{\"id\":\"calculation\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How an EPD carbon calculator uses the data\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The calculator first converts the project quantity to the EPD declared basis. It then applies the impact result for each declared lifecycle module. For example, A1-A3 GWP is multiplied by the normalized quantity for manufacturing impact, while C-stage results are kept in their own lifecycle modules.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A dataset that declares only A1-A3 should not suddenly acquire A4, A5 or C-stage impacts from a generic default. If a project wants to add A4 transportation, it can use a documented transport scenario based on mass, mode and distance.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n6:[\"$\",\"section\",\"types\",{\"id\":\"types\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Product-specific, industry-average and generic datasets\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Product-specific EPDs can support procurement decisions because they describe a manufacturer or product more directly. Industry-average EPDs aggregate a broader set of producers. Generic LCA datasets can be useful when no suitable EPD exists or when the project is still at concept stage.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The right choice depends on the question. Early design often values coverage and consistency; procurement values specificity. A transparent system should label the data source rather than presenting every number as equally specific.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n7:[\"$\",\"section\",\"nd\",{\"id\":\"nd\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Why 'not declared' must not become zero\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Some EPDs deliberately do not declare project-specific modules such as A4 or use-stage modules. That absence means there is no reported result for the module in that EPD; it does not prove that the impact is physically zero.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The calculation engine preserves missing values as unavailable. This prevents an incomplete EPD from appearing artificially better than a more complete EPD simply because omitted modules were converted to zero.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-black text-amber-950\",\"children\":\"A complete-looking spreadsheet can still be incomplete\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-amber-900\",\"children\":\"If missing modules are filled with zeros, totals become easy to calculate but harder to trust. Preserve data gaps and document how they are resolved.\"}]]}]]}]\n8:[\"$\",\"section\",\"matching\",{\"id\":\"matching\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Matching an EPD to a messy BIM material name\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"BIM schedules frequently contain abbreviations, family names, type names or user-entered spelling differences. A material called 'Conc CIP 4ksi' may need to be searched as 'ready mix concrete' or another simplified term to find a relevant EPD.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The tool therefore keeps the original BIM alias separate from the editable EC3 search term. The engineer can correct the search without changing the project record, and an approved mapping can be reused for future imports when permitted by the data source and backend configuration.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n9:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-slate-200 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-3\",\"children\":[[\"$\",\"details\",\"What is an EPD carbon calculator?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What is an EPD carbon calculator?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"It is a calculator that uses environmental results reported in an Environmental Product Declaration together with project quantities to estimate impacts for the declared lifecycle modules.\"}]]}],[\"$\",\"details\",\"Which EPD number is used for embodied carbon?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Which EPD number is used for embodied carbon?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Global warming potential, reported in kg CO₂e or an equivalent unit, is the primary carbon indicator. The correct lifecycle module and declared unit must also be identified.\"}]]}],[\"$\",\"details\",\"Does every EPD include A1-D?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does every EPD include A1-D?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"No. EPDs can declare different module sets depending on the product category rules and declaration scope. Missing or non-declared modules should not automatically be treated as zero.\"}]]}],[\"$\",\"details\",\"Can an industry-average EPD be used when a product-specific EPD is unavailable?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Can an industry-average EPD be used when a product-specific EPD is unavailable?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"It may be appropriate for some study stages, but the choice should be documented. Formal requirements may prefer or require particular data types.\"}]]}]]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-black text-slate-950\",\"children\":\"Authoritative references\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-6 text-slate-600\",\"children\":\"These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.buildingtransparency.org/tools/ec3/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.buildingtransparency.org/tools/ec3/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency — EC3 tool\"}]}],[\"$\",\"li\",\"https://docs.buildingtransparency.org/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://docs.buildingtransparency.org/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency documentation — EC3 and tallyLCA scope\"}]}]]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mt-14\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-slate-950\",\"children\":\"Continue learning\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 grid sm:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L2\",\"/a1-a3-embodied-carbon\",{\"href\":\"/a1-a3-embodied-carbon\",\"className\":\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-black 