}]\\nc:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1f\\\",null,{\\\"children\\\":\\\"$L20\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L21\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$22\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L23\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\ne:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/23xh-7wmp-5d8.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n24:I[97367,[\\\"/_next/static/chunks/1icgbrcdew2yz.js\\\"],\\\"OutletBoundary\\\"]\\nb:C\\nf:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"About Us\\\"}]\\n10:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/contact\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Contact\\\"}]\\n11:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/privacy-policy\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Privacy Policy\\\"}]\\n12:[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/terms-of-service\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Terms of Service\\\"}]\\n13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-center text-xs text-slate-500 md:text-left\\\",\\\"children\\\":[\\\"© \\\",2026,\\\" Green Engineering Tools. All rights reserved.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\\\",\\\"children\\\":\\\"Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.\\\"}]]}]\\n14:[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"An EPD is not simply a carbon score. It is a structured dataset with a defined scope. The calculator preserves those fields because the context determines whether a number can be used correctly.\\\"}]\\n15:[\\\"$\\\",\\\"section\\\",\\\"read\\\",{\\\"id\\\":\\\"read\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Fields to check before using an EPD in a calculator\\\"}],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"w-full min-w-[640px] text-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"className\\\":\\\"bg-slate-900 text-white\\\",\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"EPD field\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"EPD field\\\"}],[\\\"$\\\",\\\"th\\\",\\\"Why it matters\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"Why it matters\\\"}],[\\\"$\\\",\\\"th\\\",\\\"What to verify\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"What to verify\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"className\\\":\\\"divide-y divide-slate-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Product / manufacturer\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Defines what the dataset represents\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Make sure it matches the material or acceptable proxy.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Declared unit and quantity\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Defines the basis of every reported impact\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Align project quantity before multiplying.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Lifecycle modules\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Shows which stages are declared\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Do not treat non-declared modules as zero.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"PCR\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Sets product-category calculation rules\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Be cautious when comparing products under materially different rules.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"4\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Geography / plant\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Can affect energy and supply-chain relevance\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Prefer data appropriate to the project decision where possible.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"5\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Validity date\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Shows whether the declaration remains current\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Check the original EPD before formal reporting.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"6\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Environmental indicators\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Defines GWP and other impact results\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Use the exact indicator and unit required by the study.\\\"}]]}]]}]]}]}],\\\"$undefined\\\"]}]\\n16:[\\\"$\\\",\\\"section\\\",\\\"calculation\\\",{\\\"id\\\":\\\"calculation\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"How an EPD carbon calculator uses the data\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The calculator first converts the project quantity to the EPD declared basis. It then applies the impact result for each declared lifecycle module. For example, A1-A3 GWP is multiplied by the normalized quantity for manufacturing impact, while C-stage results are kept in their own lifecycle modules.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A dataset that declares only A1-A3 should not suddenly acquire A4, A5 or C-stage impacts from a generic default. If a project wants to add A4 transportation, it can use a documented transport scenario based on mass, mode and distance.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n17:[\\\"$\\\",\\\"section\\\",\\\"types\\\",{\\\"id\\\":\\\"types\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Product-specific, industry-average and generic datasets\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Product-specific EPDs can support procurement decisions because they describe a manufacturer or product more directly. Industry-average EPDs aggregate a broader set of producers. Generic LCA datasets can be useful when no suitable EPD exists or when the project is still at concept stage.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The right choice depends on the question. Early design often values coverage and consistency; procurement values specificity. A transparent system should label the data source rather than presenting every number as equally specific.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n18:[\\\"$\\\",\\\"section\\\",\\\"nd\\\",{\\\"id\\\":\\\"nd\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Why 'not declared' must not become zero\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Some EPDs deliberately do not declare project-specific modules such as A4 or use-stage modules. That absence means there is no reported result for the module in that EPD; it does not prove that the impact is physically zero.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The calculation engine preserves missing values as unavailable. This prevents an incomplete EPD from appearing artificially better than a more complete EPD simply because omitted modules were converted to zero.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-amber-950\\\",\\\"children\\\":\\\"A complete-looking spreadsheet can still be incomplete\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-amber-900\\\",\\\"children\\\":\\\"If missing modules are filled with zeros, totals become easy to calculate but harder to trust. Preserve data gaps and document how they are resolved.\\\"}]]}]]}]\\n19:[\\\"$\\\",\\\"section\\\",\\\"matching\\\",{\\\"id\\\":\\\"matching\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Matching an EPD to a messy BIM material name\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"BIM schedules frequently contain abbreviations, family names, type names or user-entered spelling differences. A material called 'Conc CIP 4ksi' may need to be searched as 'ready mix concrete' or another simplified term to find a relevant EPD.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The tool therefore keeps the original BIM alias separate from the editable EC3 search term. The engineer c\"])</script><script>self.__next_f.push([1,\"an correct the search without changing the project record, and an approved mapping can be reused for future imports when permitted by the data source and backend configuration.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n1a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-slate-200 pt-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black text-slate-950\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"What is an EPD carbon calculator?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"What is an EPD carbon calculator?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"It is a calculator that uses environmental results reported in an Environmental Product Declaration together with project quantities to estimate impacts for the declared lifecycle modules.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Which EPD number is used for embodied carbon?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Which EPD number is used for embodied carbon?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"Global warming potential, reported in kg CO₂e or an equivalent unit, is the primary carbon indicator. The correct lifecycle module and declared unit must also be identified.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Does every EPD include A1-D?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Does every EPD include A1-D?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"No. EPDs can declare different module sets depending on the product category rules and declaration scope. Missing or non-declared modules should not automatically be treated as zero.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Can an industry-average EPD be used when a product-specific EPD is unavailable?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\