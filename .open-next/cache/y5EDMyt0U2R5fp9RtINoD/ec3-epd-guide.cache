lication/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"TechArticle\\\",\\\"headline\\\":\\\"EC3 EPD Guide: Search, Match & Use Material Data\\\",\\\"description\\\":\\\"Learn how to search EC3 EPD data, fix BIM material names, review declared units and connect product-level embodied carbon data to a whole-building LCA workflow.\\\",\\\"dateModified\\\":\\\"2026-08-31\\\",\\\"mainEntityOfPage\\\":\\\"https://greenengineeringtools.com/ec3-epd-guide\\\",\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Green Engineering Tools\\\",\\\"url\\\":\\\"https://greenengineeringtools.com\\\"},\\\"about\\\":[\\\"Life cycle assessment\\\",\\\"Embodied carbon\\\",\\\"Environmental Product Declarations\\\",\\\"Building materials\\\"]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://greenengineeringtools.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Guides\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/guides\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"EC3 EPD Guide: Search, Match & Use Material Data\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/ec3-epd-guide\\\"}]}\"}}],[\"$\",\"section\",null,{\"className\":\"bg-slate-950 text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"text-sm text-slate-400 mb-7\",\"aria-label\":\"Breadcrumb\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"mx-2\",\"children\":\"/\"}],[\"$\",\"$L2\",null,{\"href\":\"/guides\",\"className\":\"hover:text-white\",\"children\":\"Guides\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\",\"children\":\"EC3 material and EPD workflow\"}],[\"$\",\"h1\",null,{\"className\":\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\",\"children\":\"EC3 EPD Guide: Search, Match & Use Material Data\"}],[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\",\"children\":\"Learn how to search EC3 EPD data, fix BIM material names, review declared units and connect product-level embodied carbon data to a whole-building LCA workflow.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/#calculator-workspace\",\"className\":\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\",\"children\":\"Open the LCA calculator\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\",\"children\":\"Read methodology\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-6 text-xs text-slate-500\",\"children\":[\"Last reviewed: \",\"2026-08-31\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\",\"children\":[[\"$\",\"article\",null,{\"className\":\"min-w-0\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"space-y-14\",\"children\":[[\"$\",\"section\",\"what\",{\"id\":\"what\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What EC3 is and where it fits in an LCA workflow\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3, the Embodied Carbon in Construction Calculator from Building Transparency, is a free construction-specific material search and planning tool backed by a large database of digital third-party EPDs. Building Transparency describes EC3 as a tool for finding and comparing materials, planning embodied-carbon reductions and supporting procurement.\"}],\"$L3\"],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\"]}],\"$L9\",\"$La\",\"$Lb\"]}],\"$Lc\"]}]]}],null,\"$Ld\"]}],\"isPartial\":\"$@e\",\"staleTime\":\"$f\",\"varyParams\":null},{\"rsc\":\"$L10\",\"isPartial\":\"$@11\",\"staleTime\":\"$f\",\"varyParams\":null},{\"rsc\":\"$L12\",\"isPartial\":\"$@13\",\"staleTime\":\"$f\",\"varyParams\":\"$14\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@15\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@16\"}\n17:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"OutletBoundary\"]\n18:\"$Sreact.suspense\"\n1a:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"ViewportBoundary\"]\n1b:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"MetadataBoundary\"]\n1c:I[27201,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"IconMark\"]\n1d:I[39756,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"default\"]\n1e:I[37457,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"default\"]\n3:[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3 and whole-building LCA are related but not identical. Building Transparency's own documentation distinguishes upfront carbon assessment from whole-life impact assessment. A whole-building LCA may include future replacement, use-stage and end-of-life effects in addition to product-stage carbon.\"}]\n4:[\"$\",\"section\",\"search\",{\"id\":\"search\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How to search EC3 when the BIM name is wrong or too specific\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A model name such as 'Concrete (Cast-in-Place) - 4000psi - Level 2' may not match the wording used by an EPD record. Instead of forcing users to edit the source schedule, the calculator gives the EC3 search term its own editable field.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Start with the most meaningful product description, then simplify if results are poor. Remove level names, internal family codes and irrelevant punctuation. Keep performance information such as concrete strength or steel grade when it helps distinguish functionally different products.\"}]],\"$undefined\",[\"$\",\"ol\",null,{\"className\":\"mt-5 space-y-3 list-decimal pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Keep the original BIM/CSV alias unchanged.\",{\"children\":\"Keep the original BIM/CSV alias unchanged.\"}],[\"$\",\"li\",\"Search using the original name first.\",{\"children\":\"Search using the original name first.\"}],[\"$\",\"li\",\"If results are poor, edit only the EC3 search term.\",{\"children\":\"If results are poor, edit only the EC3 search term.\"}],[\"$\",\"li\",\"Select the EPD that best matches product type, specification, geography and declared unit.\",{\"children\":\"Select the EPD that best matches product type, specification, geography and declared unit.\"}],[\"$\",\"li\",\"Preserve the approved alias-to-EPD mapping for future imports only when your EC3 access terms allow storage.\",{\"children\":\"Preserve the approved alias-to-EPD mapping for future imports only when your EC3 access terms allow storage.\"}]]}],\"$undefined\",\"$undefined\"]}]\n5:[\"$\",\"section\",\"fields\",{\"id\":\"fields\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What to review before selecting an EC3 EPD\"}],\"$undefined\",[\"$\",\"ul\",null,{\"className\":\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Product name and manufacturer.\",{\"children\":\"Product name and manufacturer.\"}],[\"$\",\"li\",\"Product category and performance attributes.\",{\"children\":\"Product category and performance attributes.\"}],[\"$\",\"li\",\"Declared quantity and unit.\",{\"children\":\"Declared quantity and unit.\"}],[\"$\",\"li\",\"A1-A3 GWP and any other declared lifecycle modules.\",{\"children\":\"A1-A3 GWP and any other declared lifecycle modules.\"}],[\"$\",\"li\",\"Plant or geographic relevance where available.\",{\"children\":\"Plant or geographic relevance where available.\"}],[\"$\",\"li\",\"EPD validity and program information.\",{\"children\":\"EPD validity and program information.\"}],[\"$\",\"li\",\"Whether the candidate represents a product-specific EPD, industry average or another data type.\",{\"children\":\"Whether the candidate represents a product-specific EPD, industry average or another data type.\"}]]}],\"$undefined\",\"$undefined\",\"$undefined\"]}]\n6:[\"$\",\"section\",\"integration\",{\"id\":\"integration\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How the Green Engineering Tools EC3 reconciliation works\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The frontend first checks its local and shared material mappings. If the material is unresolved, the user can search the EC3-connected backend. The selected result is normalized into the LCA data structure while missing modules remain missing.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"When the returned result contains a usable openEPD identifier, the backend can request the detailed digital EPD record before calculation. This prevents the application from reducing an EPD to only a name and one GWP number when richer data is available.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n7:[\"$\",\"section\",\"permissions\",{\"id\":\"permissions\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"API access and data-storage permissions matter\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"An API connection does not automatically grant unlimited rights to cache or redistribute the provider's data. Production SaaS applications should follow the current Building Transparency API terms and the permissions attached to their access level.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"For that reason, the backend uses an explicit EC3 persistence flag. The calculator can use a selected record for the current analysis while persistent shared storage remains disabled until the application's EC3 agreement permits caching or reuse.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-black text-amber-950\",\"children\":\"Technical capability and data rights are separate questions\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-amber-900\",\"children\":\"A database can technically store an EPD response, but a production SaaS should only enable that behavior when its data-access agreement permits it.\"}]]}]]}]\n8:[\"$\",\"section\",\"ec3-vs-lca\",{\"id\":\"ec3-vs-lca\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"EC3 material comparison versus whole-building LCA\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3 is particularly strong for material specification and procurement because EPD data can reveal differences between products that meet similar performance needs. A whole-building LCA adds a system-level view: how much material is used, how long products last, what is replaced, what happens at end of life and how design alternatives compare.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Using EC3 as a material-data workflow inside a broader LCA engine can connect procurement detail to the building-level decision without pretending that an EPD search alone is a complete whole-life assessment.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n9:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-slate-200 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-3\",\"children\":[[\"$\",\"details\",\"Is EC3 a free embodied carbon database?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is EC3 a free embodied carbon database?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Building Transparency describes EC3 as a free, open-access construction embodied-carbon tool with a large digital EPD database. API integration and production data rights can have separate terms.\"}]]}],[\"$\",\"details\",\"Why can't I find my exact Revit material name in EC3?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Why can't I find my exact Revit material name in EC3?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"BIM names often contain internal naming conventions that do not match EPD product names. Simplify or correct the search term while preserving the original model alias.\"}]]}],[\"$\",\"details\",\"Does selecting an EC3 EPD automatically make the whole-building LCA correct?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does selecting an EC3 EPD automatically make the whole-building LCA correct?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"No. The EPD still has to match the material and declared unit, and the project must define quantities, lifecycle scope, transport, service life and other assumptions.\"}]]}],[\"$\",\"details\",\"Can the SaaS remember an approved EC3 match for the next user?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Can the SaaS remember an approved EC3 match for the next user?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Technically yes through a shared alias mapping, but persistent EC3 storage should only be enabled when your Building Transparency access agreement permits caching or reuse.\"}]]}]]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-black text-slate-950\",\"children\":\"Authoritative references\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-6 text-slate-600\",\"children\":\"These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.buildingtransparency.org/tools/ec3/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.buildingtransparency.org/tools/ec3/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency — EC3 tool\"}]}],[\"$\",\"li\",\"https://docs.buildingtransparency.org/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://docs.buildingtransparency.org/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency documentation — EC3 and tallyLCA scope\"}]}],[\"$\",\"li\",\"https://docs.buildingtransparency.org/ec3/main-features/find-and-compare-materials\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://docs.buildingtransparency.org/ec3/main-features/find-and-compare-materials\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-bold text-blue-700 hover:underline\",\"children\":\"Building Transparency — Find & Compare Materials\"}]}]]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mt-14\",\"children\":[[\"$\"