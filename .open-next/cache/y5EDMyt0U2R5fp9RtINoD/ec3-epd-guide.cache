nter rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\",\"children\":\"Read methodology\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-6 text-xs text-slate-500\",\"children\":[\"Last reviewed: \",\"2026-08-31\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\",\"children\":[[\"$\",\"article\",null,{\"className\":\"min-w-0\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"space-y-14\",\"children\":[[\"$\",\"section\",\"what\",{\"id\":\"what\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What EC3 is and where it fits in an LCA workflow\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3, the Embodied Carbon in Construction Calculator from Building Transparency, is a free construction-specific material search and planning tool backed by a large database of digital third-party EPDs. Building Transparency describes EC3 as a tool for finding and comparing materials, planning embodied-carbon reductions and supporting procurement.\"}],\"$L14\"],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}],\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\"]}],\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\"]}]]}],null,\"$L1e\"]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1f\",null,{\"children\":\"$L20\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$22\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L23\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\ne:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/23xh-7wmp-5d8.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n24:I[97367,[\"/_next/static/chunks/1icgbrcdew2yz.js\"],\"OutletBoundary\"]\nb:C\nf:[\"$\",\"$L2\",null,{\"href\":\"/about\",\"className\":\"block hover:text-white\",\"children\":\"About Us\"}]\n10:[\"$\",\"$L2\",null,{\"href\":\"/contact\",\"className\":\"block hover:text-white\",\"children\":\"Contact\"}]\n11:[\"$\",\"$L2\",null,{\"href\":\"/privacy-policy\",\"className\":\"block hover:text-white\",\"children\":\"Privacy Policy\"}]\n12:[\"$\",\"$L2\",null,{\"href\":\"/terms-of-service\",\"className\":\"block hover:text-white\",\"children\":\"Terms of Service\"}]\n13:[\"$\",\"div\",null,{\"className\":\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-center text-xs text-slate-500 md:text-left\",\"children\":[\"© \",2026,\" Green Engineering Tools. All rights reserved.\"]}],[\"$\",\"p\",null,{\"className\":\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\",\"children\":\"Engineering decision-support tools for EN 15804-aligned lifecycle analysis and LEED whole-building LCA workflows. Formal certification and compliance remain subject to project-specific requirements and independent review.\"}]]}]\n14:[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3 and whole-building LCA are related but not identical. Building Transparency's own documentation distinguishes upfront carbon assessment from whole-life impact assessment. A whole-building LCA may include future replacement, use-stage and end-of-life effects in addition to product-stage carbon.\"}]\n15:[\"$\",\"section\",\"search\",{\"id\":\"search\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How to search EC3 when the BIM name is wrong or too specific\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A model name such as 'Concrete (Cast-in-Place) - 4000psi - Level 2' may not match the wording used by an EPD record. Instead of forcing users to edit the source schedule, the calculator gives the EC3 search term its own editable field.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Start with the most meaningful product description, then simplify if results are poor. Remove level names, internal family codes and irrelevant punctuation. Keep performance information such as concrete strength or steel grade when it helps distinguish functionally different products.\"}]],\"$undefined\",[\"$\",\"ol\",null,{\"className\":\"mt-5 space-y-3 list-decimal pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Keep the original BIM/CSV alias unchanged.\",{\"children\":\"Keep the original BIM/CSV alias unchanged.\"}],[\"$\",\"li\",\"Search using the original name first.\",{\"children\":\"Search using the original name first.\"}],[\"$\",\"li\",\"If results are poor, edit only the EC3 search term.\",{\"children\":\"If results are poor, edit only the EC3 search term.\"}],[\"$\",\"li\",\"Select the EPD that best matches product type, specification, geography and declared unit.\",{\"children\":\"Select the EPD that best matches product type, specification, geography and declared unit.\"}],[\"$\",\"li\",\"Preserve the approved alias-to-EPD mapping for future imports only when your EC3 access terms allow storage.\",{\"children\":\"Preserve the approved alias-to-EPD mapping for future imports only when your EC3 access terms allow storage.\"}]]}],\"$undefined\",\"$undefined\"]}]\n16:[\"$\",\"section\",\"fields\",{\"id\":\"fields\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What to review before selecting an EC3 EPD\"}],\"$undefined\",[\"$\",\"ul\",null,{\"className\":\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Product name and manufacturer.\",{\"children\":\"Product name and manufacturer.\"}],[\"$\",\"li\",\"Product category and performance attributes.\",{\"children\":\"Product category and performance attributes.\"}],[\"$\",\"li\",\"Declared quantity and unit.\",{\"children\":\"Declared quantity and unit.\"}],[\"$\",\"li\",\"A1-A3 GWP and any other declared lifecycle modules.\",{\"children\":\"A1-A3 GWP and any other declared lifecycle modules.\"}],[\"$\",\"li\",\"Plant or geographic relevance where available.\",{\"children\":\"Plant or geographic relevance where available.\"}],[\"$\",\"li\",\"EPD validity and program information.\",{\"children\":\"EPD validity and program information.\"}],[\"$\",\"li\",\"Whether the candidate represents a product-specific EPD, industry average or another data type.\",{\"children\":\"Whether the candidate represents a product-specific EPD, industry average or another data type.\"}]]}],\"$undefined\",\"$undefined\",\"$undefined\"]}]\n17:[\"$\",\"section\",\"integration\",{\"id\":\"integration\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How the Green Engineering Tools EC3 reconciliation works\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The frontend first checks its local and shared material mappings. If the material is unresolved, the user can search the EC3-connected backend. The selected result is normalized into the LCA data structure while missing modules remain missing.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"When the returned result contains a usable openEPD identifier, the backend can request the detailed digital EPD record before calculation. This prevents the application from reducing an EPD to only a name and one GWP number when richer data is available.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n18:[\"$\",\"section\",\"permissions\",{\"id\":\"permissions\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"API access and data-storage permissions matter\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"An API connection does not automatically grant unlimited rights to cache or redistribute the provider's data. Production SaaS applications should follow the current Building Transparency API terms and the permissions attached to their access level.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"For that reason, the backend uses an explicit EC3 persistence flag. The calculator can use a selected record for the current analysis while persistent shared storage remains disabled until the application's EC3 agreement permits caching or reuse.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-black text-amber-950\",\"children\":\"Technical capability and data rights are separate questions\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 leading-7 text-amber-900\",\"children\":\"A database can technically store an EPD response, but a production SaaS should only enable that behavior when its data-access agreement permits it.\"}]]}]]}]\n19:[\"$\",\"section\",\"ec3-vs-lca\",{\"id\":\"ec3-vs-lca\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"EC3 material comparison versus whole-building LCA\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"EC3 is particularly strong for material specification and procurement because EPD data can reveal differences between products that meet similar performance needs. A whole-building LCA adds a system-level view: how much material is used, how long products last, what is replaced, what happens at end of life and how design alternatives compare.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Using EC3 as a material-data workflow inside a broader LCA engine can connect procurement detail to the building-level decision without pretending that an EPD search alone is a complete whole-life assessment.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n1a:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-slate-200 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-3\",\"children\":[[\"$\",\"details\",\"Is EC3 a free embodied carbon database?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is EC3 a free embodied carbon database?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Building Transparency describes EC3 as a free, open-access construction embodied-carbon tool with a large digital EPD database. API integration and production data rights can have separate terms.\"}]]}],[\"$\",\"details\",\"Why can't I find my exact Revit material name in EC3?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Why can't I find my exact Revit material name in EC3?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"BIM names often contain internal naming conventions that do not match EPD product names. Simplify or correct the search term while preserving the original model alias.\"}]]}],[\"$\",\"details\",\"Does selecting an EC3 EPD automatically make the whole-building LCA correct?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does selecting an EC3 EPD automatically make the whole-building LCA correct?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"No. The EPD still has to match the material and declared unit, and the project must define quantities, lifecycle scope, transport, service life and other assumptions.\"}]]}],[\"$\",\"details\",\"Can the SaaS remember an approved EC3 match for the next user?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Can the SaaS remember an approved EC3 match for the next user?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Technically yes t