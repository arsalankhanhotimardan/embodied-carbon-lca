on\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"TechArticle\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Building LCA Methodology: Embodied Carbon A1-D\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"A transparent building LCA methodology for quantities, EPD units, A1-A3, A4, B4 replacements, C1-C4, Module D, baseline comparison and data quality.\\\\\\\",\\\\\\\"dateModified\\\\\\\":\\\\\\\"2026-08-31\\\\\\\",\\\\\\\"mainEntityOfPage\\\\\\\":\\\\\\\"https://greenengineeringtools.com/methodology\\\\\\\",\\\\\\\"publisher\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Green Engineering Tools\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://greenengineeringtools.com\\\\\\\"},\\\\\\\"about\\\\\\\":[\\\\\\\"Life cycle assessment\\\\\\\",\\\\\\\"Embodied carbon\\\\\\\",\\\\\\\"Environmental Product Declarations\\\\\\\",\\\\\\\"Building materials\\\\\\\"]}\\\"}}],[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":1,\\\\\\\"name\\\\\\\":\\\\\\\"Home\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://greenengineeringtools.com\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":2,\\\\\\\"name\\\\\\\":\\\\\\\"Guides\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://greenengineeringtools.com/guides\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":3,\\\\\\\"name\\\\\\\":\\\\\\\"Building LCA Methodology: Embodied Carbon A1-D\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://greenengineeringtools.com/methodology\\\\\\\"}]}\\\"}}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"bg-slate-950 text-white\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\\\",\\\"children\\\":[[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"text-sm text-slate-400 mb-7\\\",\\\"aria-label\\\":\\\"Breadcrumb\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Home\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"mx-2\\\",\\\"children\\\":\\\"/\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/guides\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Guides\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\\\",\\\"children\\\":\\\"Calculation methodology\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\\\",\\\"children\\\":\\\"Building LCA Methodology: Embodied Carbon A1-D\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\\\",\\\"children\\\":\\\"A transparent building LCA methodology for quantities, EPD units, A1-A3, A4, B4 replacements, C1-C4, Module D, baseline comparison and data quality.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/#calculator-workspace\\\",\\\"className\\\":\\\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\\\",\\\"children\\\":\\\"Open the LCA calculator\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/methodology\\\",\\\"className\\\":\\\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\\\",\\\"children\\\":\\\"Read methodology\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-6 text-xs text-slate-500\\\",\\\"children\\\":[\\\"Last reviewed: \\\",\\\"2026-08-31\\\"]}]]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"min-w-0\\\",\\\"children\\\":[\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-14\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",\\\"purpose\\\",{\\\"id\\\":\\\"purpose\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"What this LCA methodology is designed to do\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The Green Engineering Tools calculation methodology is designed to turn project material quantities into transparent lifecycle results without hiding the assumptions that materially affect the answer. A quantity is only useful when it is tied to a unit, a material or EPD dataset, a declared quantity, a lifecycle boundary and a study period. The engine therefore treats material resolution and unit compatibility as part of the calculation rather than as an administrative step.\\\"}],\\\"$L11\\\"],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}],\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\"]}],\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\"]}],\\\"$L1d\\\"]}]]}],null,\\\"$L1e\\\"]}]\\nc:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1f\\\",null,{\\\"children\\\":\\\"$L20\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L21\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$22\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L23\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\ne:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/2v8tkpdzq5d58.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n25:I[97367,[\\\"/_next/static/chunks/2pq2d3eit8abw.js\\\"],\\\"OutletBoundary\\\"]\\nb:C\\nf:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-center text-xs text-slate-500 md:text-left\\\",\\\"children\\\":[\\\"© \\\",2026,\\\" Green Engineering Tools. All rights reserved.\\\"]}]\\n10:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\\\",\\\"children\\\":\\\"Engineering decision-support tools. Formal compliance, certification and site-specific electrical design remain subject to applicable standards, manufacturer data and qualified professional review.\\\"}]\\n11:[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The methodology is intended for design studies, embodied-carbon screening, EPD-based comparisons, baseline-versus-proposed analysis and structured reporting. It is not a substitute for professional judgment or a certification decision. Formal reports should be reviewed against the standard, rating system and project-specific requirements that apply to the work.\\\"}]\\n12:[\\\"$\\\",\\\"section\\\",\\\"data-hierarchy\\\",{\\\"id\\\":\\\"data-hierarchy\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Data hierarchy: prefer traceable datasets over convenient guesses\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A professional LCA workflow should make the source of each environmental factor visible. Product-specific EPD data can be valuable when the product, geography, declared unit and scope are appropriate. Industry-average or generic datasets can still be useful in early design, but they should be identified as such so users understand the level of specificity behind the result.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The calculator intentionally treats an unmapped material as unresolved. It does not create a default manufacturing value, default end-of-life value or fabricated impact category merely to complete the total. That behavior is important because a visually complete result can be more misleading than an explicit data gap.\\\"}]],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Keep the dataset ID or source reference with the calculated material.\\\",{\\\"children\\\":\\\"Keep the dataset ID or source reference with the calculated material.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Preserve the manufacturer, declared unit, declared quantity and available lifecycle modules.\\\",{\\\"children\\\":\\\"Preserve the manufacturer, declared unit, declared quantity and available lifecycle modules.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Keep missing environmental indicators unavailable rather than changing them to zero.\\\",{\\\"children\\\":\\\"Keep missing environmental indicators unavailable rather than changing them to zero.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Retain the original BIM or CSV material alias even when the engineer searches EC3 using a corrected or simplified name.\\\",{\\\"children\\\":\\\"Retain the original BIM or CSV material alias even when the engineer searches EC3 using a corrected or simplified name.\\\"}]]}],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n13:[\\\"$\\\",\\\"section\\\",\\\"units\\\",{\\\"id\\\":\\\"units\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Quantity normalization and declared units\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Environmental Product Declarations report impacts against a declared or functional quantity. A project schedule may use kilograms, tonnes, cubic metres, square metres, linear metres or pieces. Before multiplying quantity by an EPD factor, the project quantity must be converted to the basis used by the dataset.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Straight conversions such as kilograms to tonnes or square feet to square metres can be handled directly. Cross-dimensional conversions need physical information. Converting mass to volume requires density; converting area to volume requires thickness. When the required conversion data is missing, the safer response is to flag the row instead of inventing a density or thickness.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"14:[\\\"$\\\",\\\"section\\\",\\\"modules\\\",{\\\"id\\\":\\\"modules\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Lifecycle modules A1-D\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"The engine stores lifecycle information by module rather than collapsing the entire building into four generic phases. This keeps the result auditable and makes it possible to distinguish product-stage impacts from transportation, replacement and end-of-life scenarios.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"w-full min-w-[640px] text-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"className\\\":\\\"bg-slate-900 text-white\\\",\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"Module\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"Module\\\"}],[\\\"$\\\",\\\"th\\\",\\\"Typical meaning\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"Typical meaning\\\"}],[\\\"$\\\",\\\"th\\\",\\\"Treatment in the engine\\\",{\\\"className\\\":\\\"p-3 text-left font-black\\\",\\\"children\\\":\\\"Treatment in the engine\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"className\\\":\\\"divide-y divide-slate-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"A1-A3\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Raw material supply, transport associated with production, and manufacturing\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Uses declared product-stage impacts from the selected dataset.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"A4\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Transport from production or supply location to the project site\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Can be calculated from product mass, transport mode and distance when project-specific data is available.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"A5\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Construction and installation\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Kept separate from manufacturing and transport.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"B1-B3\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Use, maintenance and repair\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Included only when the selected methodology and dataset provide applicable values.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"4\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"B4\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Replacement\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Triggered by service-life assumptions during the building study period rather than multiplying the initial A-stage total.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"5\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"B5-B7\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Refurbishment, operational energy and operational water\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Tracked separately; operational energy should not be multiplied across every material row.\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"6\\\",{\\\"className\\\":\\\"align-top\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"C1-C4\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Deconstruction, transport, waste processing and disposal\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"className\\\":\\\"p-3 leading-6 text-slate-700\\\",\\\"children\\\":\\\"Reported as end-of-life impacts when the required scenario or dataset is available.\\\"}]]}],\\\"$L24\\\"]}]]}]}],\\\"$undefined\\\"]}]\\n15:[\\\"$\\\",\\\"section\\\",\\\"transport\\\",{\\\"id\\\":\\\"transport\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"A4 transport calculations\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A4 represents transportation of construction products to the project site. A practical project-specific calculation needs the mass being moved, the travel distance and the transport mode. Building Transparency describes the same core inputs for EC3 A4 calculations: product weight, transportation mode and transportation distance.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"When a project quantity is not expressed by mass, the calculation needs mass per declared unit or another defensible way to determine mass. A transport result should be flagged when mass is unknown rather than assuming that every material unit weighs the same amount.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-amber-950\\\",\\\"children\\\":\\\"Do not confuse A4 with A1-A3\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-amber-900\\\",\\\"children\\\":\\\"A product EPD's manufacturing GWP and project delivery emissions are different lifecycle contributions. Keeping them separate makes design and procurement decisions easier to explain.\\\"}]]}]]}]\\n16:[\\\"$\\\",\\\"section\\\",\\\"replacement\\\",{\\\"id\\\":\\\"replacement\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Replacement and study period logic\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A building study period may be longer than the reference service life of finishes, insulation, membranes or other products. When replacement is required, the replacement event belongs in the use stage, commonly B4. The methodology therefore separates the initial product from later replacement events instead of simply multiplying A1-A5 by a rounded replacement count.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Service-life assumptions can materially change whole-life results. Baseline and proposed comparisons should use consistent study periods, and service lives should be documented so reviewers can reproduce the scenario.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n17:[\\\"$\\\",\\\"section\\\",\\\"end-of-life\\\",{\\\"id\\\":\\\"end-of-life\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"C1-C4 and Module D are not the same thing\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"End-of-life processing still causes impacts even when a material is recyclable. Demolition, transport, sorting, processing and residual disposal should not disappear merely because the recovery percentage reaches 100 percent.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"Module D is a separate accounting of potential benefits or loads beyond the assessed system boundary. The engine therefore keeps Module D outside the A-C result and only reports it when the source dataset or an explicitly documented scenario supports it.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n18:[\\\"$\\\",\\\"section\\\",\\\"comparison\\\",{\\\"id\\\":\\\"comparison\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Baseline and proposed building comparisons\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"A meaningful comparison requires more than two uploaded spreadsheets. The models should represent functionally comparable buildings or options, use the same study period and apply consistent software, datasets and boundaries. Large differences in floor area, building function or omitted systems can overwhelm the effect of a material substitution.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"mt-4 text-[1.02rem] leading-8 text-slate-700\\\",\\\"children\\\":\\\"For certification-oriented work, use the exact equivalence rules of the applicable rating system. The calculator's comparison interface supports design analysis, but certification decisions remain the responsibility of the project team and reviewing authority.\\\"}]],\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\",\\\"$undefined\\\"]}]\\n19:[\\\"$\\\",\\\"section\\\",\\\"quality\\\",{\\\"id\\\":\\\"quality\\\",\\\"className\\\":\\\"scroll-mt-24\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\\\",\\\"children\\\":\\\"Data quality checks before trusting the total\\\"}],\\\"$undefined\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Resolve unmapped materials or quantify how much of the project remains unmapped.\\\",{\\\"children\\\":\\\"Resolve unmapped materials or quantify how much of the project remains unmapped.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Review unit-conversion warnings and verify density or thickness assumptions.\\\",{\\\"children\\\":\\\"Review unit-conversion warnings and verify density or thickness assumptions.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Confirm which lifecycle modules are declared and which are not declared.\\\",{\\\"children\\\":\\\"Confirm which lifecycle modules are declared and which are not declared.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Check service-life assumptions for products that may be replaced.\\\",{\\\"children\\\":\\\"Check service-life assumptions for products that may be replaced.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Confirm A4 transport mode and distance when transportation is material to the result.\\\",{\\\"children\\\":\\\"Confirm A4 transport mode and distance when transportation is material to the result.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Keep Module D separate from the A-C result.\\\",{\\\"children\\\":\\\"Keep Module D separate from the A-C result.\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Export the same calculation core to the dashboard, CSV and PDF so totals do not diverge.\\\",{\\\"children\\\":\\\"Export the same calculation core to the dashboard, CSV and PDF so totals do not diverge.\\\"}]]}],\\\"$undefined\\\",\\\"$undefined\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-amber-950\\\",\\\"children\\\":\\\"ND does not mean zero\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-amber-900\\\",\\\"children\\\":\\\"If an EPD does not declare a module or indicator, treating the missing result as zero can materially understate impact. The calculation should preserve the absence of data.\\\"}]]}]]}]\\n1a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-slate-200 pt-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-black text-slate-950\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"What is an embodied carbon calculation methodology?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"What is an embodied carbon calculation methodology?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"It is the documented set of rules used to convert material quantities and environmental datasets into lifecycle results. A good methodology states the system boundary, units, study period, data sources, transport and replacement assumptions, end-of-life treatment, and how missing data is handled.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Why does the calculator refuse to guess a value for an unknown material?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Why does the calculator refuse to guess a value for an unknown material?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"A default number can make an incomplete model look precise. The tool flags unknown materials so the user can map them to a defensible dataset or explicitly document a proxy.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Is Module D subtracted from the whole-building A-C result?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Is Module D subtracted from the whole-building A-C result?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"No. Module D represents benefits or loads beyond the system boundary and should be reported separately unless a particular reporting framework explicitly instructs otherwise.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"Can the same methodology be used for every certification system?\\\",{\\\"className\\\":\\\"group rounded-xl border border-slate-200 bg-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Can the same methodology be used for every certification system?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-600 group-open:rotate-45 transition-transform\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-slate-700 leading-7\\\",\\\"children\\\":\\\"No. The calculation core can support multiple frameworks, but each rating system may define different scope, equivalence, impact categories, service periods or reporting rules.\\\"}]]}]]}]]}]\\n27:I[27201,[\\\"/_next/static/chunks/2pq2d3eit8abw.js\\\"],\\\"IconMark\\\"]\\n1b:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-black text-slate-950\\\",\\\"children\\\":\\\"Authoritative references\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-sm leading-6 text-slate-600\\\",\\\"children\\\":\\\"These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-4 space-y-2 text-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"https://docs.buildingtransparency.org/\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://docs.buildingtranspa