\\"Learn how to turn a construction material schedule into an auditable carbon result.\\\"}]]}],[\\\"$\\\",\\\"$L2\\\",\\\"/epd-carbon-calculator\\\",{\\\"href\\\":\\\"/epd-carbon-calculator\\\",\\\"className\\\":\\\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-slate-950\\\",\\\"children\\\":\\\"EPD carbon calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-sm leading-6 text-slate-600\\\",\\\"children\\\":\\\"Learn how to read EPD units, GWP values, declared modules and data limitations.\\\"}]]}],[\\\"$\\\",\\\"$L2\\\",\\\"/whole-building-lca\\\",{\\\"href\\\":\\\"/whole-building-lca\\\",\\\"className\\\":\\\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-slate-950\\\",\\\"children\\\":\\\"Whole-building LCA guide\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-sm leading-6 text-slate-600\\\",\\\"children\\\":\\\"Understand scope, service life, baseline comparison and whole-life reporting.\\\"}]]}],[\\\"$\\\",\\\"$L2\\\",\\\"/module-d-lca\\\",{\\\"href\\\":\\\"/module-d-lca\\\",\\\"className\\\":\\\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-black text-slate-950\\\",\\\"children\\\":\\\"Module D explained\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-sm leading-6 text-slate-600\\\",\\\"children\\\":\\\"Understand recycling and reuse benefits beyond the system boundary without double counting.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"aside\\\",null,{\\\"className\\\":\\\"hidden lg:block\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"st