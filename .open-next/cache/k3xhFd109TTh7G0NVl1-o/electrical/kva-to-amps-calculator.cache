s\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/electrical/kva-to-amps-calculator\"/><meta property=\"og:title\" content=\"Green Engineering Tools\"/><meta property=\"og:description\" content=\"Free browser-based engineering calculators for carbon, CBAM, electrical systems and sustainable design.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com\"/><meta property=\"og:site_name\" content=\"Green Engineering Tools\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Free engineering calculators for embodied carbon, CBAM and electrical design.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className flex min-h-screen w-full min-w-0 flex-col overflow-x-hidden bg-slate-50 text-slate-900\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm\"><nav aria-label=\"Main navigation\"><div class=\"mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8\"><div class=\"flex h-16 min-w-0 items-center justify-between gap-2 sm:h-20 sm:gap-4\"><a aria-label=\"Green Engineering Tools home\" class=\"flex min-w-0 max-w-[calc(100%-3.25rem)] items-center sm:max-w-none\" href=\"/\"><div class=\"mr-2 shrink-0 rounded-lg bg-emerald-500 p-1.5 shadow-inner shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13 10V3L4 14h7v7l9-11h-7Z\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering <span class=\"text-emerald-600\">Tools</span></span></a><div class=\"hidden items-center gap-4 xl:flex 2xl:gap-6\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">LCA</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/electrical\">Electrical</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-sky-600\">Solar ↗</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">LCA Workspace</a></div><div class=\"shrink-0 xl:hidden\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><main class=\"bg-slate-50\"><section class=\"border-b border-slate-200 bg-white\"><div class=\"mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16\"><a class=\"text-xs font-black text-emerald-700 hover:underline\" href=\"/electrical\">← Electrical tools</a><h1 class=\"mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl\">kVA to Amps Calculator</h1><p class=\"mt-5 max-w-3xl text-lg leading-8 text-slate-600\">Convert apparent power in kVA to current for single-phase or balanced three-phase systems. Useful for generator, transformer and UPS nameplate ratings where apparent power is known directly.</p></div></section><section class=\"mx-auto max-w-5xl px-4 py-10 sm:px-6\"><div class=\"jsx-49898b426eb4e74b rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/50 overflow-hidden\"><div class=\"jsx-49898b426eb4e74b bg-slate-950 px-5 py-5 text-white sm:px-7\"><p class=\"jsx-49898b426eb4e74b text-xs font-black uppercase tracking-widest text-emerald-300\">Quick electrical conversion</p><h2 class=\"jsx-49898b426eb4e74b mt-1 text-2xl font-black\">kVA to amps calculator</h2></div><div class=\"jsx-49898b426eb4e74b grid gap-6 p-5 sm:p-7 lg:grid-cols-2\"><div class=\"jsx-49898b426eb4e74b space-y-4\"><label class=\"jsx-49898b426eb4e74b block\"><span class=\"jsx-49898b426eb4e74b mb-1.5 block text-xs font-black text-slate-600\">Circuit type</span><select class=\"jsx-49898b426eb4e74b input\"><option value=\"dc\" class=\"jsx-49898b426eb4e74b\">DC</option><option value=\"single-phase\" class=\"jsx-49898b426eb4e74b\" selected=\"\">Single-phase AC</option><option value=\"three-phase\" class=\"jsx-49898b426eb4e74b\">Three-phase AC</option></select></label><label class=\"jsx-49898b426eb4e74b block\"><span class=\"jsx-49898b426eb4e74b mb-1.5 block text-xs font-black text-slate-600\">Apparent power (kVA)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"jsx-49898b426eb4e74b input\" value=\"10\"/></label><label class=\"jsx-49898b426eb4e74b block\"><span class=\"jsx-49898b426eb4e74b mb-1.5 block text-xs font-black text-slate-600\">Voltage (V)</span><input type=\"number\" min=\"1\" step=\"any\" class=\"jsx-49898b426eb4e74b input\" value=\"230\"/></label><label class=\"jsx-49898b426eb4e74b block\"><span class=\"jsx-49898b426eb4e74b mb-1.5 block text-xs font-black text-slate-600\">Power factor</span><input type=\"number\" min=\"0.01\" max=\"1\" step=\"0.01\" class=\"jsx-49898b426eb4e74b input\" value=\"0.9\"/></label></div><div class=\"jsx-49898b426eb4e74b rounded-2xl bg-slate-950 p-5 text-white sm:p-6\"><p class=\"jsx-49898b426eb4e74b text-xs font-black uppercase tracking-widest text-emerald-300\">Result</p><div class=\"jsx-49898b426eb4e74b mt-4 rounded-xl border border-slate-800 bg-slate-900 p-5\"><p class=\"jsx-49898b426eb4e74b text-xs font-bold text-slate-400\">Current</p><p class=\"jsx-49898b426eb4e74b mt-1 font-mono text-4xl font-black\">43.478<!-- --> A</p></div><div class=\"jsx-49898b426eb4e74b mt-3 grid grid-cols-2 gap-3\"><div class=\"jsx-49898b426eb4e74b rounded-xl border border-slate-800 bg-slate-900 p-4\"><p class=\"jsx-49898b426eb4e74b text-xs text-slate-400\">Active power</p><p class=\"jsx-49898b426eb4e74b mt-1 font-mono font-black\">9<!-- --> kW</p></div><div class=\"jsx-49898b426eb4e74b rounded-xl border border-slate-800 bg-slate-900 p-4\"><p class=\"jsx-49898b426eb4e74b text-xs text-slate-400\">Apparent power</p><p class=\"jsx-49898b426eb4e74b mt-1 font-mono font-black\">10<!-- --> kVA</p></div></div><p class=\"jsx-49898b426eb4e74b mt-4 text-xs leading-5 text-slate-300\">Single-phase calculation across the entered supply voltage.</p></div></div></div></section><section class=\"border-t border-slate-200 bg-white\"><div class=\"mx-auto max-w-4xl space-y-8 px-4 py-14 sm:px-6 text-slate-600\"><section><h2 class=\"text-3xl font-black text-slate-950\">kVA to amps formulas</h2><p class=\"mt-4 leading-7\">For single-phase AC, I = kVA × 1000 ÷ V. For balanced three-phase AC, I = kVA × 1000 ÷ (√3 × V), using line-to-line voltage. Power factor is not needed to calculate current from kVA because apparent power already includes the relationship between volts and amps; the calculator still uses power factor to show corresponding active kW.</p></section><section><h2 class=\"text-2xl font-black text-slate-950\">Generator and transformer sizing caution</h2><p class=\"mt-3 leading-7\">Converting kVA to current does not size a generator, transformer, breaker or cable by itself. Motor starting, harmonics, nonlinear loads, duty cycle, overload capability, ambient conditions and local protection rules can materially change equipment selection.</p></section><div class=\"rounded-2xl border border-emerald-200 bg-emerald-50 p-6\"><h2 class=\"text-xl font-black text-emerald-950\">Continue into feeder design</h2><p class=\"mt-2 text-sm leading-6 text-emerald-900\">Use the three-phase voltage drop tool to evaluate a generator or transformer feeder after converting the kVA rating to current.</p><a class=\"mt-4 inline-flex rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-black text-white\" href=\"/electrical/3-phase-voltage-drop-calculator\">Open 3-Phase Calculator →</a></div></div></section></main><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-5 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center font-black tracking-tight text-white sm:justify-start\" href=\"/\">GreenEngineering Tools</a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Free browser-based engineering tools for carbon, CBAM, electrical systems and sustainable design.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/electrical\">Explore electrical tools →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Core tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer core tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/electrical\">Electrical Tools</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"block hover:text-white\">Solar Calculator ↗</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Electrical</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer electrical navigation\"><a class=\"block hover:text-white\" href=\"/electrical/voltage-drop-calculator\">Voltage Drop Calculator</a><a class=\"block hover:text-white\" href=\"/electrical/wire-size-calculator\">Wire Size Calculator</a><a class=\"block hover:text-white\" href=\"/electrical/dc-wire-size-calculator\">DC Wire Size</a><a class=\"block hover:text-white\" href=\"/electrical/3-phase-voltage-drop-calculator\">3-Phase Voltage Drop</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">LCA learning</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer LCA learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\