te-800 pt-7 md:flex-row\",\"children\":[\"$Lf\",\"$L10\"]}]]}]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-slate-50\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"TechArticle\\\",\\\"headline\\\":\\\"A1-A3 Embodied Carbon Calculator & EPD Guide\\\",\\\"description\\\":\\\"Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.\\\",\\\"dateModified\\\":\\\"2026-08-31\\\",\\\"mainEntityOfPage\\\":\\\"https://greenengineeringtools.com/a1-a3-embodied-carbon\\\",\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Green Engineering Tools\\\",\\\"url\\\":\\\"https://greenengineeringtools.com\\\"},\\\"about\\\":[\\\"Life cycle assessment\\\",\\\"Embodied carbon\\\",\\\"Environmental Product Declarations\\\",\\\"Building materials\\\"]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://greenengineeringtools.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Guides\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/guides\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"A1-A3 Embodied Carbon Calculator & EPD Guide\\\",\\\"item\\\":\\\"https://greenengineeringtools.com/a1-a3-embodied-carbon\\\"}]}\"}}],[\"$\",\"section\",null,{\"className\":\"bg-slate-950 text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"text-sm text-slate-400 mb-7\",\"aria-label\":\"Breadcrumb\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"mx-2\",\"children\":\"/\"}],[\"$\",\"$L2\",null,{\"href\":\"/guides\",\"className\":\"hover:text-white\",\"children\":\"Guides\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\",\"children\":\"A1-A3 product-stage carbon\"}],[\"$\",\"h1\",null,{\"className\":\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\",\"children\":\"A1-A3 Embodied Carbon Calculator & EPD Guide\"}],[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\",\"children\":\"Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/#calculator-workspace\",\"className\":\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\",\"children\":\"Open the LCA calculator\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\",\"children\":\"Read methodology\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-6 text-xs text-slate-500\",\"children\":[\"Last reviewed: \",\"2026-08-31\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\",\"children\":[[\"$\",\"article\",null,{\"className\":\"min-w-0\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"space-y-14\",\"children\":[[\"$\",\"section\",\"definition\",{\"id\":\"definition\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What A1, A2 and A3 mean in an EPD\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A1-A3 are the product-stage modules most commonly encountered when comparing the upfront manufacturing impact of construction materials. A1 covers raw material supply, A2 covers transport associated with supplying those inputs to manufacturing, and A3 covers manufacturing processes. Many EPDs report a combined A1-A3 value rather than three separate numbers.\"}],\"$L11\"],\"$undefined\",\"$undefined\",\"$L12\",\"$undefined\"]}],\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}],\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]}]]}],null,\"$L1c\"]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1d\",null,{\"children\":\"$L1e\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1f\",null,{\"children\":[\"$\",\"$20\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L21\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\ne:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2v8tkpdzq5d58.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n22:I[97367,[\"/_next/static/chunks/2pq2d3eit8abw.js\"],\"OutletBoundary\"]\nb:C\nf:[\"$\",\"p\",null,{\"className\":\"text-center text-xs text-slate-500 md:text-left\",\"children\":[\"© \",2026,\" Green Engineering Tools. All rights reserved.\"]}]\n10:[\"$\",\"p\",null,{\"className\":\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\",\"children\":\"Engineering decision-support tools. Formal compliance, certification and site-specific electrical design remain subject to applicable standards, manufacturer data and qualified professional review.\"}]\n11:[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A1-A3 is therefore a useful starting point for procurement and early embodied-carbon studies, but it is not automatically the whole life of the product. Project delivery, installation, maintenance, replacement, demolition and waste processing may sit in later modules.\"}]\n12:[\"$\",\"div\",null,{\"className\":\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full min-w-[640px] text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-slate-900 text-white\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"Module\",{\"className\":\"p-3 text-left font-black\",\"children\":\"Module\"}],[\"$\",\"th\",\"Plain-language meaning\",{\"className\":\"p-3 text-left font-black\",\"children\":\"Plain-language meaning\"}],[\"$\",\"th\",\"Typical question\",{\"className\":\"p-3 text-left font-black\",\"children\":\"Typical question\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-slate-200\",\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"A1\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Raw material supply\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"What impacts are associated with obtaining the material inputs?\"}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"A2\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Transport to manufacturing\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"What impacts occur moving inputs to the manufacturing facility?\"}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"align-top\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"A3\"}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"Manufacturing\"}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 leading-6 text-slate-700\",\"children\":\"What impacts occur while producing the construction product?\"}]]}]]}]]}]}]\n13:[\"$\",\"section\",\"calculate\",{\"id\":\"calculate\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How to calculate A1-A3 embodied carbon\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The core calculation is project quantity expressed in the EPD declared basis multiplied by the A1-A3 GWP per declared quantity. If an EPD declares 1 tonne and the project contains 50 tonnes of the same product basis, multiply the factor by 50. If the EPD declares 1 m³ and the schedule is in tonnes, first convert using an appropriate density.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Do not convert by intuition. A concrete quantity reported by volume cannot be multiplied directly by a factor reported per kilogram. Likewise, a square-metre EPD may depend on a particular product thickness or assembly definition.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n14:[\"$\",\"section\",\"declared-unit\",{\"id\":\"declared-unit\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Declared unit is as important as the GWP number\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A GWP value without its declared unit is incomplete information. Two EPDs may both show a number called A1-A3 GWP, but one may be per kilogram and another per cubic metre. The magnitude of the number cannot be compared until the basis is aligned.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"The calculation engine therefore stores declared quantity and unit with the environmental result. Straight unit conversions are automated where possible, while mass-volume and area-volume conversions require the relevant physical properties.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n15:[\"$\",\"section\",\"compare\",{\"id\":\"compare\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"How to compare two A1-A3 EPD results fairly\"}],\"$undefined\",[\"$\",\"ul\",null,{\"className\":\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\",\"children\":[[\"$\",\"li\",\"Check that the products perform the same function for the design decision being made.\",{\"children\":\"Check that the products perform the same function for the design decision being made.\"}],[\"$\",\"li\",\"Align declared units before comparing GWP values.\",{\"children\":\"Align declared units before comparing GWP values.\"}],[\"$\",\"li\",\"Review product strength, density, thickness, grade or other specification that affects functional equivalence.\",{\"children\":\"Review product strength, density, thickness, grade or other specification that affects functional equivalence.\"}],[\"$\",\"li\",\"Check EPD geography, validity, PCR and manufacturer when those factors matter to procurement.\",{\"children\":\"Check EPD geography, validity, PCR and manufacturer when those factors matter to procurement.\"}],[\"$\",\"li\",\"Do not assume that a lower A1-A3 number guarantees a lower whole-life result if replacement or end-of-life scenarios differ.\",{\"children\":\"Do not assume that a lower A1-A3 number guarantees a lower whole-life result if replacement or end-of-life scenarios differ.\"}]]}],\"$undefined\",\"$undefined\",\"$undefined\"]}]\n16:[\"$\",\"section\",\"scope\",{\"id\":\"scope\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"What A1-A3 does not include\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"A1-A3 normally stops at the factory gate. Transportation from the manufacturer to the construction site is A4, while installation is A5. Use-stage impacts sit in B modules, end of life in C modules, and potential benefits or loads beyond the system boundary in Module D.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"That distinction matters when people search for an 'A1-A3 carbon calculator' and then use the result as if it were the entire building lifecycle. A1-A3 can be an excellent procurement metric, but whole-building decisions often need a broader boundary.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n17:[\"$\",\"section\",\"tool\",{\"id\":\"tool\",\"className\":\"scroll-mt-24\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\",\"children\":\"Using the A1-A3 calculator with CSV or BIM quantities\"}],[[\"$\",\"p\",\"0\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"Upload a material schedule, resolve each material to a dataset, and review any unit-conversion warnings. The manufacturing view can then aggregate A1-A3 by material and by building model. Baseline and proposed models can also be compared using the same data and boundary.\"}],[\"$\",\"p\",\"1\",{\"className\":\"mt-4 text-[1.02rem] leading-8 text-slate-700\",\"children\":\"For transparent reporting, keep the dataset identity and declared unit attached to every result. This makes it possible to trace a building total back to the material records that created it.\"}]],\"$undefined\",\"$undefined\",\"$undefined\",\"$undefined\"]}]\n18:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-slate-200 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-black text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-3\",\"children\":[[\"$\",\"details\",\"What is the formula for A1-A3 embodied carbon?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What is the formula for A1-A3 embodied carbon?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Convert the project quantity to the EPD's declared basis, divide by the EPD declared quantity when needed, and multiply by the A1-A3 GWP reported for that basis.\"}]]}],[\"$\",\"details\",\"Is A1-A3 the same as upfront carbon?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is A1-A3 the same as upfront carbon?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Not always. Upfront carbon commonly includes more than product-stage manufacturing; depending on the framework it may also include transport to site and construction-stage impacts such as A4 and A5.\"}]]}],[\"$\",\"details\",\"Can I compare A1-A3 values from two EPDs directly?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Can I compare A1-A3 values from two EPDs directly?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Only after checking functional equivalence, declared units and relevant product specifications. A smaller printed number does not necessarily mean a lower-impact equivalent product.\"}]]}],[\"$\",\"details\",\"What if an EPD shows A1, A2 and A3 separately?\",{\"className\":\"group rounded-xl border border-slate-200 bg-white\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What if an EPD shows A1, A2 and A3 separately?\"}],[\"$\",\"span\",null,{\"className\":\"text-emerald-600 group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-slate-700 leading-7\",\"children\":\"Use the declared module results according to your methodology. If your report requires a combined A1-A3 value, sum compatible results from A1, A2 and A3 without changing their units or indicator definitions.\"}]]}]]}]]}]\n19:[\"$\",\"section\",null,{\"className\":\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-black text-slate-950\",\"children\":\"Authoritative reference