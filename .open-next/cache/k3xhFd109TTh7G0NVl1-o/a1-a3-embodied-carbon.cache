{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/a1-a3-embodied-carbon/layout,_N_T_/a1-a3-embodied-carbon/page,_N_T_/a1-a3-embodied-carbon"},"segmentPaths":["/_tree","/_full","/_index","/a1-a3-embodied-carbon/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2v8tkpdzq5d58.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/1my_3qt7cqmy3.js\" async=\"\"></script><script src=\"/_next/static/chunks/17780b3h29lu-.js\" async=\"\"></script><script src=\"/_next/static/chunks/31-h9b0ngcdl_.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3t98u8doi58w_.js\" async=\"\"></script><script src=\"/_next/static/chunks/2pq2d3eit8abw.js\" async=\"\" crossorigin=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>A1-A3 Embodied Carbon Calculator &amp; EPD Guide | Green Engineering Tools</title><meta name=\"description\" content=\"Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.\"/><link rel=\"author\" href=\"https://greenengineeringtools.com\"/><meta name=\"author\" content=\"Engr. Arsalan Khan\"/><meta name=\"creator\" content=\"Green Engineering Tools\"/><meta name=\"publisher\" content=\"Green Engineering Tools\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://greenengineeringtools.com/a1-a3-embodied-carbon\"/><meta property=\"og:title\" content=\"A1-A3 Embodied Carbon Calculator &amp; EPD Guide\"/><meta property=\"og:description\" content=\"Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.\"/><meta property=\"og:url\" content=\"https://greenengineeringtools.com/a1-a3-embodied-carbon\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Green Engineering Tools\"/><meta name=\"twitter:description\" content=\"Free engineering calculators for embodied carbon, CBAM and electrical design.\"/><link rel=\"icon\" href=\"/icon.svg?icon.1vgxlfe3lamf-.svg\" sizes=\"any\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5972bc34-module__OU16Qa__className flex min-h-screen w-full min-w-0 flex-col overflow-x-hidden bg-slate-50 text-slate-900\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm\"><nav aria-label=\"Main navigation\"><div class=\"mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8\"><div class=\"flex h-16 min-w-0 items-center justify-between gap-2 sm:h-20 sm:gap-4\"><a aria-label=\"Green Engineering Tools home\" class=\"flex min-w-0 max-w-[calc(100%-3.25rem)] items-center sm:max-w-none\" href=\"/\"><div class=\"mr-2 shrink-0 rounded-lg bg-emerald-500 p-1.5 shadow-inner shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13 10V3L4 14h7v7l9-11h-7Z\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering <span class=\"text-emerald-600\">Tools</span></span></a><div class=\"hidden items-center gap-4 xl:flex 2xl:gap-6\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">LCA</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/electrical\">Electrical</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-sky-600\">Solar ↗</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">LCA Workspace</a></div><div class=\"shrink-0 xl:hidden\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><main class=\"min-h-screen bg-slate-50\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\",\"headline\":\"A1-A3 Embodied Carbon Calculator & EPD Guide\",\"description\":\"Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.\",\"dateModified\":\"2026-08-31\",\"mainEntityOfPage\":\"https://greenengineeringtools.com/a1-a3-embodied-carbon\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Green Engineering Tools\",\"url\":\"https://greenengineeringtools.com\"},\"about\":[\"Life cycle assessment\",\"Embodied carbon\",\"Environmental Product Declarations\",\"Building materials\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenengineeringtools.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://greenengineeringtools.com/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"A1-A3 Embodied Carbon Calculator & EPD Guide\",\"item\":\"https://greenengineeringtools.com/a1-a3-embodied-carbon\"}]}</script><section class=\"bg-slate-950 text-white\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20\"><nav class=\"text-sm text-slate-400 mb-7\" aria-label=\"Breadcrumb\"><a class=\"hover:text-white\" href=\"/\">Home</a><span class=\"mx-2\">/</span><a class=\"hover:text-white\" href=\"/guides\">Guides</a></nav><p class=\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\">A1-A3 product-stage carbon</p><h1 class=\"mt-4 max-w-5xl text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight\">A1-A3 Embodied Carbon Calculator &amp; EPD Guide</h1><p class=\"mt-6 max-w-4xl text-lg sm:text-xl leading-8 text-slate-300\">Calculate A1-A3 embodied carbon from EPD data correctly. Learn declared units, product-stage modules, quantity conversion and fair material comparison.</p><div class=\"mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-400\" href=\"/#calculator-workspace\">Open the LCA calculator</a><a class=\"inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-bold text-slate-200 hover:bg-slate-800\" href=\"/methodology\">Read methodology</a></div><p class=\"mt-6 text-xs text-slate-500\">Last reviewed: <!-- -->2026-08-31</p></div></section><div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-10\"><article class=\"min-w-0\"><div class=\"space-y-14\"><section id=\"definition\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">What A1, A2 and A3 mean in an EPD</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A1-A3 are the product-stage modules most commonly encountered when comparing the upfront manufacturing impact of construction materials. A1 covers raw material supply, A2 covers transport associated with supplying those inputs to manufacturing, and A3 covers manufacturing processes. Many EPDs report a combined A1-A3 value rather than three separate numbers.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A1-A3 is therefore a useful starting point for procurement and early embodied-carbon studies, but it is not automatically the whole life of the product. Project delivery, installation, maintenance, replacement, demolition and waste processing may sit in later modules.</p><div class=\"mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white\"><table class=\"w-full min-w-[640px] text-sm\"><thead class=\"bg-slate-900 text-white\"><tr><th class=\"p-3 text-left font-black\">Module</th><th class=\"p-3 text-left font-black\">Plain-language meaning</th><th class=\"p-3 text-left font-black\">Typical question</th></tr></thead><tbody class=\"divide-y divide-slate-200\"><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">A1</td><td class=\"p-3 leading-6 text-slate-700\">Raw material supply</td><td class=\"p-3 leading-6 text-slate-700\">What impacts are associated with obtaining the material inputs?</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">A2</td><td class=\"p-3 leading-6 text-slate-700\">Transport to manufacturing</td><td class=\"p-3 leading-6 text-slate-700\">What impacts occur moving inputs to the manufacturing facility?</td></tr><tr class=\"align-top\"><td class=\"p-3 leading-6 text-slate-700\">A3</td><td class=\"p-3 leading-6 text-slate-700\">Manufacturing</td><td class=\"p-3 leading-6 text-slate-700\">What impacts occur while producing the construction product?</td></tr></tbody></table></div></section><section id=\"calculate\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How to calculate A1-A3 embodied carbon</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The core calculation is project quantity expressed in the EPD declared basis multiplied by the A1-A3 GWP per declared quantity. If an EPD declares 1 tonne and the project contains 50 tonnes of the same product basis, multiply the factor by 50. If the EPD declares 1 m³ and the schedule is in tonnes, first convert using an appropriate density.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Do not convert by intuition. A concrete quantity reported by volume cannot be multiplied directly by a factor reported per kilogram. Likewise, a square-metre EPD may depend on a particular product thickness or assembly definition.</p></section><section id=\"declared-unit\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Declared unit is as important as the GWP number</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A GWP value without its declared unit is incomplete information. Two EPDs may both show a number called A1-A3 GWP, but one may be per kilogram and another per cubic metre. The magnitude of the number cannot be compared until the basis is aligned.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">The calculation engine therefore stores declared quantity and unit with the environmental result. Straight unit conversions are automated where possible, while mass-volume and area-volume conversions require the relevant physical properties.</p></section><section id=\"compare\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">How to compare two A1-A3 EPD results fairly</h2><ul class=\"mt-5 space-y-3 list-disc pl-6 text-slate-700 leading-7\"><li>Check that the products perform the same function for the design decision being made.</li><li>Align declared units before comparing GWP values.</li><li>Review product strength, density, thickness, grade or other specification that affects functional equivalence.</li><li>Check EPD geography, validity, PCR and manufacturer when those factors matter to procurement.</li><li>Do not assume that a lower A1-A3 number guarantees a lower whole-life result if replacement or end-of-life scenarios differ.</li></ul></section><section id=\"scope\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">What A1-A3 does not include</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">A1-A3 normally stops at the factory gate. Transportation from the manufacturer to the construction site is A4, while installation is A5. Use-stage impacts sit in B modules, end of life in C modules, and potential benefits or loads beyond the system boundary in Module D.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">That distinction matters when people search for an &#x27;A1-A3 carbon calculator&#x27; and then use the result as if it were the entire building lifecycle. A1-A3 can be an excellent procurement metric, but whole-building decisions often need a broader boundary.</p></section><section id=\"tool\" class=\"scroll-mt-24\"><h2 class=\"text-2xl sm:text-3xl font-black tracking-tight text-slate-950\">Using the A1-A3 calculator with CSV or BIM quantities</h2><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">Upload a material schedule, resolve each material to a dataset, and review any unit-conversion warnings. The manufacturing view can then aggregate A1-A3 by material and by building model. Baseline and proposed models can also be compared using the same data and boundary.</p><p class=\"mt-4 text-[1.02rem] leading-8 text-slate-700\">For transparent reporting, keep the dataset identity and declared unit attached to every result. This makes it possible to trace a building total back to the material records that created it.</p></section></div><section class=\"mt-16 border-t border-slate-200 pt-10\"><h2 class=\"text-2xl sm:text-3xl font-black text-slate-950\">Frequently asked questions</h2><div class=\"mt-6 space-y-3\"><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>What is the formula for A1-A3 embodied carbon?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Convert the project quantity to the EPD&#x27;s declared basis, divide by the EPD declared quantity when needed, and multiply by the A1-A3 GWP reported for that basis.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Is A1-A3 the same as upfront carbon?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Not always. Upfront carbon commonly includes more than product-stage manufacturing; depending on the framework it may also include transport to site and construction-stage impacts such as A4 and A5.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>Can I compare A1-A3 values from two EPDs directly?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Only after checking functional equivalence, declared units and relevant product specifications. A smaller printed number does not necessarily mean a lower-impact equivalent product.</div></details><details class=\"group rounded-xl border border-slate-200 bg-white\"><summary class=\"cursor-pointer list-none p-5 font-black text-slate-900 flex gap-4 justify-between\"><span>What if an EPD shows A1, A2 and A3 separately?</span><span class=\"text-emerald-600 group-open:rotate-45 transition-transform\">+</span></summary><div class=\"px-5 pb-5 text-slate-700 leading-7\">Use the declared module results according to your methodology. If your report requires a combined A1-A3 value, sum compatible results from A1, A2 and A3 without changing their units or indicator definitions.</div></details></div></section><section class=\"mt-14 rounded-2xl border border-slate-200 bg-white p-6\"><h2 class=\"text-xl font-black text-slate-950\">Authoritative references</h2><p class=\"mt-2 text-sm leading-6 text-slate-600\">These links are provided for readers who want to verify standards, product data terminology, or certification requirements at the source.</p><ul class=\"mt-4 space-y-2 text-sm\"><li><a href=\"https://docs.buildingtransparency.org/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">Building Transparency documentation — EC3 and tallyLCA scope</a></li><li><a href=\"https://www.buildingtransparency.org/tools/ec3/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-bold text-blue-700 hover:underline\">Building Transparency — EC3 tool</a></li></ul></section><section class=\"mt-14\"><h2 class=\"text-2xl font-black text-slate-950\">Continue learning</h2><div class=\"mt-5 grid sm:grid-cols-2 gap-4\"><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/embodied-carbon-calculator\"><h3 class=\"font-black text-slate-950\">Embodied carbon calculator guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how to turn a construction material schedule into an auditable carbon result.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/epd-carbon-calculator\"><h3 class=\"font-black text-slate-950\">EPD carbon calculator</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Learn how to read EPD units, GWP values, declared modules and data limitations.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/ec3-epd-guide\"><h3 class=\"font-black text-slate-950\">EC3 EPD guide</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Use EC3 product search and EPD matching without losing the original BIM material name.</p></a><a class=\"rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition\" href=\"/methodology\"><h3 class=\"font-black text-slate-950\">LCA calculation methodology</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">See how quantities, units, lifecycle modules, replacements and missing data are handled.</p></a></div></section></article><aside class=\"hidden lg:block\"><div class=\"sticky top-24 rounded-xl border border-slate-200 bg-white p-5\"><h2 class=\"text-xs font-black uppercase tracking-widest text-slate-500\">On this page</h2><nav class=\"mt-4 space-y-3 text-sm\"><a href=\"#definition\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">What A1, A2 and A3 mean in an EPD</a><a href=\"#calculate\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How to calculate A1-A3 embodied carbon</a><a href=\"#declared-unit\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Declared unit is as important as the GWP number</a><a href=\"#compare\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">How to compare two A1-A3 EPD results fairly</a><a href=\"#scope\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">What A1-A3 does not include</a><a href=\"#tool\" class=\"block font-semibold leading-5 text-slate-700 hover:text-emerald-700\">Using the A1-A3 calculator with CSV or BIM quantities</a><a href=\"#top\" class=\"block pt-3 border-t border-slate-100 font-bold text-slate-400 hover:text-slate-700\">Back to top</a></nav></div></aside></div></main><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-5 lg:gap-8\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center font-black tracking-tight text-white sm:justify-start\" href=\"/\">GreenEngineering Tools</a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Free browser-based engineering tools for carbon, CBAM, electrical systems and sustainable design.</p><a class=\"mt-5 inline-flex text-sm font-black text-emerald-400 hover:text-emerald-300\" href=\"/electrical\">Explore electrical tools →</a></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Core tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer core tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/electrical\">Electrical Tools</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"block hover:text-white\">Solar Calculator ↗</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Electrical</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer electrical navigation\"><a class=\"block hover:text-white\" href=\"/electrical/voltage-drop-calculator\">Voltage Drop Calculator</a><a class=\"block hover:text-white\" href=\"/electrical/wire-size-calculator\">Wire Size Calculator</a><a class=\"block hover:text-white\" href=\"/electrical/dc-wire-size-calculator\">DC Wire Size</a><a class=\"block hover:text-white\" href=\"/electrical/3-phase-voltage-drop-calculator\">3-Phase Voltage Drop</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">LCA learning</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer LCA learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Company</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer company navigation\"><a class=\"block hover:text-white\" href=\"/about\">About Us</a><a class=\"block hover:text-white\" href=\"/contact\">Contact</a><a class=\"block hover:text-white\" href=\"/privacy-po