 shadow-emerald-700/50 sm:mr-3 sm:p-2\"><svg class=\"h-6 w-6 text-white sm:h-7 sm:w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13 10V3L4 14h7v7l9-11h-7Z\"></path></svg></div><span class=\"min-w-0 truncate text-[15px] font-black tracking-tight text-slate-900 min-[360px]:text-base sm:text-2xl\">GreenEngineering <span class=\"text-emerald-600\">Tools</span></span></a><div class=\"hidden items-center gap-3 xl:flex 2xl:gap-5\"><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/\">LCA</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/cbam-calculator\">CBAM</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-orange-600\" href=\"/building-envelope\">Building</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-blue-700\" href=\"/electrical\">Electrical</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-sky-600\">Solar ↗</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/guides\">Guides</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/methodology\">Methodology</a><a class=\"whitespace-nowrap text-sm font-bold text-slate-600 transition-colors hover:text-emerald-600\" href=\"/about\">About</a><a class=\"whitespace-nowrap rounded-md bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800\" href=\"/#calculator-workspace\">LCA Workspace</a></div><div class=\"shrink-0 xl:hidden\"><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-navigation-panel\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 transition-colors hover:bg-slate-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2\"><svg class=\"h-7 w-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav></header><main class=\"w-full min-w-0 flex-1 overflow-x-clip\"><div class=\"min-w-0 bg-gradient-to-b from-emerald-50 via-white to-slate-50\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Wall Insulation Calculator\",\"url\":\"https://greenengineeringtools.com/building-envelope/wall-insulation-calculator\",\"applicationCategory\":\"DesignApplication\",\"operatingSystem\":\"Any modern web browser\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Green Engineering Tools\",\"url\":\"https://greenengineeringtools.com\"},\"description\":\"Estimate insulation thickness and material quantity for a wall, then switch to the assembly tool to see how masonry, sheathing, framing and finishes affect the overall U-value.\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Green Engineering Tools\",\"item\":\"https://greenengineeringtools.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Building Envelope\",\"item\":\"https://greenengineeringtools.com/building-envelope\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Wall Insulation Calculator\",\"item\":\"https://greenengineeringtools.com/building-envelope/wall-insulation-calculator\"}]}</script><div class=\"mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8\"><nav aria-label=\"Breadcrumb\" class=\"mb-6 flex flex-wrap items-center gap-2 text-xs font-bold text-slate-500\"><a class=\"hover:text-emerald-700\" href=\"/\">Home</a><span>/</span><a class=\"hover:text-emerald-700\" href=\"/building-envelope\">Building Envelope</a><span>/</span><span class=\"text-slate-700\">Wall Insulation Calculator</span></nav><header class=\"mx-auto max-w-4xl text-center\"><p class=\"text-xs font-black uppercase tracking-[0.22em] text-emerald-700\">Wall Retrofit &amp; Assembly Planning</p><h1 class=\"mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-5xl\">Wall Insulation Calculator</h1><p class=\"mx-auto mt-5 max-w-3xl text-base leading-7 text-slate-600 sm:text-lg\">Estimate insulation thickness and material quantity for a wall, then switch to the assembly tool to see how masonry, sheathing, framing and finishes affect the overall U-value.</p><div class=\"mt-5 flex flex-wrap justify-center gap-2 text-xs font-bold text-slate-600\"><span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\">No signup</span><span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\">Metric + Imperial</span><span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\">Transparent formulas</span><span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\">Versioned engine</span></div></header><div class=\"mt-10\"><section id=\"building-envelope-calculator\" class=\"min-w-0 scroll-mt-24\"><div class=\"overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/50\"><div class=\"border-b border-slate-200 bg-slate-950 px-4 py-5 text-white sm:px-6 lg:px-8\"><div class=\"flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between\"><div class=\"min-w-0\"><div class=\"text-xs font-black uppercase tracking-[0.18em] text-emerald-300\">Building Envelope Engine v<!-- -->1.0.0</div><h2 class=\"mt-1 text-xl font-black sm:text-2xl\">Thermal performance, insulation, heat loss &amp; carbon payback</h2><p class=\"mt-2 max-w-3xl text-sm leading-6 text-slate-300\">SI and Imperial support. No login. Product values remain editable so local declarations and codes can override planning presets.</p></div><div class=\"flex flex-wrap gap-2\"><button type=\"button\" aria-pressed=\"true\" class=\"min-h-10 rounded-xl px-4 text-sm font-black bg-emerald-500 text-white\">Metric</button><button type=\"button\" aria-pressed=\"false\" class=\"min-h-10 rounded-xl px-4 text-sm font-black bg-white/10 text-slate-200 hover:bg-white/15\">Imperial</button><button type=\"button\" class=\"min-h-10 rounded-xl bg-white/10 px-4 text-sm font-black text-white hover:bg-white/15\">Share</button><button type=\"button\" class=\"min-h-10 rounded-xl bg-white/10 px-4 text-sm font-black text-white hover:bg-white/15\">Print / PDF</button></div></div></div><div class=\"border-b border-slate-200 bg-slate-50 p-2 sm:p-3\"><div class=\"grid grid-cols-2 gap-2 lg:grid-cols-4\" role=\"tablist\" aria-label=\"Building envelope calculation modes\"><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"min-h-12 rounded-xl px-3 py-2 text-sm font-black transition bg-white text-slate-600 hover:bg-slate-100\"><span class=\"hidden sm:inline\">Assembly / U-value</span><span class=\"sm:hidden\">U-value</span></button><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"min-h-12 rounded-xl px-3 py-2 text-sm font-black transition bg-slate-950 text-white shadow\"><span class=\"hidden sm:inline\">Insulation quantity</span><span class=\"sm:hidden\">Insulation</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"min-h-12 rounded-xl px-3 py-2 text-sm font-black transition bg-white text-slate-600 hover:bg-slate-100\"><span class=\"hidden sm:inline\">Heat loss</span><span class=\"sm:hidden\">Heat loss</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"min-h-12 rounded-xl px-3 py-2 text-sm font-black transition bg-white text-slate-600 hover:bg-slate-100\"><span class=\"hidden sm:inline\">Cost &amp; carbon payback</span><span class=\"sm:hidden\">Payback</span></button></div></div><div class=\"grid min-w-0 grid-cols-1 xl:grid-cols-[minmax(0,1.1fr)_minmax(340px,.9fr)]\"><div class=\"min-w-0 border-b border-slate-200 p-4 sm:p-6 lg:p-8 xl:border-b-0 xl:border-r\"><div class=\"space-y-6\"><div><h3 class=\"text-xl font-black text-slate-950\">Insulation quantity &amp; thickness</h3><p class=\"mt-1 text-sm leading-6 text-slate-600\">Estimate added resistance, thickness, volume and optional package quantity. Product coverage charts should control the final purchase quantity.</p></div><div class=\"grid gap-4 sm:grid-cols-2\"><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Net insulation area (m²)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"100\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Insulation material</span><select class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \"><option value=\"fiberglass-batt\">Fiberglass / glass wool batt</option><option value=\"loose-fiberglass\">Loose-fill fiberglass</option><option value=\"cellulose\">Cellulose insulation</option><option value=\"mineral-wool\" selected=\"\">Mineral / stone wool</option><option value=\"eps\">EPS insulation</option><option value=\"xps\">XPS insulation</option><option value=\"pir\">PIR rigid insulation</option><option value=\"closed-cell-pur\">Closed-cell polyurethane foam</option><option value=\"open-cell-foam\">Open-cell spray foam</option><option value=\"wood-fibre\">Wood-fibre insulation</option></select><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">The preset is editable and not a substitute for the selected product&#x27;s declaration.</span></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Existing RSI (m²·K/W)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"1.5\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Target RSI (m²·K/W)</span><input type=\"number\" min=\"0.01\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"5\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Thermal conductivity λ (W/m·K)</span><input type=\"number\" min=\"0.001\" step=\"0.001\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"0.037\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Installed density (kg/m³)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"45\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Optional. Density is needed for a mass estimate.</span></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Installation / ordering allowance (%)</span><input type=\"number\" min=\"0\" max=\"100\" step=\"0.5\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"5\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Use a product/project-specific allowance. Loose-fill settling should follow the manufacturer chart.</span></label><div class=\"hidden sm:block\"></div></div><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Optional product packaging &amp; cost</summary><div class=\"mt-4 grid gap-4 sm:grid-cols-2\"><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Package mass (kg)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Use for products sold by mass. Leave blank if not applicable.</span></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Package coverage (m²)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"\"/><span class=\"mt-1.5 block text-xs leading-5 text-slate-500\">Prefer the manufacturer coverage for the required installed R/depth.</span></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Price per package (USD)</span><input type=\"number\" min=\"0\" step=\"any\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"\"/></label><label class=\"block min-w-0\"><span class=\"mb-1.5 block text-sm font-extrabold text-slate-800\">Currency label</span><input maxLength=\"8\" class=\"min-h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 \" value=\"USD\"/></label></div></details><button type=\"button\" class=\"min-h-11 rounded-xl bg-slate-950 px-4 text-sm font-black text-white disabled:opacity-40\">Use estimated mass in carbon payback</button></div><div class=\"mt-7 flex flex-wrap gap-2 border-t border-slate-200 pt-5\"><button type=\"button\" class=\"min-h-11 rounded-xl bg-emerald-600 px-5 text-sm font-black text-white hover:bg-emerald-500 xl:hidden\">View calculation results ↓</button><button type=\"button\" class=\"min-h-11 rounded-xl border border-slate-300 bg-white px-4 text-sm font-black text-slate-600 hover:bg-slate-50\">Reset saved inputs</button></div></div><aside class=\"min-w-0 scroll-mt-24 bg-slate-50 p-4 sm:p-6 lg:p-8\" aria-live=\"polite\"><div class=\"sticky top-24 space-y-4\"><div><div class=\"text-xs font-black uppercase tracking-[0.18em] text-emerald-700\">Live result</div><h3 class=\"mt-1 text-xl font-black text-slate-950\">Insulation quantity</h3></div><div class=\"grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2\"><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Added resistance</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">3.5 RSI</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Required thickness</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">130 mm</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Base material volume</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">12.95 m³</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Order volume incl. allowance</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">13.6 m³</div><p class=\"mt-1.5 text-xs leading-5 text-slate-500\">Allowance increases purchase quantity, not the required installed thickness.</p></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Estimated mass</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">612 kg</div></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Packages</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">Product data needed</div><p class=\"mt-1.5 text-xs leading-5 text-slate-500\">Enter package coverage or package mass.</p></div><div class=\"min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\"><div class=\"text-xs font-black uppercase tracking-[0.12em] text-slate-500\">Package cost</div><div class=\"mt-2 break-words text-2xl font-black tracking-tight text-slate-950\">—</div></div></div><div class=\"rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950\"><p class=\"font-black\">Planning notes</p><ul class=\"mt-2 list-disc space-y-1.5 pl-5 leading-6\"><li>Package count is unavailable until product-specific package coverage or package mass data is entered.</li><li>Use the selected product&#x27;s declared thermal conductivity/R-value and coverage chart for purchase quantities; generic material presets are planning values only.</li></ul></div><div class=\"rounded-2xl border border-slate-200 bg-white p-4 text-xs leading-5 text-slate-500\"><div class=\"font-black text-slate-800\">Calculation provenance</div><div class=\"mt-2 grid grid-cols-1 gap-1\"><span>Engine: v<!-- -->1.0.0</span><span>Material dataset: <!-- -->2026.09.1</span><span>Guidance dataset: <!-- -->2026.09.1</span><span>Data activation: validated, version-controlled</span></div></div></div></aside></div></div></section></div><article class=\"mx-auto mt-12 max-w-4xl space-y-10 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10\"><div class=\"rounded-2xl border border-emerald-200 bg-emerald-50 p-5\"><h2 class=\"text-lg font-black text-emerald-950\">Engineering scope and trust</h2><p class=\"mt-2 text-sm leading-6 text-emerald-900\">The calculator is designed for transparent planning and comparison. It does not claim universal building-code certification. Product declarations, local regulations, moisture/condensation design, thermal bridges, ground-contact heat transfer and specialist HVAC sizing may require additional methods or professional review.</p><div class=\"mt-3 flex flex-wrap gap-3 text-sm font-black\"><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/building-envelope/methodology\">Read methodology</a><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/methodology\">Site methodology</a><a class=\"text-emerald-800 underline underline-offset-4\" href=\"/about\">About Green Engineering Tools</a></div></div><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Cavity insulation is not the same as whole-wall performance</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>A high R-value in the insulated cavity does not automatically mean the whole wall achieves the same resistance. Framing, concrete, masonry ties, fixings and junctions can bypass insulation. Use the Assembly mode when you need an overall layer-by-layer U-value rather than only an insulation thickness.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Subtract openings from the insulation area</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>For material quantity, use the net wall area that will actually receive insulation. Large windows and doors should normally be excluded from insulation quantity, while their own U-values should be included separately in a building heat-loss calculation.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Choose the project target locally</h2><div class=\"prose prose-slate mt-4 max-w-none text-slate-700\"><p>Wall U-value and R-value targets vary by jurisdiction, climate, building type and whether the work is new construction or retrofit. The calculator keeps the target editable instead of hard-coding a worldwide pass/fail value.</p></div></section><section><h2 class=\"text-2xl font-black tracking-tight text-slate-950\">Frequently asked questions</h2><div class=\"mt-5 space-y-3\"><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">How much wall insulation do I need?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Enter net wall area, existing wall resistance, target resistance and the insulation product&#x27;s thermal conductivity. The calculator estimates the added thickness, volume and optional package count.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">How do studs affect wall R-value?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Studs create a parallel heat-flow path through the insulated layer. The Assembly mode includes a simple repeating-framing approximation so you can see how framing fraction changes effective U-value.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Should I include windows in wall insulation area?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Usually not for insulation quantity. Treat windows and doors as separate elements in the Heat Loss tool using their whole-unit U-values.</p></details><details class=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\"><summary class=\"cursor-pointer font-black text-slate-900\">Can I use mineral wool, PIR or EPS?</summary><p class=\"mt-3 text-sm leading-6 text-slate-700\">Yes. The tool includes editable planning presets for common materials. Replace the preset conductivity with the selected product&#x27;s declared/design value for a real project.</p></details></div></section><div class=\"rounded-2xl bg-slate-950 p-5 text-slate-200\"><div class=\"text-sm font-black text-white\">Related Green Engineering Tools</div><div class=\"mt-3 grid gap-2 sm:grid-cols-2\"><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator →</a><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator →</a><a class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\" href=\"/electrical\">Electrical Engineering Tools →</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\">Solar System Calculator ↗</a></div></div></article></div></div><!--$--><!--/$--></main><footer class=\"mt-auto w-full border-t border-slate-800 bg-slate-950 text-slate-400\"><div class=\"mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8\"><div class=\"grid grid-cols-1 gap-8 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-6 lg:gap-7\"><div class=\"sm:col-span-2 lg:col-span-1\"><a class=\"inline-flex items-center justify-center font-black tracking-tight text-white sm:justify-start\" href=\"/\">GreenEngineering Tools</a><p class=\"mx-auto mt-4 max-w-xs text-sm leading-6 text-slate-400 sm:mx-0\">Free browser-based engineering tools for carbon, building physics, electrical systems and sustainable design.</p></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Core tools</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer core tools navigation\"><a class=\"block hover:text-white\" href=\"/\">LCA Engine</a><a class=\"block hover:text-white\" href=\"/cbam-calculator\">CBAM Estimator</a><a class=\"block hover:text-white\" href=\"/building-envelope\">Building Envelope</a><a class=\"block hover:text-white\" href=\"/electrical\">Electrical Tools</a><a href=\"https://solarcalculator.greenengineeringtools.com\" class=\"block hover:text-white\">Solar Calculator ↗</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Building</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer building-envelope navigation\"><a class=\"block hover:text-white\" href=\"/building-envelope/insulation-calculator\">Insulation Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/u-value-calculator\">U-Value Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/heat-loss-calculator\">Heat Loss Calculator</a><a class=\"block hover:text-white\" href=\"/building-envelope/carbon-payback-calculator\">Carbon Payback</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Electrical</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer electrical navigation\"><a class=\"block hover:text-white\" href=\"/electrical/voltage-drop-calculator\">Voltage Drop</a><a class=\"block hover:text-white\" href=\"/electrical/wire-size-calculator\">Wire Size</a><a class=\"block hover:text-white\" href=\"/electrical/dc-wire-size-calculator\">DC Wire Size</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">LCA learning</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer LCA learning navigation\"><a class=\"block hover:text-white\" href=\"/embodied-carbon-calculator\">Embodied Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/a1-a3-embodied-carbon\">A1-A3 Embodied Carbon</a><a class=\"block hover:text-white\" href=\"/epd-carbon-calculator\">EPD Carbon Calculator</a><a class=\"block hover:text-white\" href=\"/ec3-epd-guide\">EC3 EPD Guide</a></nav></div><div><h2 class=\"text-xs font-black uppercase tracking-widest text-white\">Company</h2><nav class=\"mt-4 space-y-3 text-sm\" aria-label=\"Footer company navigation\"><a class=\"block hover:text-white\" href=\"/about\">About Us</a><a class=\"block hover:text-white\" href=\"/contact\">Contact</a><a class=\"block hover:text-white\" href=\"/privacy-policy\">Privacy Policy</a><a class=\"block hover:text-white\" href=\"/terms-of-service\">Terms of Service</a></nav></div></div><div class=\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\"><p class=\"text-center text-xs text-slate-500 md:text-left\">© <!-- -->2026<!-- --> Green Engineering Tools. All rights reserved.</p><p class=\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\">Engineering decision-support tools. Formal compliance, certification and site-specific design remain subject to applicable standards, manufacturer data and qualified professional review.</p></div></div></foo