ial\":\"$@10\",\"staleTime\":\"$e\",\"varyParams\":null},{\"rsc\":\"$L11\",\"isPartial\":\"$@12\",\"staleTime\":\"$e\",\"varyParams\":\"$13\"},{\"rsc\":\"$L14\",\"isPartial\":\"$@15\",\"staleTime\":\"$e\",\"varyParams\":\"$13\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@16\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@17\"}\n18:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"OutletBoundary\"]\n19:\"$Sreact.suspense\"\n1b:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"ViewportBoundary\"]\n1c:I[97367,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"MetadataBoundary\"]\n1d:I[27201,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"IconMark\"]\n1e:I[39756,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"default\"]\n1f:I[37457,[\"/_next/static/chunks/0npzoamixx6t7.js\"],\"default\"]\n4:[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-6 text-emerald-900\",\"children\":\"The calculator is designed for transparent planning and comparison. It does not claim universal building-code certification. Product declarations, local regulations, moisture/condensation design, thermal bridges, ground-contact heat transfer and specialist HVAC sizing may require additional methods or professional review.\"}]\n5:[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap gap-3 text-sm font-black\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/building-envelope/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Read methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"Site methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/about\",\"className\":\"text-emerald-800 underline underline-offset-4\",\"children\":\"About Green Engineering Tools\"}]]}]\n6:[\"$\",\"section\",\"Cavity insulation is not the same as whole-wall performance\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Cavity insulation is not the same as whole-wall performance\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"A high R-value in the insulated cavity does not automatically mean the whole wall achieves the same resistance. Framing, concrete, masonry ties, fixings and junctions can bypass insulation. Use the Assembly mode when you need an overall layer-by-layer U-value rather than only an insulation thickness.\"}]}]]}]\n7:[\"$\",\"section\",\"Subtract openings from the insulation area\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Subtract openings from the insulation area\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"For material quantity, use the net wall area that will actually receive insulation. Large windows and doors should normally be excluded from insulation quantity, while their own U-values should be included separately in a building heat-loss calculation.\"}]}]]}]\n8:[\"$\",\"section\",\"Choose the project target locally\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Choose the project target locally\"}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate mt-4 max-w-none text-slate-700\",\"children\":[\"$\",\"p\",null,{\"children\":\"Wall U-value and R-value targets vary by jurisdiction, climate, building type and whether the work is new construction or retrofit. The calculator keeps the target editable instead of hard-coding a worldwide pass/fail value.\"}]}]]}]\n9:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black tracking-tight text-slate-950\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 space-y-3\",\"children\":[[\"$\",\"details\",\"How much wall insulation do I need?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"How much wall insulation do I need?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Enter net wall area, existing wall resistance, target resistance and the insulation product's thermal conductivity. The calculator estimates the added thickness, volume and optional package count.\"}]]}],[\"$\",\"details\",\"How do studs affect wall R-value?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"How do studs affect wall R-value?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Studs create a parallel heat-flow path through the insulated layer. The Assembly mode includes a simple repeating-framing approximation so you can see how framing fraction changes effective U-value.\"}]]}],[\"$\",\"details\",\"Should I include windows in wall insulation area?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Should I include windows in wall insulation area?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Usually not for insulation quantity. Treat windows and doors as separate elements in the Heat Loss tool using their whole-unit U-values.\"}]]}],[\"$\",\"details\",\"Can I use mineral wool, PIR or EPS?\",{\"className\":\"rounded-2xl border border-slate-200 bg-slate-50 p-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer font-black text-slate-900\",\"children\":\"Can I use mineral wool, PIR or EPS?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-700\",\"children\":\"Yes. The tool includes editable planning presets for common materials. Replace the preset conductivity with the selected product's declared/design value for a real project.\"}]]}]]}]]}]\na:[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-slate-950 p-5 text-slate-200\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm font-black text-white\",\"children\":\"Related Green Engineering Tools\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 grid gap-2 sm:grid-cols-2\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/epd-carbon-calculator\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"EPD Carbon Calculator →\"}],[\"$\",\"$L2\",null,{\"href\":\"/embodied-carbon-calculator\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"Embodied Carbon Calculator →\"}],[\"$\",\"$L2\",null,{\"href\":\"/electrical\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"Electrical Engineering Tools →\"}],[\"$\",\"a\",null,{\"href\":\"https://solarcalculator.greenengineeringtools.com\",\"className\":\"rounded-xl bg-white/10 px-4 py-3 text-sm font-bold hover:bg-white/15\",\"children\":\"Solar System Calculator ↗\"}]]}]]}]\nb:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2qm4q1zl28dg6.js\",\"async\":true}]\nc:[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1a\"}]}]\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1b\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1c\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Wall Insulation Calculator | R-Value, Thickness 