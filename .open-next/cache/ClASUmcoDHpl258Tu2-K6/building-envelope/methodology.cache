",null,{\\\"href\\\":\\\"/building-envelope\\\",\\\"className\\\":\\\"hover:text-emerald-700\\\",\\\"children\\\":\\\"Building Envelope\\\"}],\\\" / Methodology\\\"]}],[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"mt-6 rounded-3xl bg-slate-950 p-6 text-white sm:p-9\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\\\",\\\"children\\\":\\\"Transparent Engineering Method\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"mt-3 text-3xl font-black sm:text-5xl\\\",\\\"children\\\":\\\"Building Envelope Methodology \\u0026 Data Policy\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-5 max-w-3xl text-base leading-7 text-slate-300\\\",\\\"children\\\":\\\"The calculation engine, datasets and guidance are versioned separately so stable physics does not silently change when a source page or product dataset changes.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-6 grid gap-3 text-sm sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-2xl bg-white/10 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-slate-400\\\",\\\"children\\\":\\\"Engine\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-1 font-black\\\",\\\"children\\\":[\\\"v\\\",\\\"1.0.0\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-2xl bg-white/10 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-slate-400\\\",\\\"children\\\":\\\"Material dataset\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-1 font-black\\\",\\\"children\\\":\\\"2026.09.1\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-2xl bg-white/10 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-slate-400\\\",\\\"children\\\":\\\"Guidance dataset\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-1 font-black\\\",\\\"children\\\":\\\"2026.09.1\\\"}]]}]]}]]}],[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"mt-8 space-y-9 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"1. Thermal resistance and U-value\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"For a homogeneous layer, thermal resistance is thickness divided by thermal conductivity. For a simple series assembly, layer resistances and selected surface resistances are added. U-value is the inverse of total SI resistance.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"R_layer = thickness (m) ÷ λ (W/m·K)\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"R_total = R_si + ΣR_layer + R_se\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"U = 1 ÷ R_total\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-sm leading-6 text-slate-600\\\",\\\"children\\\":[\\\"The calculator follows the basic thermal-resistance/transmittance framework described by \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"font-bold text-emerald-700 underline\\\",\\\"href\\\":\\\"https://www.iso.org/standard/65708.html\\\",\\\"children\\\":\\\"ISO 6946:2017\\\"}],\\\". ISO states that this standard excludes doors, windows and other glazed units, curtain walling, ground-contact components and components through which air is designed to permeate.\\\"]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"2. R-US, RSI and U conversion\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"R-US = RSI × 5.678263337\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"RSI = R-US ÷ 5.678263337\\\"}],\\\"$L11\\\",\\\"$L12\\\"]}],\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]}]]}]}],null,\\\"$L1c\\\"]}]\\nc:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1d\\\",null,{\\\"children\\\":\\\"$L1e\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L1f\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$20\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L21\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\ne:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0-cefy6v3zt19.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n22:I[97367,[\\\"/_next/static/chunks/0npzoamixx6t7.js\\\"],\\\"OutletBoundary\\\"]\\nb:C\\nf:[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xs font-black uppercase tracking-widest text-white\\\",\\\"children\\\":\\\"Company\\\"}],[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-4 space-y-3 text-sm\\\",\\\"aria-label\\\":\\\"Footer company navigation\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"About Us\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/contact\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Contact\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/privacy-policy\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Privacy Policy\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/terms-of-service\\\",\\\"className\\\":\\\"block hover:text-white\\\",\\\"children\\\":\\\"Terms of Service\\\"}]]}]]}]\\n10:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-7 md:flex-row\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-center text-xs text-slate-500 md:text-left\\\",\\\"children\\\":[\\\"© \\\",2026,\\\" Green Engineering Tools. All rights reserved.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"max-w-2xl text-center text-xs leading-5 text-slate-500 md:text-right\\\",\\\"children\\\":\\\"Engineering decision-support tools. Formal compliance, certification and site-specific design remain subject to applicable standards, manufacturer data and qualified professional review.\\\"}]]}]\\n11:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"U (W/m²·K) = 1 ÷ RSI\\\"}]\\n12:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"Internally, the engine uses SI values. Imperial inputs are converted to SI before calculation and converted back for display. This avoids running separate formula sets that could drift apart.\\\"}]\\n13:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"3. Repeating framing approximation\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"When enabled, one layer can be split into an insulated path and a framing path. The effective U-value is the area-weighted conductance of the two paths.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"U_effective = (1 − f) / R_insulated_path + f / R_bridge_path\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-sm leading-6 text-amber-800\\\",\\\"children\\\":\\\"This is a simple repeating-path approximation, not a full thermal-bridge calculation. Junction Ψ-values, point bridges, fixings and complex inhomogeneous elements can require a specialist method.\\\"}]]}]\\n14:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"4. Insulation thickness and quantity\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"R_additional = max(0, R_target − R_existing)\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"thickness = R_additional × λ\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"volume = area × thickness\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"mass = volume × installed density\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"Product package counts are only produced when product-specific coverage or package-mass data is entered. Loose-fill coverage and settlement can be manufacturer-specific, so the engine does not invent a universal bags-per-area rule.\\\"}]]}]\\n15:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"5. Design heat loss\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"H_fabric = Σ(U × area)   [W/K]\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Q_fabric = H_fabric × ΔT\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"H_air ≈ 0.333 × V × [ACH_infiltration + ACH_ventilation × (1 − heat-recovery efficiency)]\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Q_total = (H_fabric + H_vent) × ΔT\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"font-bold text-emerald-700 underline\\\",\\\"href\\\":\\\"https://www.iso.org/standard/65713.html\\\",\\\"children\\\":\\\"ISO 13789:2017\\\"}],\\\" provides methods and conventions for steady-state transmission and ventilation heat-transfer coefficients. In V1, uncontrolled infiltration and intentional/mechanical ventilation are entered separately so heat recovery is applied only to the ventilation airflow. The V1 calculator is a transparent planning implementation, not a claim of complete project certification under that standard.\\\"]}]]}]\\n16:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"6. Degree-day annual energy\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Annual delivered energy ≈ H_total × degree-days × 24 ÷ 1000\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Purchased energy ≈ delivered energy ÷ performance factor\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":[\\\"This is a simplified degree-day estimate. It does not model hourly solar gains, internal gains, humidity, controls or dynamic thermal mass. \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"font-bold text-emerald-700 underline\\\",\\\"href\\\":\\\"https://www.iso.org/standard/65696.html\\\",\\\"children\\\":\\\"ISO 52016-1:2017\\\"}],\\\" covers more detailed procedures for heating/cooling energy needs and internal temperatures; this V1 does not claim to be a full ISO 52016 simulation.\\\"]}]]}]\\n17:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"7. Cost and carbon payback\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Annual cost saving = purchased energy saved × local energy price\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Annual CO₂e saving = purchased energy saved × operational carbon factor\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Financial payback = upgrade cost ÷ annual cost saving\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\\\",\\\"children\\\":\\\"Carbon payback = embodied carbon ÷ annual operational CO₂e saving\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"No generic embodied-carbon factor is silently bundled. Use total project carbon from an LCA/EPD calculation, or a compatible product EPD factor with the correct declared unit and life-cycle scope.\\\"}]]}]\\n18:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"8. Regional guidance\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":[\\\"The initial regional dataset includes optional U.S. retrofit guidance from \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"font-bold text-emerald-700 underline\\\",\\\"href\\\":\\\"https://www.energystar.gov/saveathome/seal_insulate/identify-problems-you-want-fix/diy-checks-inspections/insulation-r-values\\\",\\\"children\\\":\\\"ENERGY STAR's Recommended Home Insulation R-Values\\\"}],\\\". It is explicitly labelled as U.S. guidance and is not reused as a worldwide code table.\\\"]}]]}]\\n19:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"9. Data updates: monitored, validated, versioned\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 leading-7 text-slate-700\\\",\\\"children\\\":\\\"Stable equations are not changed automatically. Source pages are monitored by a source-health script; material/guidance changes must pass dataset validation and regression tests before a new version is activated. If monitoring fails, the website continues using the last validated local dataset.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-slate-700\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"font-black text-slate-950\\\",\\\"children\\\":\\\"Safe update sequence\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-2 font-mono\\\",\\\"children\\\":\\\"Source change → review → new version → dataset validation → engine regression tests → build → activation\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"No external source can overwrite production calculation values directly.\\\"}]]}]]}]\\n1a:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-black text-slate-950\\\",\\\"children\\\":\\\"10. Known limits\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-4 list-disc space-y-2 pl-6 leading-7 text-slate-700\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Not a universal building-code compliance certificate.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"No condensation/interstitial moisture or hygrothermal simulation.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"No ground-contact method, glazing model or curtain-wall calculation in V1.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"No full linear/point thermal-bridge or 2D/