 rounded-3xl bg-slate-950 p-6 text-white sm:p-9\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-black uppercase tracking-[0.2em] text-emerald-300\",\"children\":\"Transparent Engineering Method\"}],[\"$\",\"h1\",null,{\"className\":\"mt-3 text-3xl font-black sm:text-5xl\",\"children\":\"Building Envelope Methodology & Data Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-base leading-7 text-slate-300\",\"children\":\"The calculation engine, datasets and guidance are versioned separately so stable physics does not silently change when a source page or product dataset changes.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 grid gap-3 text-sm sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-white/10 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-slate-400\",\"children\":\"Engine\"}],[\"$\",\"div\",null,{\"className\":\"mt-1 font-black\",\"children\":[\"v\",\"1.0.0\"]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-white/10 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-slate-400\",\"children\":\"Material dataset\"}],[\"$\",\"div\",null,{\"className\":\"mt-1 font-black\",\"children\":\"2026.09.1\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl bg-white/10 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-slate-400\",\"children\":\"Guidance dataset\"}],[\"$\",\"div\",null,{\"className\":\"mt-1 font-black\",\"children\":\"2026.09.1\"}]]}]]}]]}],[\"$\",\"article\",null,{\"className\":\"mt-8 space-y-9 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10\",\"children\":[[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-slate-950\",\"children\":\"1. Thermal resistance and U-value\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-7 text-slate-700\",\"children\":\"For a homogeneous layer, thermal resistance is thickness divided by thermal conductivity. For a simple series assembly, layer resistances and selected surface resistances are added. U-value is the inverse of total SI resistance.\"}],[\"$\",\"div\",null,{\"className\":\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\",\"children\":\"R_layer = thickness (m) ÷ λ (W/m·K)\"}],[\"$\",\"div\",null,{\"className\":\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\",\"children\":\"R_total = R_si + ΣR_layer + R_se\"}],[\"$\",\"div\",null,{\"className\":\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\",\"children\":\"U = 1 ÷ R_total\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":[\"The calculator follows the basic thermal-resistance/transmittance framework described by \",[\"$\",\"a\",null,{\"className\":\"font-bold text-emerald-700 underline\",\"href\":\"https://www.iso.org/standard/65708.html\",\"children\":\"ISO 6946:2017\"}],\". ISO states that this standard excludes doors, windows and other glazed units, curtain walling, ground-contact components and components through which air is designed to permeate.\"]}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-slate-950\",\"children\":\"2. R-US, RSI and U conversion\"}],[\"$\",\"div\",null,{\"className\":\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\",\"children\":\"R-US = RSI × 5.678263337\"}],[\"$\",\"div\",null,{\"className\":\"my-3 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-bold text-slate-900\",\"children\":\"RSI = R-US ÷ 5.678263337\"}],\"$L3\",\"$L4\"]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"]}]]}]}],null,\"$Le\"]}],\"isPartial\":\"$@f\",\"staleTime\":\"$10\",\"var