{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/api/cbam",
      "regex": "^/api/cbam(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/cbam(?:/)?$"
    },
    {
      "page": "/api/cron/update-ets",
      "regex": "^/api/cron/update\\-ets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/cron/update\\-ets(?:/)?$"
    },
    {
      "page": "/api/ec3",
      "regex": "^/api/ec3(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ec3(?:/)?$"
    },
    {
      "page": "/api/epd",
      "regex": "^/api/epd(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/epd(?:/)?$"
    },
    {
      "page": "/api/webhook/revit",
      "regex": "^/api/webhook/revit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhook/revit(?:/)?$"
    },
    {
      "page": "/cbam-calculator",
      "regex": "^/cbam\\-calculator(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cbam\\-calculator(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/privacy-policy",
      "regex": "^/privacy\\-policy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy\\-policy(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/supplier-portal/request",
      "regex": "^/supplier\\-portal/request(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/supplier\\-portal/request(?:/)?$"
    },
    {
      "page": "/terms-of-service",
